{{ 'grey-exim-privacy-policy.css' | asset_url | stylesheet_tag }}
{{ 'grey-exim-cookie-policy.css' | asset_url | stylesheet_tag }}
{{ 'grey-exim-payment-policy.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign payment_policy_title = section.settings.title | default: 'Payment Policy'
  assign payment_policy_updated = section.settings.last_updated | default: 'Last updated: 13 August 2026'
  assign payment_policy_toc_label = section.settings.toc_label | default: 'On this page'
-%}

<style>
  #GreyPaymentPolicy-{{ section.id }} .grey-policy__section > h2 > span {
    padding-top: 0 !important;
    color: currentColor !important;
    font-family: inherit !important;
    font-size: 1em !important;
    font-style: inherit !important;
    font-weight: inherit !important;
    line-height: inherit !important;
    letter-spacing: inherit !important;
  }
</style>

<article
  id="GreyPaymentPolicy-{{ section.id }}"
  class="grey-policy grey-cookie-policy grey-payment-policy"
  data-payment-policy
  aria-labelledby="GreyPaymentPolicyTitle-{{ section.id }}"
>
  <header class="grey-policy__hero">
    <div class="grey-policy__hero-inner">
      <h1 id="GreyPaymentPolicyTitle-{{ section.id }}">{{ payment_policy_title | escape }}</h1>
      {%- if payment_policy_updated != blank -%}
        <p class="grey-policy__updated">{{ payment_policy_updated | escape }}</p>
      {%- endif -%}
    </div>
  </header>

  <div class="grey-policy__shell">
    <aside class="grey-policy__aside" data-payment-policy-aside>
      <details class="grey-policy__toc" open>
        <summary>{{ payment_policy_toc_label | escape }}</summary>
        <nav aria-label="{{ payment_policy_title | escape }} sections" data-payment-policy-toc>
          <ol></ol>
        </nav>
      </details>
    </aside>

    <div class="grey-policy__content rte">
      <div class="grey-payment-policy__source" data-payment-policy-source>
        {%- if section.settings.policy_content != blank -%}
          {{ section.settings.policy_content }}
        {%- elsif request.design_mode -%}
          <p class="grey-payment-policy__empty">
            Paste your complete Payment Policy in this section's <strong>Policy content</strong> setting. Format every main section title as Heading 2 to create the numbered navigation automatically.
          </p>
        {%- endif -%}
      </div>

      <section id="payment-contact" class="grey-policy__section grey-policy__section--contact" data-payment-contact>
        <h2><span data-payment-contact-number aria-hidden="true">01</span> Contact Us</h2>
        <p>For questions, complaints or concerns regarding payments, payment failures, duplicate transactions, COD, applicable charges or your order, please contact:</p>
        <div class="grey-policy__contact-card">
          <address>
            <strong>Grey Exim</strong><br>
            Shop 105, Building B, Sicilia<br>
            Mota Varachha, Near Bhakti Nandan Circle<br>
            Surat &ndash; 394101<br>
            Gujarat, India
          </address>
          <p><strong>Email</strong><br><a href="{{ routes.root_url }}pages/contact#send-us-email">care@greyexim.com</a></p>
          <p><strong>Website</strong><br><a href="https://www.greyexim.com">www.greyexim.com</a></p>
        </div>
      </section>
    </div>
  </div>
</article>

<script>
  (() => {
    const rootId = 'GreyPaymentPolicy-{{ section.id }}';

    const slugify = (value) => value
      .toLowerCase()
      .normalize('NFKD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');

    const initialisePaymentPolicy = () => {
      const root = document.getElementById(rootId);
      if (!root || root.dataset.paymentPolicyReady === 'true') return;

      const source = root.querySelector('[data-payment-policy-source]');
      const toc = root.querySelector('[data-payment-policy-toc] ol');
      const aside = root.querySelector('[data-payment-policy-aside]');
      if (!source || !toc || !aside) return;

      let sourceNodes = Array.from(source.childNodes).filter((node) => (
        node.nodeType !== Node.TEXT_NODE || node.textContent.trim() !== ''
      ));
      const oldContactIndex = sourceNodes.findIndex((node) => (
        node.nodeType === Node.ELEMENT_NODE &&
        node.tagName === 'H2' &&
        node.textContent.trim().replace(/^\d+[.)\s:-]*/, '').toLowerCase() === 'contact us'
      ));
      if (oldContactIndex >= 0) sourceNodes = sourceNodes.slice(0, oldContactIndex);

      const fragment = document.createDocumentFragment();
      let currentContainer = document.createElement('div');
      currentContainer.className = 'grey-policy__intro';
      let sectionIndex = 0;
      const usedIds = new Set();

      const appendCurrentContainer = () => {
        if (currentContainer.childNodes.length) fragment.appendChild(currentContainer);
      };

      sourceNodes.forEach((node) => {
        const isSectionHeading = node.nodeType === Node.ELEMENT_NODE && node.tagName === 'H2';

        if (isSectionHeading) {
          appendCurrentContainer();
          sectionIndex += 1;

          const headingText = node.textContent.trim();
          const sectionElement = document.createElement('section');
          let sectionId = `payment-${slugify(headingText) || `section-${sectionIndex}`}`;
          let suffix = 2;
          while (usedIds.has(sectionId)) {
            sectionId = `payment-${slugify(headingText) || `section-${sectionIndex}`}-${suffix}`;
            suffix += 1;
          }
          usedIds.add(sectionId);

          sectionElement.id = sectionId;
          sectionElement.className = 'grey-policy__section';

          const marker = document.createElement('span');
          marker.setAttribute('aria-hidden', 'true');
          marker.textContent = String(sectionIndex).padStart(2, '0');
          node.prepend(marker, document.createTextNode(' '));
          sectionElement.appendChild(node);

          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = `#${sectionId}`;
          link.textContent = headingText;
          item.appendChild(link);
          toc.appendChild(item);

          currentContainer = sectionElement;
          return;
        }

        currentContainer.appendChild(node);
      });

      appendCurrentContainer();
      source.replaceChildren(fragment);

      const contactSection = root.querySelector('[data-payment-contact]');
      const contactNumber = contactSection?.querySelector('[data-payment-contact-number]');
      if (contactSection && contactNumber) {
        sectionIndex += 1;
        contactNumber.textContent = String(sectionIndex).padStart(2, '0');

        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = '#payment-contact';
        link.textContent = 'Contact Us';
        item.appendChild(link);
        toc.appendChild(item);
      }

      source.querySelectorAll('table').forEach((table) => {
        if (table.parentElement?.classList.contains('grey-payment-policy__table-wrap')) return;
        const wrapper = document.createElement('div');
        wrapper.className = 'grey-payment-policy__table-wrap';
        wrapper.setAttribute('role', 'region');
        wrapper.setAttribute('aria-label', 'Payment policy table');
        wrapper.tabIndex = 0;
        table.parentNode.insertBefore(wrapper, table);
        wrapper.appendChild(table);
      });

      aside.hidden = sectionIndex === 0;
      root.dataset.paymentPolicyReady = 'true';
    };

    initialisePaymentPolicy();
    document.addEventListener('shopify:section:load', (event) => {
      if (event.detail?.sectionId === '{{ section.id }}') initialisePaymentPolicy();
    });
  })();
</script>

{% schema %}
{
  "name": "Grey Exim payment policy",
  "tag": "section",
  "class": "section-grey-exim-payment-policy",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Policy title",
      "default": "Payment Policy"
    },
    {
      "type": "text",
      "id": "last_updated",
      "label": "Last updated text",
      "default": "Last updated: 13 August 2026"
    },
    {
      "type": "text",
      "id": "toc_label",
      "label": "Navigation heading",
      "default": "On this page"
    },
    {
      "type": "richtext",
      "id": "policy_content",
      "label": "Policy content",
      "info": "Paste the complete Payment Policy here. Format every main section title as Heading 2; section numbers and On this page links are created automatically."
    }
  ]
}
{% endschema %}
