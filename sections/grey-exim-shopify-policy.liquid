{{ 'grey-exim-privacy-policy.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign policy_source = shop.privacy_policy
  assign policy_heading = section.settings.privacy_policy_title | default: 'Privacy Policy'
  assign policy_label = section.settings.privacy_policy_last_updated | default: 'Last updated: 18 September 2026'
  assign policy_toc_label = section.settings.privacy_policy_toc_label | default: 'On this page'
  assign policy_kind = 'privacy'
-%}

<article id="GreyShopifyPolicy-{{ section.id }}" class="grey-policy grey-policy--editorial" data-policy-kind="{{ policy_kind }}" aria-labelledby="GreyShopifyPolicyTitle-{{ section.id }}">
  <header class="grey-policy__hero">
    <div class="grey-policy__hero-inner">
      <h1 id="GreyShopifyPolicyTitle-{{ section.id }}">{{ policy_heading | escape }}</h1>
      <p class="grey-policy__updated">{{ policy_label | escape }}</p>
    </div>
  </header>

  <div class="grey-policy__shell">
    <aside class="grey-policy__aside" data-shopify-policy-navigation hidden>
      <details class="grey-policy__toc" open>
        <summary>{{ policy_toc_label | escape }}</summary>
        <nav aria-label="{{ policy_heading | escape }} sections">
          <ol data-shopify-policy-navigation-list></ol>
        </nav>
      </details>
    </aside>

    <div class="grey-policy__content rte" data-shopify-policy-content>
      {%- if section.settings.privacy_policy_content != blank -%}
        {{ section.settings.privacy_policy_content }}
      {%- elsif policy_source != blank and policy_source.body != blank -%}
        {{ policy_source.body }}
      {%- else -%}
        <div class="grey-policy__intro">
          <p>Add this policy's content in Shopify Admin under <strong>Settings &rarr; Policies</strong>. Once saved, it will appear here automatically.</p>
        </div>
      {%- endif -%}

      {%- if policy_kind == 'privacy' -%}
        <section id="privacy-contact" class="grey-policy__section grey-policy__section--contact" data-shopify-policy-contact>
          <h2>Contact Us</h2>
          <p>For questions, complaints or concerns regarding this Privacy Policy or your personal data, please contact:</p>
          <div class="grey-policy__contact-card">
            <address>
              <strong>Grey Exim</strong><br>
              Shop 105, Building B, Sicilia<br>
              Mota Varachha, Near Bhakti Nandan Circle<br>
              Surat &ndash; 394101<br>
              Gujarat, India
            </address>
            <p><strong>Email</strong><br><a href="{{ routes.root_url }}pages/contact#send-us-email">care@greyexim.com</a></p>
            <p><strong>Website</strong><br><a href="https://www.greyexim.com">www.greyexim.com</a></p>
          </div>
        </section>
      {%- endif -%}
    </div>
  </div>
</article>

<script>
  (() => {
    const root = document.getElementById('GreyShopifyPolicy-{{ section.id }}');
    if (!root) return;

    document.title = `{{ policy_heading | escape }} – {{ shop.name | escape }}`;
    const content = root.querySelector('[data-shopify-policy-content]');
    const navigation = root.querySelector('[data-shopify-policy-navigation]');
    const list = root.querySelector('[data-shopify-policy-navigation-list]');
    const contactSection = root.querySelector('[data-shopify-policy-contact]');
    const contactHeading = contactSection?.querySelector('h2');

    if (content && contactSection) {
      const duplicateContactHeading = [...content.querySelectorAll('h2')].find((heading) => {
        if (heading === contactHeading) return false;
        return heading.textContent.trim().replace(/^\d+[.)\s:-]*/, '').toLowerCase() === 'contact us';
      });

      if (duplicateContactHeading) {
        let node = duplicateContactHeading;
        while (node && node !== contactSection) {
          const nextNode = node.nextElementSibling;
          node.remove();
          node = nextNode;
        }
      }
    }

    const headings = content ? [...content.querySelectorAll('h2')] : [];
    headings.forEach((heading, index) => {
      const cleanLabel = heading.textContent.trim().replace(/^\d+[.)\s:-]*/, '');
      heading.textContent = cleanLabel;
      const marker = document.createElement('span');
      marker.setAttribute('aria-hidden', 'true');
      marker.dataset.shopifyPolicyNumber = '';
      marker.textContent = String(index + 1).padStart(2, '0');
      heading.prepend(marker, document.createTextNode(' '));
    });

    if (!navigation || !list || headings.length < 2) return;

    const usedIds = new Set();
    headings.forEach((heading, index) => {
      const headingLabel = heading.cloneNode(true);
      headingLabel.querySelector('[data-shopify-policy-number]')?.remove();
      const cleanHeadingLabel = headingLabel.textContent.trim();
      const baseId = cleanHeadingLabel.toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '') || `section-${index + 1}`;
      let id = baseId;
      let suffix = 2;
      while (usedIds.has(id) || document.getElementById(id)) id = `${baseId}-${suffix++}`;
      usedIds.add(id);
      heading.id = id;

      const item = document.createElement('li');
      const link = document.createElement('a');
      link.href = `#${id}`;
      link.textContent = cleanHeadingLabel;
      item.appendChild(link);
      list.appendChild(item);
    });
    navigation.hidden = false;
  })();
</script>

{% schema %}
{
  "name": "Grey Exim privacy policy",
  "tag": "section",
  "class": "section-grey-exim-privacy-policy section-grey-exim-shopify-policy",
  "settings": [
    {
      "type": "paragraph",
      "content": "This editor stores Privacy Policy only. Content entered here is never used by another policy."
    },
    {
      "type": "text",
      "id": "privacy_policy_title",
      "label": "Policy title",
      "default": "Privacy Policy"
    },
    {
      "type": "text",
      "id": "privacy_policy_last_updated",
      "label": "Last updated text",
      "default": "Last updated: 18 September 2026"
    },
    {
      "type": "text",
      "id": "privacy_policy_toc_label",
      "label": "Navigation heading",
      "default": "On this page"
    },
    {
      "type": "richtext",
      "id": "privacy_policy_content",
      "label": "Policy content",
      "info": "Use Heading 2 for each section. The numbered navigation is generated automatically. Leave blank to use the content saved in Shopify Admin under Settings > Policies."
    }
  ]
}
{% endschema %}
