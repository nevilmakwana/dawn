{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

{%- if section.settings.mobile_center_zoom and section.settings.mobile_auto_subject_focus -%}
  <script src="{{ 'image-banner-subject-focus.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign desktop_webm_setting = section.settings.webm_filename | default: section.settings.webm_video_file | strip
  assign desktop_webm_url = ''
  if desktop_webm_setting != blank
    if desktop_webm_setting contains '://'
      assign desktop_webm_url = desktop_webm_setting
    else
      assign desktop_webm_filename = desktop_webm_setting | split: '/' | last
      assign desktop_webm_url = desktop_webm_filename | asset_url
    endif
  endif

  assign mobile_webm_setting = section.settings.mobile_webm_filename | default: section.settings.mobile_webm_video_file | strip
  assign mobile_webm_url = ''
  if mobile_webm_setting != blank
    if mobile_webm_setting contains '://'
      assign mobile_webm_url = mobile_webm_setting
    else
      assign mobile_webm_filename = mobile_webm_setting | split: '/' | last
      assign mobile_webm_url = mobile_webm_filename | asset_url
    endif
  endif

  assign desktop_video_fallback_url = ''
  if section.settings.video != blank
    for video_source in section.settings.video.sources
      if video_source.mime_type == 'video/mp4'
        assign desktop_video_fallback_url = video_source.url
        break
      endif
    endfor
  endif

  assign mobile_video_fallback_url = ''
  if section.settings.mobile_video != blank
    for video_source in section.settings.mobile_video.sources
      if video_source.mime_type == 'video/mp4'
        assign mobile_video_fallback_url = video_source.url
        break
      endif
    endfor
  endif

  assign has_desktop_video = false
  if section.settings.video != blank or desktop_webm_url != blank
    assign has_desktop_video = true
  endif

  assign has_mobile_video = false
  if section.settings.mobile_video != blank or mobile_webm_url != blank
    assign has_mobile_video = true
  endif

  assign has_mobile_media = false
  if has_mobile_video or section.settings.mobile_image != blank
    assign has_mobile_media = true
  endif

  assign has_responsive_webm_video = false
  if desktop_webm_url != blank and mobile_webm_url != blank
    assign has_responsive_webm_video = true
  endif

  assign desktop_banner_aspect_ratio = section.settings.image.aspect_ratio
  if section.settings.video != blank
    assign desktop_banner_aspect_ratio = section.settings.video.aspect_ratio
  endif

  assign mobile_banner_aspect_ratio = desktop_banner_aspect_ratio
  if section.settings.mobile_video != blank
    assign mobile_banner_aspect_ratio = section.settings.mobile_video.aspect_ratio
  elsif section.settings.mobile_image != blank
    assign mobile_banner_aspect_ratio = section.settings.mobile_image.aspect_ratio
  endif

  assign use_full_media_adapt = false
  if section.settings.show_full_media and section.settings.image_2 == blank
    assign use_full_media_adapt = true
  endif

  assign mobile_subject_focus_position = 'center center'
  if section.settings.mobile_auto_subject_focus
    if section.settings.mobile_video != blank and section.settings.mobile_video.preview_image.presentation.focal_point != blank
      assign mobile_subject_focus_position = section.settings.mobile_video.preview_image.presentation.focal_point
    elsif section.settings.mobile_image.presentation.focal_point != blank
      assign mobile_subject_focus_position = section.settings.mobile_image.presentation.focal_point
    elsif section.settings.video != blank and section.settings.video.preview_image.presentation.focal_point != blank
      assign mobile_subject_focus_position = section.settings.video.preview_image.presentation.focal_point
    elsif section.settings.image.presentation.focal_point != blank
      assign mobile_subject_focus_position = section.settings.image.presentation.focal_point
    elsif section.settings.image_2.presentation.focal_point != blank
      assign mobile_subject_focus_position = section.settings.image_2.presentation.focal_point
    endif
  endif

  assign desktop_content_position = section.settings.desktop_content_position | default: 'middle-center'
  assign desktop_content_position_parts = desktop_content_position | split: '-'
  assign desktop_content_vertical = desktop_content_position_parts | first
  assign desktop_content_horizontal = desktop_content_position_parts | last
  assign desktop_content_align_items = 'center'
  assign desktop_content_justify_content = 'center'
  case desktop_content_vertical
    when 'top'
      assign desktop_content_align_items = 'flex-start'
    when 'bottom'
      assign desktop_content_align_items = 'flex-end'
  endcase
  case desktop_content_horizontal
    when 'left'
      assign desktop_content_justify_content = 'flex-start'
    when 'right'
      assign desktop_content_justify_content = 'flex-end'
  endcase

  assign mobile_content_position = section.settings.mobile_content_position | default: desktop_content_position
  assign mobile_content_position_parts = mobile_content_position | split: '-'
  assign mobile_content_vertical = mobile_content_position_parts | first
  assign mobile_content_horizontal = mobile_content_position_parts | last
  assign mobile_content_align_items = 'center'
  assign mobile_content_justify_content = 'center'
  case mobile_content_vertical
    when 'top'
      assign mobile_content_align_items = 'flex-start'
    when 'bottom'
      assign mobile_content_align_items = 'flex-end'
  endcase
  case mobile_content_horizontal
    when 'left'
      assign mobile_content_justify_content = 'flex-start'
    when 'right'
      assign mobile_content_justify_content = 'flex-end'
  endcase

  assign desktop_button_alignment = section.settings.desktop_button_alignment | default: 'inherit'
  if desktop_button_alignment == 'inherit'
    assign desktop_button_alignment = section.settings.desktop_content_alignment | default: 'center'
  endif
  assign desktop_button_justify_content = 'center'
  case desktop_button_alignment
    when 'left'
      assign desktop_button_justify_content = 'flex-start'
    when 'right'
      assign desktop_button_justify_content = 'flex-end'
  endcase

  assign mobile_button_alignment = section.settings.mobile_button_alignment | default: 'inherit'
  if mobile_button_alignment == 'inherit'
    assign mobile_button_alignment = section.settings.mobile_content_alignment | default: 'center'
  endif
  assign mobile_button_justify_content = 'center'
  case mobile_button_alignment
    when 'left'
      assign mobile_button_justify_content = 'flex-start'
    when 'right'
      assign mobile_button_justify_content = 'flex-end'
  endcase
-%}

{%- if mobile_banner_aspect_ratio != blank and section.settings.image_height == 'adapt' or mobile_banner_aspect_ratio != blank and use_full_media_adapt -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before,
      #Banner-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
        padding-bottom: {{ 1 | divided_by: mobile_banner_aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{%- if desktop_banner_aspect_ratio != blank and section.settings.image_height == 'adapt' or desktop_banner_aspect_ratio != blank and use_full_media_adapt -%}
  {%- style -%}
    @media screen and (min-width: 750px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before {
        padding-bottom: {{ 1 | divided_by: desktop_banner_aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{%- style -%}
  #Banner-{{ section.id }}::after {
    opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
  }

  #Banner-{{ section.id }} .banner__media-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #Banner-{{ section.id }} .banner__media--mobile {
    display: none !important;
  }

  #Banner-{{ section.id }} .banner__buttons {
    width: 100%;
    justify-content: {{ desktop_button_justify_content }};
  }

  @media screen and (min-width: 750px) {
    #Banner-{{ section.id }} .banner__media--desktop {
      display: block !important;
    }

    #Banner-{{ section.id }} .banner__media--mobile {
      display: none !important;
    }

    #Banner-{{ section.id }} .banner__content {
      align-items: {{ desktop_content_align_items }};
      justify-content: {{ desktop_content_justify_content }};
    }
  }

  @media screen and (max-width: 749px) {
    #Banner-{{ section.id }} .banner__media--desktop {
      display: none !important;
    }

    #Banner-{{ section.id }} .banner__media--mobile {
      display: block !important;
      width: 100% !important;
      right: auto !important;
      left: 0 !important;
    }

    #Banner-{{ section.id }} .banner__content {
      align-items: {{ mobile_content_align_items }};
      justify-content: {{ mobile_content_justify_content }};
    }

    #Banner-{{ section.id }} .banner__buttons {
      justify-content: {{ mobile_button_justify_content }};
    }
  }

  {%- if section.settings.prada_link_button -%}
    #Banner-{{ section.id }} .banner__buttons {
      margin-top: 2rem;
    }

    #Banner-{{ section.id }} .prada-banner-link-button {
      min-width: 0 !important;
      min-height: 0 !important;
      padding: 0 !important;
      border: 0 !important;
      border-radius: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
      color: rgb(var(--color-foreground)) !important;
      font-size: 1.35rem !important;
      font-weight: 700 !important;
      letter-spacing: 0 !important;
      line-height: 1.2 !important;
      text-transform: uppercase;
    }

    #Banner-{{ section.id }} .prada-banner-link-button::before,
    #Banner-{{ section.id }} .prada-banner-link-button::after {
      display: none !important;
      content: none !important;
    }

    #Banner-{{ section.id }} .prada-banner-link-label {
      position: relative;
      display: inline-block;
      padding-bottom: 0.7rem;
    }

    #Banner-{{ section.id }} .prada-banner-link-label::before,
    #Banner-{{ section.id }} .prada-banner-link-label::after {
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;
      height: 1px;
      content: '';
      background: currentColor;
      transition: transform 260ms cubic-bezier(0.65, 0, 0.35, 1);
    }

    #Banner-{{ section.id }} .prada-banner-link-label::before {
      transform: scaleX(1);
      transform-origin: right center;
    }

    #Banner-{{ section.id }} .prada-banner-link-label::after {
      transform: scaleX(0);
      transform-origin: left center;
    }

    #Banner-{{ section.id }} .prada-banner-link-button:hover .prada-banner-link-label::before,
    #Banner-{{ section.id }} .prada-banner-link-button:focus-visible .prada-banner-link-label::before {
      transform: scaleX(0);
    }

    #Banner-{{ section.id }} .prada-banner-link-button:hover .prada-banner-link-label::after,
    #Banner-{{ section.id }} .prada-banner-link-button:focus-visible .prada-banner-link-label::after {
      transform: scaleX(1);
    }
  {%- endif -%}

  {%- if section.settings.full_screen_height and use_full_media_adapt == false -%}
    #shopify-section-{{ section.id }},
    #Banner-{{ section.id }} {
      min-height: 100vh !important;
      height: 100vh !important;
    }

    @supports (height: 100svh) {
      #shopify-section-{{ section.id }},
      #Banner-{{ section.id }} {
        min-height: 100svh !important;
        height: 100svh !important;
      }
    }

    @supports (height: 100dvh) {
      #shopify-section-{{ section.id }},
      #Banner-{{ section.id }} {
        min-height: 100dvh !important;
        height: 100dvh !important;
      }
    }

    #Banner-{{ section.id }} .banner__media,
    #Banner-{{ section.id }} .banner__content {
      min-height: 100% !important;
      height: 100% !important;
    }

    #Banner-{{ section.id }} .banner__media {
      position: absolute !important;
      inset: 0 !important;
      width: 100% !important;
      height: 100% !important;
    }

    #Banner-{{ section.id }} .banner__media > img,
    #Banner-{{ section.id }} .banner__media > svg,
    #Banner-{{ section.id }} .banner__media > video {
      width: 100% !important;
      height: 100% !important;
      object-fit: {% if section.settings.show_full_media %}contain{% else %}cover{% endif %} !important;
    }
  {%- endif -%}

  {%- if section.settings.full_screen_height and section.settings.mobile_center_zoom != true -%}
    #Banner-{{ section.id }} .banner__content {
      align-items: {{ desktop_content_align_items }} !important;
      justify-content: {{ desktop_content_justify_content }} !important;
      padding: 5rem 5rem 4rem !important;
    }

    #Banner-{{ section.id }} .banner__box {
      width: 100% !important;
      max-width: 72rem !important;
      padding: 0 !important;
      margin: 0 auto !important;
    }

    #Banner-{{ section.id }} .banner__heading {
      font-size: 32px !important;
      line-height: 1.25 !important;
      font-weight: 400 !important;
    }

    #Banner-{{ section.id }} .banner__buttons .button {
      font-size: 14px !important;
      line-height: 18px !important;
    }

    @media screen and (max-width: 749px) {
      #Banner-{{ section.id }} .banner__content {
        align-items: {{ mobile_content_align_items }} !important;
        justify-content: {{ mobile_content_justify_content }} !important;
        padding: 0 2rem max(7rem, env(safe-area-inset-bottom)) !important;
      }

      #Banner-{{ section.id }} .banner__box {
        width: 100% !important;
        max-width: 42rem !important;
        padding: 0 !important;
        margin: 0 auto !important;
      }

      #Banner-{{ section.id }} .banner__heading {
        font-size: 20px !important;
        line-height: 1.25 !important;
      }

      #Banner-{{ section.id }} .banner__buttons .button {
        font-size: 14px !important;
        line-height: 18px !important;
      }
    }
  {%- endif -%}

  {%- if section.settings.mobile_center_zoom -%}
    #Banner-{{ section.id }} .banner__heading {
      font-size: 32px !important;
      line-height: 1.25 !important;
      font-weight: 400 !important;
    }

    #Banner-{{ section.id }} .banner__text,
    #Banner-{{ section.id }} .banner__text p {
      font-size: 14px !important;
      line-height: 18px !important;
      font-weight: 400 !important;
    }

    #Banner-{{ section.id }} .banner__buttons .button {
      font-size: 14px !important;
      line-height: 18px !important;
    }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} {
        min-height: 0 !important;
        height: auto !important;
      }

      #Banner-{{ section.id }} {
        aspect-ratio: 1079 / 2048 !important;
        min-height: 0 !important;
        height: auto !important;
        --mobile-banner-subject-position: {{ mobile_subject_focus_position }};
      }

      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before,
      #Banner-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
        content: none !important;
        padding-bottom: 0 !important;
        display: none !important;
      }

      #Banner-{{ section.id }} .banner__media,
      #Banner-{{ section.id }} .banner__content {
        min-height: 100% !important;
        height: 100% !important;
      }

      #Banner-{{ section.id }} .banner__content {
        position: absolute !important;
        inset: 0 !important;
        padding: 0 2rem !important;
      }

      #Banner-{{ section.id }} .banner__box {
        position: relative !important;
        right: auto !important;
        bottom: auto !important;
        left: auto !important;
        width: 100% !important;
        max-width: 42rem !important;
        margin: 0 !important;
      }

      #Banner-{{ section.id }} .banner__heading {
        font-size: 20px !important;
        line-height: 1.25 !important;
      }

      #Banner-{{ section.id }} .banner__text,
      #Banner-{{ section.id }} .banner__text p {
        font-size: 14px !important;
        line-height: 20px !important;
      }

      #Banner-{{ section.id }} .banner__buttons .button {
        font-size: 14px !important;
        line-height: 18px !important;
      }

      #Banner-{{ section.id }} .banner__media {
        position: absolute !important;
        inset: 0 !important;
        width: 100% !important;
      }

      #Banner-{{ section.id }} .banner__media > img,
      #Banner-{{ section.id }} .banner__media > svg,
      #Banner-{{ section.id }} .banner__media > video {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
        object-position: var(--mobile-banner-subject-position, center center) !important;
        transition: object-position 300ms ease;
      }
    }
  {%- endif -%}
{%- endstyle -%}

{%- liquid
  assign full_width = '100vw'
  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'

  if section.settings.image_behavior == 'ambient'
    assign half_width = '60vw'
    assign full_width = '120vw'
    assign stacked_sizes = '(min-width: 750px) 60vw, 120vw'
    assign widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
  elsif section.settings.image_behavior == 'fixed' or section.settings.image_behavior == 'zoom-in'
    assign half_width = '100vw'
    assign stacked_sizes = '100vw'
  else
    assign half_width = '50vw'
    assign stacked_sizes = '(min-width: 750px) 50vw, 100vw'
  endif
  assign fetch_priority = 'auto'
  assign image_loading = 'lazy'
  assign enable_section_reveal = settings.animations_reveal_on_scroll
  if section.index == 1
    assign fetch_priority = 'high'
    assign image_loading = 'eager'
    assign enable_section_reveal = false
  endif
-%}

<div
  id="Banner-{{ section.id }}"
  class="banner banner--content-align-{{ section.settings.desktop_content_alignment }} banner--content-align-mobile-{{ section.settings.mobile_content_alignment }} banner--{{ section.settings.image_height }}{% if has_desktop_video == false and section.settings.stack_images_on_mobile and section.settings.image != blank and section.settings.image_2 != blank and has_mobile_media == false %} banner--stacked{% endif %}{% if mobile_banner_aspect_ratio != blank and section.settings.image_height == 'adapt' or mobile_banner_aspect_ratio != blank and use_full_media_adapt %} banner--adapt{% endif %}{% if section.settings.show_full_media %} banner--show-full-media{% endif %}{% if section.settings.mobile_center_zoom %} banner--mobile-center-zoom{% endif %}{% if section.settings.mobile_center_zoom and section.settings.mobile_auto_subject_focus %} banner--mobile-auto-subject-focus{% endif %}{% if section.settings.show_text_below %} banner--mobile-bottom{%- endif -%}{% if section.settings.show_text_box == false %} banner--desktop-transparent{% endif %}{% if enable_section_reveal %} scroll-trigger animate--fade-in{% endif %}"
>
  {%- if has_responsive_webm_video -%}
    <div class="banner__media media{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if enable_section_reveal %} scroll-trigger animate--fade-in{% endif %}">
      <video
        id="Banner-{{ section.id }}-responsive-webm"
        class="banner__media-video"
        data-responsive-webm
        data-mobile-src="{{ mobile_webm_url | escape }}"
        data-desktop-src="{{ desktop_webm_url | escape }}"
        {% if mobile_video_fallback_url != blank %}
          data-mobile-fallback-src="{{ mobile_video_fallback_url | escape }}"
        {% endif %}
        {% if desktop_video_fallback_url != blank %}
          data-desktop-fallback-src="{{ desktop_video_fallback_url | escape }}"
        {% endif %}
        {% if section.settings.mobile_video.preview_image != blank %}
          data-mobile-poster="{{ section.settings.mobile_video.preview_image | image_url: width: 900 }}"
        {% endif %}
        {% if section.settings.video.preview_image != blank %}
          data-desktop-poster="{{ section.settings.video.preview_image | image_url: width: 3840 }}"
        {% endif %}
        autoplay
        loop
        muted
        playsinline
        {% if section.index == 1 %}fetchpriority="high"{% endif %}
        preload="{% if section.index == 1 %}auto{% else %}metadata{% endif %}"
      >
        <source src="{{ mobile_webm_url }}" type="video/webm" media="(max-width: 749px)">
        {% if mobile_video_fallback_url != blank %}
          <source src="{{ mobile_video_fallback_url }}" type="video/mp4" media="(max-width: 749px)">
        {% endif %}
        <source src="{{ desktop_webm_url }}" type="video/webm" media="(min-width: 750px)">
        {% if desktop_video_fallback_url != blank %}
          <source src="{{ desktop_video_fallback_url }}" type="video/mp4" media="(min-width: 750px)">
        {% endif %}
      </video>
      <script src="{{ 'image-banner-responsive-video.js' | asset_url }}" async></script>
    </div>
  {%- elsif has_desktop_video -%}
    <div class="banner__media banner__media--desktop media{% if has_mobile_media %} small-hide{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if enable_section_reveal %} scroll-trigger animate--fade-in{% endif %}">
      {%- if desktop_webm_url != blank -%}
        <video
          class="banner__media-video"
          autoplay
          loop
          muted
          playsinline
          preload="{% if section.index == 1 %}auto{% else %}metadata{% endif %}"
          {% if section.settings.video.preview_image != blank %}
            poster="{{ section.settings.video.preview_image | image_url: width: 3840 }}"
          {% endif %}
        >
          <source src="{{ desktop_webm_url }}" type="video/webm">
          {%- if section.settings.video.preview_image != blank -%}
            {{
              section.settings.video.preview_image
              | image_url: width: 3840
              | image_tag: class: 'banner__media-video-poster', loading: 'lazy'
            }}
          {%- endif -%}
        </video>
      {%- else -%}
        {{
          section.settings.video
          | video_tag:
            image_size: '3840x',
            autoplay: true,
            loop: true,
            muted: true,
            playsinline: true,
            controls: false,
            preload: 'metadata',
            class: 'banner__media-video'
        }}
      {%- endif -%}
    </div>
  {%- elsif section.settings.image != blank -%}
    <div class="banner__media banner__media--desktop media{% if has_mobile_media %} small-hide{% endif %}{% if section.settings.image == blank and section.settings.image_2 == blank %} placeholder{% endif %}{% if section.settings.image_2 != blank %} banner__media-half{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if enable_section_reveal %} scroll-trigger animate--fade-in{% endif %}">
      {%- liquid
        assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
        if section.settings.image_2 != blank
          assign image_class = 'banner__media-image-half'
        endif
        if section.settings.image_2 != blank and section.settings.stack_images_on_mobile
          assign sizes = stacked_sizes
        elsif section.settings.image_2 != blank
          assign sizes = half_width
        else
          assign sizes = full_width
        endif
      -%}
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image.width,
          height: image_height,
          class: image_class,
          sizes: sizes,
          widths: widths,
          loading: image_loading,
          fetchpriority: fetch_priority
      }}
    </div>
  {%- elsif section.settings.image_2 == blank -%}
    <div class="banner__media banner__media--desktop media{% if has_mobile_media %} small-hide{% endif %}{% if section.settings.image == blank and section.settings.image_2 == blank %} placeholder{% endif %}{% if section.settings.image_2 != blank %} banner__media-half{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if enable_section_reveal %} scroll-trigger animate--fade-in{% endif %}">
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}
  {%- if has_desktop_video == false and section.settings.image_2 != blank -%}
    <div class="banner__media banner__media--desktop media{% if has_mobile_media %} small-hide{% endif %}{% if section.settings.image != blank %} banner__media-half{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if enable_section_reveal %} scroll-trigger animate--fade-in{% endif %}">
      {%- liquid
        assign image_height_2 = section.settings.image_2.width | divided_by: section.settings.image_2.aspect_ratio
        if section.settings.image != blank
          assign image_class_2 = 'banner__media-image-half'
        endif
        if section.settings.image != blank and section.settings.stack_images_on_mobile
          assign sizes = stacked_sizes
        elsif section.settings.image_2 != blank
          assign sizes = half_width
        else
          assign sizes = full_width
        endif
      -%}
      {{
        section.settings.image_2
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image_2.width,
          height: image_height_2,
          class: image_class_2,
          sizes: sizes,
          widths: widths,
          loading: image_loading,
          fetchpriority: fetch_priority
      }}
    </div>
  {%- endif -%}
  {%- if has_mobile_video == false and section.settings.mobile_image != blank -%}
    <div class="banner__media banner__media--mobile media medium-hide large-up-hide{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if enable_section_reveal %} scroll-trigger animate--fade-in{% endif %}">
      {%- liquid
        assign mobile_image_height = section.settings.mobile_image.width | divided_by: section.settings.mobile_image.aspect_ratio
      -%}
      {{
        section.settings.mobile_image
        | image_url: width: 1500
        | image_tag:
          width: section.settings.mobile_image.width,
          height: mobile_image_height,
          sizes: '100vw',
          widths: '375, 550, 750, 900, 1100, 1500',
          loading: image_loading,
          fetchpriority: fetch_priority
      }}
    </div>
  {%- endif -%}
  {%- if has_mobile_video and has_responsive_webm_video == false -%}
    <div class="banner__media banner__media--mobile media medium-hide large-up-hide{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if enable_section_reveal %} scroll-trigger animate--fade-in{% endif %}">
      {%- if mobile_webm_url != blank -%}
        <video
          class="banner__media-video"
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          {% if section.settings.mobile_video.preview_image != blank %}
            poster="{{ section.settings.mobile_video.preview_image | image_url: width: 900 }}"
          {% endif %}
        >
          <source src="{{ mobile_webm_url }}" type="video/webm">
          {%- if section.settings.mobile_video.preview_image != blank -%}
            {{
              section.settings.mobile_video.preview_image
              | image_url: width: 900
              | image_tag: class: 'banner__media-video-poster', loading: 'lazy'
            }}
          {%- endif -%}
        </video>
      {%- else -%}
        {{
          section.settings.mobile_video
          | video_tag:
            image_size: '900x',
            autoplay: true,
            loop: true,
            muted: true,
            playsinline: true,
            controls: false,
            preload: 'metadata',
            class: 'banner__media-video'
        }}
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="banner__content banner__content--{{ section.settings.desktop_content_position }} page-width{% if enable_section_reveal %} scroll-trigger animate--slide-in{% endif %}">
    <div class="banner__box content-container content-container--full-width-mobile color-{{ section.settings.color_scheme }} gradient">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2
              class="banner__heading inline-richtext {{ block.settings.heading_size }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.heading }}
            </h2>
          {%- when 'text' -%}
            <div class="banner__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
              <p>{{ block.settings.text }}</p>
            </div>
          {%- when 'buttons' -%}
            <div
              class="banner__buttons{% if block.settings.button_label_1 != blank and block.settings.button_label_2 != blank %} banner__buttons--multiple{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.button_label_1 != blank -%}
                <a
                  {% if block.settings.button_link_1 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_1 }}"
                  {% endif %}
                  class="button{% if block.settings.button_style_secondary_1 %} button--secondary{% else %} button--primary{% endif %}{% if section.settings.prada_link_button %} prada-banner-link-button{% endif %}"
                >
                  {%- if section.settings.prada_link_button -%}
                    <span class="prada-banner-link-label">{{- block.settings.button_label_1 | escape -}}</span>
                  {%- else -%}
                    {{- block.settings.button_label_1 | escape -}}
                  {%- endif -%}
                </a>
              {%- endif -%}
              {%- if block.settings.button_label_2 != blank -%}
                <a
                  {% if block.settings.button_link_2 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_2 }}"
                  {% endif %}
                  class="button{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}{% if section.settings.prada_link_button %} prada-banner-link-button{% endif %}"
                >
                  {%- if section.settings.prada_link_button -%}
                    <span class="prada-banner-link-label">{{- block.settings.button_label_2 | escape -}}</span>
                  {%- else -%}
                    {{- block.settings.button_label_2 | escape -}}
                  {%- endif -%}
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
