{{ 'grey-exim-privacy-policy.css' | asset_url | stylesheet_tag }}
{{ 'grey-exim-cookie-policy.css' | asset_url | stylesheet_tag }}
{{ 'grey-exim-terms-policy.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign terms_policy_title = section.settings.title | default: 'Terms and Conditions'
  assign terms_policy_updated = section.settings.last_updated | default: 'Last updated: 14 August 2026'
  assign terms_policy_toc_label = section.settings.toc_label | default: 'On this page'
-%}

<article
  id="GreyTermsPolicy-{{ section.id }}"
  class="grey-policy grey-cookie-policy grey-terms-policy"
  data-terms-policy
  aria-labelledby="GreyTermsPolicyTitle-{{ section.id }}"
>
  <header class="grey-policy__hero">
    <div class="grey-policy__hero-inner">
      <h1 id="GreyTermsPolicyTitle-{{ section.id }}">{{ terms_policy_title | escape }}</h1>
      {%- if terms_policy_updated != blank -%}
        <p class="grey-policy__updated">{{ terms_policy_updated | escape }}</p>
      {%- endif -%}
    </div>
  </header>

  <div class="grey-policy__shell">
    <aside class="grey-policy__aside" data-terms-policy-aside>
      <details class="grey-policy__toc" open>
        <summary>{{ terms_policy_toc_label | escape }}</summary>
        <nav aria-label="{{ terms_policy_title | escape }} sections" data-terms-policy-toc>
          <ol></ol>
        </nav>
      </details>
    </aside>

    <div class="grey-policy__content rte">
      <div class="grey-terms-policy__source" data-terms-policy-source>
        {%- if section.settings.policy_content != blank -%}
          {{ section.settings.policy_content }}
        {%- elsif request.design_mode -%}
          <p class="grey-terms-policy__empty">
            Paste your complete Terms and Conditions in this section's <strong>Policy content</strong> setting. Format every main section title as Heading 2 to create the numbered navigation automatically.
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
</article>

<script>
  (() => {
    const rootId = 'GreyTermsPolicy-{{ section.id }}';

    const slugify = (value) => value
      .toLowerCase()
      .normalize('NFKD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');

    const initialiseTermsPolicy = () => {
      const root = document.getElementById(rootId);
      if (!root || root.dataset.termsPolicyReady === 'true') return;

      const source = root.querySelector('[data-terms-policy-source]');
      const toc = root.querySelector('[data-terms-policy-toc] ol');
      const aside = root.querySelector('[data-terms-policy-aside]');
      if (!source || !toc || !aside) return;

      const sourceNodes = Array.from(source.childNodes).filter((node) => (
        node.nodeType !== Node.TEXT_NODE || node.textContent.trim() !== ''
      ));

      const fragment = document.createDocumentFragment();
      let currentContainer = document.createElement('div');
      currentContainer.className = 'grey-policy__intro';
      let sectionIndex = 0;
      const usedIds = new Set();

      const normaliseLabel = (value) => value
        .trim()
        .toLowerCase()
        .replace(/\s+/g, ' ')
        .replace(/:$/, '');

      const enhanceContactSection = (contactSection) => {
        if (!contactSection || contactSection.querySelector('.grey-policy__contact-card')) return;

        const heading = contactSection.querySelector(':scope > h2');
        const blocks = Array.from(contactSection.children).filter((child) => child !== heading);
        if (!blocks.length) return;

        const textFromBlock = (block) => {
          const clone = block.cloneNode(true);

          clone.querySelectorAll('strong, b').forEach((strong) => {
            const label = normaliseLabel(strong.textContent || '');
            if (['grey exim', 'email', 'website'].includes(label)) {
              strong.before(document.createTextNode('\n'));
              strong.after(document.createTextNode('\n'));
            }
          });

          const parts = [];
          const visit = (node, isRoot = false) => {
            if (node.nodeType === Node.TEXT_NODE) {
              parts.push(node.textContent || '');
              return;
            }
            if (node.nodeType !== Node.ELEMENT_NODE) return;
            if (node.tagName === 'BR') {
              parts.push('\n');
              return;
            }

            const isBlock = !isRoot && ['P', 'DIV', 'LI', 'ADDRESS'].includes(node.tagName);
            if (isBlock) parts.push('\n');
            Array.from(node.childNodes).forEach((child) => visit(child));
            if (isBlock) parts.push('\n');
          };

          visit(clone, true);
          return parts.join('');
        };

        const flattenedText = blocks
          .map(textFromBlock)
          .join('\n')
          .replace(/\u00a0/g, ' ')
          .replace(/[ \t]+\n/g, '\n')
          .replace(/\n[ \t]+/g, '\n')
          .replace(/\n{2,}/g, '\n')
          .trim();

        const findMarker = (pattern, startAt = 0) => {
          const match = flattenedText.slice(startAt).match(pattern);
          if (!match) return null;
          return {
            index: startAt + match.index,
            end: startAt + match.index + match[0].length,
          };
        };

        const addressMarker = findMarker(/(?:^|\n)\s*Grey Exim\s*/i);
        const emailMarker = addressMarker && findMarker(/(?:^|\n)\s*Email\s*:?\s*/i, addressMarker.end);
        const websiteMarker = emailMarker && findMarker(/(?:^|\n)\s*Website\s*:?\s*/i, emailMarker.end);
        if (!addressMarker || !emailMarker || !websiteMarker) return;

        const introText = flattenedText.slice(0, addressMarker.index).trim();
        const addressLines = flattenedText
          .slice(addressMarker.end, emailMarker.index)
          .split(/\n+/)
          .map((line) => line.trim())
          .filter(Boolean);

        const emailAnchor = contactSection.querySelector('a[href^="mailto:"]');
        const emailSlice = flattenedText.slice(emailMarker.end, websiteMarker.index);
        const emailValue = (
          emailAnchor?.getAttribute('href')?.replace(/^mailto:/i, '') ||
          emailAnchor?.textContent ||
          emailSlice.match(/[\w.+-]+@[\w.-]+\.[a-z]{2,}/i)?.[0] ||
          ''
        ).trim();

        const websiteAnchor = Array.from(contactSection.querySelectorAll('a[href]')).find((anchor) => (
          !anchor.getAttribute('href')?.toLowerCase().startsWith('mailto:') &&
          /greyexim\.com/i.test(`${anchor.textContent} ${anchor.getAttribute('href')}`)
        ));
        const websiteSlice = flattenedText.slice(websiteMarker.end);
        const websiteValue = (
          websiteAnchor?.textContent ||
          websiteSlice.match(/(?:https?:\/\/)?(?:www\.)?greyexim\.com(?:\/[^\s]*)?/i)?.[0] ||
          'www.greyexim.com'
        ).trim().replace(/[.,;]+$/, '');
        const websiteHref = websiteAnchor?.getAttribute('href') || (
          /^https?:\/\//i.test(websiteValue) ? websiteValue : `https://${websiteValue}`
        );

        if (!addressLines.length || !emailValue) return;

        blocks.forEach((block) => block.remove());

        if (introText) {
          const intro = document.createElement('p');
          intro.textContent = introText.replace(/\n+/g, ' ');
          contactSection.appendChild(intro);
        }

        const card = document.createElement('div');
        card.className = 'grey-policy__contact-card';

        const address = document.createElement('address');
        const addressName = document.createElement('strong');
        addressName.textContent = 'Grey Exim';
        address.append(addressName);
        addressLines.forEach((line) => {
          address.append(document.createElement('br'), document.createTextNode(line));
        });

        const email = document.createElement('p');
        const emailLabel = document.createElement('strong');
        emailLabel.textContent = 'Email';
        const emailLink = document.createElement('a');
        emailLink.href = `mailto:${emailValue}`;
        emailLink.textContent = emailValue;
        email.append(emailLabel, document.createElement('br'), emailLink);

        const website = document.createElement('p');
        const websiteLabel = document.createElement('strong');
        websiteLabel.textContent = 'Website';
        const websiteLink = document.createElement('a');
        websiteLink.href = websiteHref;
        websiteLink.textContent = websiteValue.replace(/^https?:\/\//i, '');
        website.append(websiteLabel, document.createElement('br'), websiteLink);

        card.append(address, email, website);
        contactSection.appendChild(card);
      };

      const appendCurrentContainer = () => {
        if (currentContainer.childNodes.length) fragment.appendChild(currentContainer);
      };

      sourceNodes.forEach((node) => {
        const isSectionHeading = node.nodeType === Node.ELEMENT_NODE && node.tagName === 'H2';

        if (isSectionHeading) {
          appendCurrentContainer();
          sectionIndex += 1;

          const headingText = node.textContent.trim();
          const sectionElement = document.createElement('section');
          let sectionId = `terms-${slugify(headingText) || `section-${sectionIndex}`}`;
          let suffix = 2;
          while (usedIds.has(sectionId)) {
            sectionId = `terms-${slugify(headingText) || `section-${sectionIndex}`}-${suffix}`;
            suffix += 1;
          }
          usedIds.add(sectionId);

          sectionElement.id = sectionId;
          sectionElement.className = 'grey-policy__section';
          const headingLabel = normaliseLabel(headingText).replace(/^\d+[.)\s:-]+/, '');
          if (headingLabel === 'contact us') {
            sectionElement.classList.add('grey-policy__section--contact');
            sectionElement.dataset.termsContact = '';
          }

          const marker = document.createElement('span');
          marker.setAttribute('aria-hidden', 'true');
          marker.textContent = String(sectionIndex).padStart(2, '0');
          node.prepend(marker, document.createTextNode(' '));
          sectionElement.appendChild(node);

          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = `#${sectionId}`;
          link.textContent = headingText;
          item.appendChild(link);
          toc.appendChild(item);

          currentContainer = sectionElement;
          return;
        }

        currentContainer.appendChild(node);
      });

      appendCurrentContainer();
      source.replaceChildren(fragment);
      enhanceContactSection(source.querySelector('[data-terms-contact]'));

      source.querySelectorAll('table').forEach((table) => {
        if (table.parentElement?.classList.contains('grey-terms-policy__table-wrap')) return;
        const wrapper = document.createElement('div');
        wrapper.className = 'grey-terms-policy__table-wrap';
        wrapper.setAttribute('role', 'region');
        wrapper.setAttribute('aria-label', 'Terms and conditions table');
        wrapper.tabIndex = 0;
        table.parentNode.insertBefore(wrapper, table);
        wrapper.appendChild(table);
      });

      aside.hidden = sectionIndex === 0;
      root.dataset.termsPolicyReady = 'true';
    };

    initialiseTermsPolicy();
    document.addEventListener('shopify:section:load', (event) => {
      if (event.detail?.sectionId === '{{ section.id }}') initialiseTermsPolicy();
    });
  })();
</script>

{% schema %}
{
  "name": "Grey Exim terms policy",
  "tag": "section",
  "class": "section-grey-exim-terms-policy",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Policy title",
      "default": "Terms and Conditions"
    },
    {
      "type": "text",
      "id": "last_updated",
      "label": "Last updated text",
      "default": "Last updated: 14 August 2026"
    },
    {
      "type": "text",
      "id": "toc_label",
      "label": "Navigation heading",
      "default": "On this page"
    },
    {
      "type": "richtext",
      "id": "policy_content",
      "label": "Policy content",
      "info": "Paste the complete Terms and Conditions here. Format every main section title as Heading 2; section numbers and On this page links are created automatically."
    }
  ]
}
{% endschema %}
