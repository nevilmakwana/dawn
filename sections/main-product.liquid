{{ 'greyexim-prada-product.css' | asset_url | stylesheet_tag }}
{{ 'greyexim-prada-mobile-flow.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'PradaProductForm-' | append: section.id
  assign detail_fit = product.metafields.custom.description_fit
  assign detail_materials = product.metafields.custom.materials
  assign detail_care = product.metafields.custom.care_guide
  assign detail_delivery = product.metafields.custom.delivery_and_payment
  assign category_color_metafield = product.metafields.shopify['color-pattern']
  assign product_color_label = category_color_metafield.value | map: 'label' | join: ', '
  if product_color_label == blank
    assign product_color_label = 'As shown'
  endif
  assign fallback_color_label = current_variant.metafields.custom.variant_color.value
  if fallback_color_label == blank
    assign fallback_color_label = current_variant.metafields.custom.custom_variant_color.value
  endif
  if fallback_color_label == blank
    assign fallback_color_label = product_color_label
  endif
  assign current_variant_gallery = current_variant.metafields.custom.variant_images.value
  if current_variant_gallery == blank
    assign current_variant_gallery = current_variant.metafields.custom.custom_variant_images.value
  endif
  assign current_variant_primary_image = blank
  for variant_media in current_variant_gallery
    if variant_media.media_type == 'image'
      assign current_variant_primary_image = variant_media
      break
    endif
  endfor
  assign storefront_primary_media = product.featured_media
  if storefront_primary_media == blank
    assign storefront_primary_media = current_variant_primary_image
  endif
  assign wishlist_media = current_variant.featured_media
  if wishlist_media == blank
    assign wishlist_media = storefront_primary_media
  endif
  assign has_color_option = false
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'color' or option_name contains 'colour'
      assign has_color_option = true
      break
    endif
  endfor
-%}

<section
  class="prada-product"
  id="PradaProduct-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-product-url="{{ product.url }}"
  data-wishlist-fallback-image="{% if storefront_primary_media %}{{ storefront_primary_media.preview_image | image_url: width: 720 | escape }}{% endif %}"
  data-wishlist-fallback-image-alt="{{ storefront_primary_media.alt | default: product.title | escape }}"
>
  <div class="prada-product__gallery" aria-label="{{ product.title | escape }} gallery">
    <button
      class="prada-product__wishlist"
      type="button"
      data-prada-product-wishlist
      data-product-id="{{ product.id }}"
      data-product-title="{{ product.title | escape }}"
      data-product-url="{{ product.url | escape }}?variant={{ current_variant.id }}"
      data-product-image="{% if wishlist_media %}{{ wishlist_media.preview_image | image_url: width: 720 | escape }}{% endif %}"
      data-product-image-alt="{{ wishlist_media.alt | default: product.title | escape }}"
      data-product-price="{{ current_variant.price | money | strip_html | escape }}"
      data-product-variant-id="{{ current_variant.id }}"
      data-product-available="{{ current_variant.available }}"
      aria-label="Add {{ product.title | escape }} to wishlist"
      aria-pressed="false"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z"/></svg>
    </button>

    <div class="prada-product__media-list">
      {%- if product.media.size > 0 -%}
        {%- for media in product.media -%}
          <figure
            class="prada-product__media prada-product__media--{{ media.media_type }}"
            id="PradaMedia-{{ section.id }}-{{ forloop.index }}"
            data-prada-media-label="View {{ media.media_type | replace: '_', ' ' }} {{ forloop.index }}"
          >
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {%- liquid
                  assign media_loading = 'lazy'
                  assign media_fetch_priority = 'auto'
                  if forloop.first
                    assign media_loading = 'eager'
                    assign media_fetch_priority = 'high'
                  endif
                -%}
                {{ media.preview_image | image_url: width: 1800 | image_tag:
                  loading: media_loading,
                  fetchpriority: media_fetch_priority,
                  widths: '550, 750, 950, 1200, 1500, 1800',
                  sizes: '(min-width: 990px) 50vw, 100vw',
                  alt: media.alt | default: product.title,
                  class: 'prada-product__gallery-image'
                }}
              {%- when 'video' -%}
                {{ media | video_tag: controls: false, autoplay: true, loop: true, muted: true, playsinline: true, preload: 'metadata', image_size: '1200x' }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag: autoplay: true, loop: true, muted: true, loading: 'lazy' }}
              {%- when 'model' -%}
                {{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true }}
            {%- endcase -%}
          </figure>
        {%- endfor -%}
      {%- elsif current_variant_gallery != blank -%}
        {%- for media in current_variant_gallery -%}
          {%- if media.media_type == 'image' or media.media_type == 'video' -%}
            {%- render 'prada-variant-media',
              media: media,
              section_id: section.id,
              variant_id: current_variant.id,
              position: forloop.index
            -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <figure
          class="prada-product__media prada-product__media--placeholder"
          id="PradaMedia-{{ section.id }}-1"
          data-prada-media-label="View product image"
        >
          {{ 'product-1' | placeholder_svg_tag }}
        </figure>
      {%- endif -%}
    </div>

    {%- assign initial_gallery_count = product.media.size -%}
    {%- if initial_gallery_count == 0 -%}
      {%- assign initial_gallery_count = current_variant_gallery.size -%}
    {%- endif -%}
    <nav class="prada-product__dots" aria-label="Choose product image"{% if initial_gallery_count <= 1 %} hidden{% endif %}>
      {%- if product.media.size > 0 -%}
        {%- for media in product.media -%}
          <a href="#PradaMedia-{{ section.id }}-{{ forloop.index }}" data-prada-dot="{{ forloop.index0 }}" aria-label="View {{ media.media_type | replace: '_', ' ' }} {{ forloop.index }}"{% if forloop.first %} class="is-active" aria-current="true"{% endif %}>
            <span></span>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for media in current_variant_gallery -%}
          {%- if media.media_type == 'image' or media.media_type == 'video' -%}
            <a href="#PradaVariantMedia-{{ section.id }}-{{ current_variant.id }}-{{ forloop.index }}" data-prada-dot="{{ forloop.index0 }}" aria-label="View {{ media.media_type | replace: '_', ' ' }} {{ forloop.index }}"{% if forloop.first %} class="is-active" aria-current="true"{% endif %}>
              <span></span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </nav>
    <div class="prada-product__scroll-hint" data-prada-scroll-hint aria-hidden="true">Scroll more pictures</div>
  </div>

  <div class="prada-product__panel">
    <button class="prada-product__sheet-handle" type="button" data-prada-sheet-handle aria-label="Open product information" aria-expanded="false">
      <span></span>
    </button>
    <div class="prada-product__info">
      <div class="prada-product__heading-row">
        <h1>{{ product.title | escape }}</h1>
        <button
          class="prada-product__wishlist prada-product__wishlist--mobile"
          type="button"
          data-prada-product-wishlist
          data-product-id="{{ product.id }}"
          data-product-title="{{ product.title | escape }}"
          data-product-url="{{ product.url | escape }}?variant={{ current_variant.id }}"
          data-product-image="{% if wishlist_media %}{{ wishlist_media.preview_image | image_url: width: 720 | escape }}{% endif %}"
          data-product-image-alt="{{ wishlist_media.alt | default: product.title | escape }}"
          data-product-price="{{ current_variant.price | money | strip_html | escape }}"
          data-product-variant-id="{{ current_variant.id }}"
          data-product-available="{{ current_variant.available }}"
          aria-label="Add {{ product.title | escape }} to wishlist"
          aria-pressed="false"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z"/></svg>
        </button>
      </div>

      <div class="prada-product__price" data-prada-price data-currency-price>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <s class="money">{{ current_variant.compare_at_price | money }}</s>
        {%- endif -%}
        <span class="money">{{ current_variant.price | money }}</span>
      </div>

      <product-form
        class="prada-product__form-shell"
        data-section-id="{{ section.id }}"
        data-cart-target="drawer"
        data-open-cart="true"
      >
        <div class="prada-product__form-error product-form__error-message-wrapper" role="alert" hidden>
          <span class="product-form__error-message"></span>
        </div>
        {%- form 'product', product, id: form_id, class: 'prada-product__form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-prada-variant-id>

          <div class="prada-product__options">
            {%- comment -%}Color is intentionally rendered first, regardless of Shopify option order.{%- endcomment -%}
            {%- for option in product.options_with_values -%}
              {%- assign option_name = option.name | downcase -%}
              {%- if option_name contains 'color' or option_name contains 'colour' -%}
                <div class="prada-product__option prada-product__option--color">
                  <div class="prada-product__color-heading">
                    <strong>{{ option.name }}</strong>
                    <span data-prada-selected-value="{{ forloop.index0 }}">{{ option.selected_value }}</span>
                  </div>
                  <div class="prada-product__swatches" aria-label="Choose {{ option.name | escape }}">
                    {%- assign color_option_index = forloop.index0 -%}
                    {%- for value in option.values -%}
                      {%- assign swatch_image = blank -%}
                      {%- assign configured_swatch = blank -%}
                      {%- assign normalized_value = value | downcase | strip -%}
                      {%- for block in section.blocks -%}
                        {%- assign configured_value = block.settings.variant_value | downcase | strip -%}
                        {%- if block.type == 'color_swatch' and configured_value == normalized_value -%}
                          {%- assign configured_swatch = block.settings.swatch_color -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {%- for variant in product.variants -%}
                        {%- if variant.options[color_option_index] == value -%}
                          {%- assign variant_swatch_gallery = variant.metafields.custom.variant_images.value -%}
                          {%- if variant_swatch_gallery == blank -%}
                            {%- assign variant_swatch_gallery = variant.metafields.custom.custom_variant_images.value -%}
                          {%- endif -%}
                          {%- assign variant_swatch_media = variant_swatch_gallery | first -%}
                          {%- if variant_swatch_media.media_type == 'image' -%}
                            {%- assign swatch_image = variant_swatch_media.preview_image | image_url: width: 1800 -%}
                            {%- break -%}
                          {%- elsif variant.featured_media != blank -%}
                            {%- assign swatch_image = variant.featured_media.preview_image | image_url: width: 1800 -%}
                            {%- break -%}
                          {%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}
                      <button
                        class="prada-product__swatch{% if option.selected_value == value %} is-selected{% endif %}"
                        type="button"
                        aria-label="{{ value | escape }}"
                        aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                        data-prada-option-choice="{{ color_option_index }}"
                        data-prada-option-value="{{ value | escape }}"
                        {% if swatch_image != blank %}data-prada-image="{{ swatch_image }}"{% endif %}
                      >
                        {%- if swatch_image != blank -%}
                          <img src="{{ swatch_image }}" alt="" loading="lazy" width="84" height="105">
                        {%- else -%}
                          <span style="--swatch-color: {% if configured_swatch != blank %}{{ configured_swatch }}{% elsif value.swatch.color != blank %}{{ value.swatch.color }}{% else %}{{ value | handle | replace: '-', ' ' }}{% endif %};"></span>
                        {%- endif -%}
                      </button>
                    {%- endfor -%}
                  </div>
                  <select id="PradaOption-{{ section.id }}-{{ forloop.index0 }}" data-prada-option="{{ forloop.index0 }}" hidden aria-hidden="true" tabindex="-1">
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endif -%}
            {%- endfor -%}

            {%- unless has_color_option -%}
              {%- liquid
                assign fallback_swatch_media = current_variant.featured_media
                if fallback_swatch_media == blank
                  assign fallback_swatch_media = storefront_primary_media
                endif
              -%}
              <div class="prada-product__option prada-product__option--color prada-product__option--fallback-color">
                <div class="prada-product__color-heading">
                  <strong>Color</strong>
                  <span data-prada-fallback-color-value>{{ fallback_color_label }}</span>
                </div>
                <div class="prada-product__swatches" aria-label="Product color">
                  <span class="prada-product__swatch prada-product__swatch--static is-selected" role="img" aria-label="Color {{ fallback_color_label | escape }}">
                    {%- if fallback_swatch_media != blank -%}
                      <img src="{{ fallback_swatch_media.preview_image | image_url: width: 1800 }}" alt="" loading="lazy" width="84" height="105">
                    {%- else -%}
                      <span></span>
                    {%- endif -%}
                  </span>
                </div>
              </div>
            {%- endunless -%}

            {%- for option in product.options_with_values -%}
              {%- assign option_name = option.name | downcase -%}
              {%- liquid
                assign is_default_title_option = false
                assign first_option_value = option.values.first | downcase
                if option_name == 'title' and option.values.size == 1 and first_option_value == 'default title'
                  assign is_default_title_option = true
                endif
              -%}
              {%- unless option_name contains 'color' or option_name contains 'colour' or is_default_title_option -%}
                <div class="prada-product__option{% if option_name contains 'size' %} prada-product__option--size{% endif %}">
                  {%- unless option_name contains 'size' -%}<span>{{ option.name }}</span>{%- endunless -%}
                  <button
                    class="prada-product__option-trigger"
                    type="button"
                    data-prada-drawer-open="option-{{ forloop.index0 }}"
                    data-prada-drawer-label="Select {{ option.name | escape }}"
                  >
                    <span>{% if option_name contains 'size' %}Size&nbsp;&nbsp;{% endif %}<span data-prada-selected-value="{{ forloop.index0 }}">{{ option.selected_value }}</span></span>
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m3 6 5 5 5-5"/></svg>
                  </button>
                  {%- if option_name contains 'size' -%}
                    <button class="prada-product__size-chart-trigger" type="button" data-prada-drawer-open="size-chart" data-prada-drawer-label="Size chart">Size chart</button>
                  {%- endif -%}
                  <select id="PradaOption-{{ section.id }}-{{ forloop.index0 }}" data-prada-option="{{ forloop.index0 }}" hidden aria-hidden="true" tabindex="-1">
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endunless -%}
            {%- endfor -%}
          </div>

          <button class="prada-product__submit" type="submit" name="add" {% unless current_variant.available %}disabled{% endunless %} data-prada-submit>
            <span data-prada-submit-text>{%- if current_variant.available -%}Add to bag{%- else -%}Available soon{%- endif -%}</span>
            {%- render 'loading-spinner' -%}
          </button>
        {%- endform -%}
      </product-form>

      {%- if product.description != blank or detail_fit != blank or detail_materials != blank or detail_care != blank or detail_delivery != blank -%}
        <button class="prada-product__drawer-trigger" type="button" data-prada-drawer-open="details">
          <span>Product details</span>
        </button>
      {%- endif -%}

      <button class="prada-product__drawer-trigger" type="button" data-prada-drawer-open="shipping">
        <span>Free shipping and returns</span>
      </button>
    </div>
  </div>

  <div class="prada-product__drawer-shell" data-prada-drawer aria-hidden="true">
    <button class="prada-product__drawer-backdrop" type="button" data-prada-drawer-close aria-label="Close information panel"></button>
    <aside class="prada-product__drawer" role="dialog" aria-modal="true" aria-labelledby="PradaDrawerTitle-{{ section.id }}">
      <header class="prada-product__drawer-header">
        <h2 id="PradaDrawerTitle-{{ section.id }}" data-prada-drawer-title></h2>
        <button class="prada-product__drawer-close" type="button" data-prada-drawer-close aria-label="Close information panel">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"/></svg>
        </button>
      </header>
      <div class="prada-product__drawer-body">
        <div class="prada-product__drawer-pane rte" data-prada-drawer-pane="details" hidden>
          {%- if detail_fit != blank or product.description != blank -%}
            <section class="prada-product__metafield-section">
              <div>
                {%- if detail_fit != blank -%}
                  {{ detail_fit | metafield_tag }}
                {%- else -%}
                  {{ product.description }}
                {%- endif -%}
              </div>
            </section>
          {%- endif -%}

          {%- if detail_materials != blank -%}
            <details class="prada-product__drawer-accordion">
              <summary><span>Materials</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m3 6 5 5 5-5"/></svg></summary>
              <div>{{ detail_materials | metafield_tag }}</div>
            </details>
          {%- endif -%}

          {%- if detail_care != blank -%}
            <details class="prada-product__drawer-accordion">
              <summary><span>Care guide</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m3 6 5 5 5-5"/></svg></summary>
              <div>{{ detail_care | metafield_tag }}</div>
            </details>
          {%- endif -%}

          {%- if detail_delivery != blank -%}
            <details class="prada-product__drawer-accordion">
              <summary><span>Delivery and payment</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m3 6 5 5 5-5"/></svg></summary>
              <div>{{ detail_delivery | metafield_tag }}</div>
            </details>
          {%- endif -%}
        </div>
        <div class="prada-product__drawer-pane rte" data-prada-drawer-pane="shipping" hidden>
          <p>Shipping and return options are calculated at checkout.</p>
          {%- if shop.shipping_policy.body != blank -%}{{ shop.shipping_policy.body }}{%- endif -%}
        </div>
        <div class="prada-product__drawer-pane prada-product__size-chart" data-prada-drawer-pane="size-chart" hidden>
          {%- if section.settings.size_chart_image != blank -%}
            {{ section.settings.size_chart_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw', alt: 'Size chart' }}
          {%- else -%}
            <p>Add a size chart image from the product section settings in Theme Editor.</p>
          {%- endif -%}
        </div>
        {%- for option in product.options_with_values -%}
          {%- assign drawer_option_name = option.name | downcase -%}
          {%- unless drawer_option_name contains 'color' or drawer_option_name contains 'colour' -%}
          <div class="prada-product__drawer-pane" data-prada-drawer-pane="option-{{ forloop.index0 }}" hidden>
            <div class="prada-product__choice-list" role="listbox" aria-label="{{ option.name | escape }}">
              {%- assign option_index = forloop.index0 -%}
              {%- for value in option.values -%}
                <button
                  class="prada-product__choice{% if option.selected_value == value %} is-selected{% endif %}"
                  type="button"
                  role="option"
                  aria-selected="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                  data-prada-option-choice="{{ option_index }}"
                  data-prada-option-value="{{ value | escape }}"
                >
                  <span>{{ value }}</span>
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4 10 4 4 8-9"/></svg>
                </button>
              {%- endfor -%}
            </div>
          </div>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </aside>
  </div>

  {%- for variant in product.variants -%}
    {%- assign variant_gallery = variant.metafields.custom.variant_images.value -%}
    {%- if variant_gallery == blank -%}
      {%- assign variant_gallery = variant.metafields.custom.custom_variant_images.value -%}
    {%- endif -%}
    {%- if variant_gallery != blank -%}
      <template data-prada-variant-gallery="{{ variant.id }}">
        {%- for media in variant_gallery -%}
          {%- if media.media_type == 'image' or media.media_type == 'video' -%}
            {%- render 'prada-variant-media',
              media: media,
              section_id: section.id,
              variant_id: variant.id,
              position: forloop.index
            -%}
          {%- endif -%}
        {%- endfor -%}
      </template>
    {%- endif -%}
  {%- endfor -%}
</section>

<script type="application/json" id="PradaVariants-{{ section.id }}">{{ product.variants | json }}</script>
<script type="application/json" id="PradaVariantColors-{{ section.id }}">
  {
    {%- for variant in product.variants -%}
      {%- assign variant_color_label = variant.metafields.custom.variant_color.value -%}
      {%- if variant_color_label == blank -%}
        {%- assign variant_color_label = variant.metafields.custom.custom_variant_color.value -%}
      {%- endif -%}
      {{ variant.id | append: '' | json }}: {{ variant_color_label | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
</script>
<script>
  (() => {
    const root = document.getElementById('PradaProduct-{{ section.id }}');
    if (!root) return;

    const gallery = root.querySelector('.prada-product__gallery');
    const desktopWishlist = gallery?.querySelector(':scope > .prada-product__wishlist');
    const desktopDots = gallery?.querySelector('.prada-product__dots');
    const mediaList = gallery?.querySelector('.prada-product__media-list');
    const defaultGalleryTemplate = document.createElement('template');
    defaultGalleryTemplate.innerHTML = mediaList?.innerHTML || '';
    const variantGalleryTemplates = new Map(
      [...root.querySelectorAll('[data-prada-variant-gallery]')]
        .filter((template) => template.content.querySelector('.prada-product__media'))
        .map((template) => [template.dataset.pradaVariantGallery, template])
    );
    const getVariantPrimaryImage = (variant) => {
      const image = variantGalleryTemplates
        .get(String(variant?.id))
        ?.content.querySelector('.prada-product__gallery-image');
      return image?.getAttribute('src') || '';
    };
    const defaultPrimaryImage = defaultGalleryTemplate.content.querySelector('.prada-product__gallery-image');
    const defaultPrimarySource = defaultPrimaryImage?.currentSrc || defaultPrimaryImage?.src || '';
    let activeGalleryKey = 'default';
    let wishlistFrame;

    const syncDesktopWishlist = () => {
      window.cancelAnimationFrame(wishlistFrame);
      wishlistFrame = window.requestAnimationFrame(() => {
        const lastMedia = mediaList?.querySelector('.prada-product__media:last-child');
        if (!gallery || !desktopWishlist || !lastMedia || !window.matchMedia('(min-width: 990px)').matches) {
          desktopWishlist?.classList.remove('is-on-last-media');
          desktopDots?.classList.remove('is-gallery-ended');
          return;
        }

        const headerHeight = Number.parseFloat(
          getComputedStyle(document.documentElement).getPropertyValue('--header-height')
        ) || 72;
        const lastMediaRect = lastMedia.getBoundingClientRect();
        const releaseDepth = lastMedia.offsetHeight * 0.3;
        const releasePoint = lastMedia.offsetTop + releaseDepth;
        gallery.style.setProperty('--prada-wishlist-release-point', `${releasePoint}px`);
        desktopWishlist.classList.toggle(
          'is-on-last-media',
          lastMediaRect.top + releaseDepth <= headerHeight + 24
        );
        desktopDots?.classList.toggle('is-gallery-ended', gallery.getBoundingClientRect().bottom <= window.innerHeight);
      });
    };

    document.addEventListener('scroll', syncDesktopWishlist, { passive: true });
    window.addEventListener('resize', syncDesktopWishlist, { passive: true });
    syncDesktopWishlist();

    const variants = JSON.parse(document.getElementById('PradaVariants-{{ section.id }}').textContent);
    const variantColors = JSON.parse(document.getElementById('PradaVariantColors-{{ section.id }}').textContent);
    const productColorLabel = {{ product_color_label | json }};
    const selectors = [...root.querySelectorAll('[data-prada-option]')]
      .sort((a, b) => Number(a.dataset.pradaOption) - Number(b.dataset.pradaOption));
    const idInput = root.querySelector('[data-prada-variant-id]');
    const price = root.querySelector('[data-prada-price]');
    const status = root.querySelector('[data-prada-status]');
    const submit = root.querySelector('[data-prada-submit]');
    const submitText = root.querySelector('[data-prada-submit-text]');
    const fallbackColorValue = root.querySelector('[data-prada-fallback-color-value]');
    const fallbackColorSwatch = root.querySelector('.prada-product__option--fallback-color .prada-product__swatch');
    const moneyFormat = {{ shop.money_format | json }};

    const formatMoney = (cents) => {
      const amount = (cents / 100).toFixed(2);
      return moneyFormat.replace(/\{\{\s*amount(?:_with_comma_separator)?\s*\}\}/, amount).replace(/<[^>]*>/g, '');
    };

    let morphTimer;
    const morphImage = (source) => {
      const primaryImage = mediaList?.querySelector('.prada-product__media--image .prada-product__gallery-image');
      if (!primaryImage || !source || primaryImage.currentSrc === source || primaryImage.src === source) return;
      window.clearTimeout(morphTimer);
      primaryImage.classList.add('is-morphing');
      morphTimer = window.setTimeout(() => {
        primaryImage.removeAttribute('srcset');
        primaryImage.src = source;
        primaryImage.addEventListener('load', () => primaryImage.classList.remove('is-morphing'), { once: true });
      }, 180);
    };

    const updateVariant = ({ updateHistory = true } = {}) => {
      const selected = selectors.map((selector) => selector.value);
      const variant = variants.find((item) => item.options.every((value, index) => value === selected[index]));
      if (!variant) {
        submit.disabled = true;
        submitText.textContent = 'Unavailable';
        if (status) status.textContent = 'This combination is unavailable';
        return;
      }

      idInput.value = variant.id;
      price.innerHTML = `${variant.compare_at_price > variant.price ? `<s class="money">${formatMoney(variant.compare_at_price)}</s>` : ''}<span class="money">${formatMoney(variant.price)}</span>`;
      selectors.forEach((selector, index) => {
        const selectedValue = root.querySelector(`[data-prada-selected-value="${index}"]`);
        if (selectedValue) selectedValue.textContent = selector.value;
        root.querySelectorAll(`[data-prada-option-choice="${index}"]`).forEach((choice) => {
          const selected = choice.dataset.pradaOptionValue === selector.value;
          choice.classList.toggle('is-selected', selected);
          choice.setAttribute('aria-selected', selected ? 'true' : 'false');
          if (choice.classList.contains('prada-product__swatch')) choice.setAttribute('aria-pressed', selected ? 'true' : 'false');
        });
      });
      submit.disabled = !variant.available;
      submitText.textContent = variant.available ? 'Add to bag' : 'Available soon';
      if (status) status.textContent = variant.available ? 'Available online' : 'Soon available online';
      if (fallbackColorValue) {
        const variantColorLabel = variantColors[String(variant.id)] || productColorLabel;
        fallbackColorValue.textContent = variantColorLabel;
        fallbackColorSwatch?.setAttribute('aria-label', `Color ${variantColorLabel}`);
      }
      root.querySelectorAll('[data-prada-product-wishlist]').forEach((button) => {
        button.dataset.productVariantId = String(variant.id);
        button.dataset.productUrl = `${root.dataset.productUrl}?variant=${variant.id}`;
        button.dataset.productPrice = formatMoney(variant.price);
        button.dataset.productAvailable = String(variant.available);

        const variantImage = variant.featured_image?.src || variant.featured_media?.preview_image?.src;
        button.dataset.productImage = variantImage || root.dataset.wishlistFallbackImage || '';

        const variantImageAlt = variant.featured_image?.alt || variant.featured_media?.alt;
        button.dataset.productImageAlt =
          variantImageAlt || root.dataset.wishlistFallbackImageAlt || button.dataset.productTitle;
      });
      renderVariantGallery(variant);
      if (updateHistory) window.history.replaceState({}, '', `${root.dataset.productUrl}?variant=${variant.id}`);
    };

    selectors.forEach((selector) => selector.addEventListener('change', updateVariant));

    const drawerShell = root.querySelector('[data-prada-drawer]');
    const drawerTitle = root.querySelector('[data-prada-drawer-title]');
    const drawerPanes = [...root.querySelectorAll('[data-prada-drawer-pane]')];
    let drawerTrigger = null;

    const closeDrawer = () => {
      drawerShell.classList.remove('is-open');
      drawerShell.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('prada-drawer-open');
      window.setTimeout(() => drawerPanes.forEach((pane) => pane.hidden = true), 450);
      drawerTrigger?.focus({ preventScroll: true });
    };

    root.querySelectorAll('[data-prada-drawer-open]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        drawerTrigger = trigger;
        const paneName = trigger.dataset.pradaDrawerOpen;
        drawerPanes.forEach((pane) => pane.hidden = pane.dataset.pradaDrawerPane !== paneName);
        drawerTitle.textContent = trigger.dataset.pradaDrawerLabel || (paneName === 'details' ? 'Product details' : 'Free shipping and returns');
        drawerShell.setAttribute('aria-hidden', 'false');
        document.documentElement.classList.add('prada-drawer-open');
        requestAnimationFrame(() => {
          drawerShell.classList.add('is-open');
          root.querySelector('[data-prada-drawer-close]').focus({ preventScroll: true });
        });
      });
    });

    root.querySelectorAll('[data-prada-drawer-close]').forEach((button) => button.addEventListener('click', closeDrawer));
    root.querySelectorAll('[data-prada-option-choice]').forEach((choice) => {
      choice.addEventListener('click', () => {
        const selector = selectors[Number(choice.dataset.pradaOptionChoice)];
        selector.value = choice.dataset.pradaOptionValue;
        morphImage(choice.dataset.pradaImage);
        selector.dispatchEvent(new Event('change', { bubbles: true }));
        if (!choice.classList.contains('prada-product__swatch')) {
          closeDrawer();
          returnToVariantGallery();
        }
      });
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && drawerShell.classList.contains('is-open')) closeDrawer();
    });

    root.querySelectorAll('.prada-product__drawer-accordion').forEach((accordion) => {
      const summary = accordion.querySelector('summary');
      let animation = null;

      summary.addEventListener('click', (event) => {
        event.preventDefault();
        animation?.cancel();

        const startHeight = `${accordion.getBoundingClientRect().height}px`;
        if (accordion.open) {
          const endHeight = `${summary.getBoundingClientRect().height}px`;
          accordion.classList.add('is-closing');
          animation = accordion.animate(
            { height: [startHeight, endHeight] },
            { duration: 360, easing: 'cubic-bezier(.22, 1, .36, 1)' }
          );
          animation.onfinish = () => {
            accordion.open = false;
            accordion.classList.remove('is-closing');
            accordion.style.height = '';
            animation = null;
          };
        } else {
          accordion.open = true;
          accordion.classList.add('is-opening');
          const endHeight = `${accordion.scrollHeight}px`;
          animation = accordion.animate(
            { height: [startHeight, endHeight] },
            { duration: 420, easing: 'cubic-bezier(.22, 1, .36, 1)' }
          );
          animation.onfinish = () => {
            accordion.classList.remove('is-opening');
            accordion.style.height = '';
            animation = null;
          };
        }
      });
    });

    let galleryMedia = [];
    let galleryDots = [];
    let mediaObserver;

    const setActiveDot = (activeIndex) => {
      galleryDots.forEach((dot, index) => {
        const active = index === activeIndex;
        dot.classList.toggle('is-active', active);
        if (active) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };

    const refreshGalleryTracking = () => {
      mediaObserver?.disconnect();
      galleryMedia = [...(mediaList?.querySelectorAll('.prada-product__media') || [])];
      if (!desktopDots) return;

      desktopDots.replaceChildren();
      galleryMedia.forEach((media, index) => {
        const dot = document.createElement('a');
        dot.href = `#${media.id}`;
        dot.dataset.pradaDot = String(index);
        dot.setAttribute('aria-label', media.dataset.pradaMediaLabel || `View product image ${index + 1}`);
        dot.append(document.createElement('span'));
        dot.addEventListener('click', () => setActiveDot(index));
        desktopDots.append(dot);
      });

      galleryDots = [...desktopDots.querySelectorAll('[data-prada-dot]')];
      desktopDots.hidden = galleryDots.length <= 1;
      setActiveDot(0);
      if (galleryMedia.length <= 1) return;

      const visibility = new Map();
      mediaObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => visibility.set(entry.target, entry.intersectionRatio));
        let activeIndex = 0;
        let highestVisibility = -1;
        galleryMedia.forEach((media, index) => {
          const ratio = visibility.get(media) || 0;
          if (ratio > highestVisibility) {
            highestVisibility = ratio;
            activeIndex = index;
          }
        });
        setActiveDot(activeIndex);
      }, { threshold: [0, .15, .3, .5, .7, .9, 1] });

      galleryMedia.forEach((media) => mediaObserver.observe(media));
    };

    refreshGalleryTracking();

    const mobileQuery = window.matchMedia('(max-width: 989px)');
    const mobileGallery = root.querySelector('.prada-product__media-list');
    const mobilePanel = root.querySelector('.prada-product__panel');
    const scrollHint = root.querySelector('[data-prada-scroll-hint]');
    const sheetHandle = root.querySelector('[data-prada-sheet-handle]');
    let sheetTouchStart = 0;
    let panelTouchStartX = 0;
    let handleDragY = 0;
    let galleryTouchStart = 0;
    let galleryTouchStartedAtEnd = false;
    let handleIsDragging = false;
    let suppressHandleClick = false;
    let onboardingTimer;
    let scrollHintConsumed = false;

    const setupProductVideos = () => {
      mediaList?.querySelectorAll('.prada-product__media video').forEach((video) => {
        video.controls = false;
        video.muted = true;
        video.defaultMuted = true;
        video.volume = 0;
        video.setAttribute('muted', '');
        video.setAttribute('playsinline', '');
        video.play().catch(() => {});
        video.addEventListener('volumechange', () => {
          if (!video.muted || video.volume !== 0) {
            video.muted = true;
            video.volume = 0;
          }
        });
      });
    };

    const syncFallbackColorImage = (source) => {
      const fallbackImage = root.querySelector('.prada-product__option--fallback-color .prada-product__swatch img');
      if (!fallbackImage || !source || fallbackImage.currentSrc === source || fallbackImage.src === source) return;
      fallbackImage.removeAttribute('srcset');
      fallbackImage.src = source;
    };

    const renderVariantGallery = (variant) => {
      if (!mediaList) return;
      const variantTemplate = variantGalleryTemplates.get(String(variant.id));
      const nextGalleryKey = variantTemplate ? String(variant.id) : 'default';

      if (activeGalleryKey !== nextGalleryKey) {
        window.clearTimeout(onboardingTimer);
        root.classList.remove('mobile-gallery-onboarding');
        scrollHint?.classList.remove('is-visible');
        scrollHintConsumed = true;

        const sourceTemplate = variantTemplate || defaultGalleryTemplate;
        const galleryContent = sourceTemplate.content.cloneNode(true);
        const firstImage = galleryContent.querySelector('.prada-product__gallery-image');
        if (firstImage) {
          firstImage.loading = 'eager';
          firstImage.fetchPriority = 'high';
        }

        mediaList.replaceChildren(galleryContent);
        activeGalleryKey = nextGalleryKey;
        mobileGallery?.scrollTo({ top: 0, behavior: 'auto' });
        refreshGalleryTracking();
        setupProductVideos();
        syncDesktopWishlist();
      }

      if (variantTemplate) {
        const selectedImage = mediaList.querySelector('.prada-product__gallery-image');
        syncFallbackColorImage(selectedImage?.currentSrc || selectedImage?.src);
      } else {
        const variantImage = getVariantPrimaryImage(variant) || variant.featured_image?.src || variant.featured_media?.preview_image?.src;
        const fallbackSource = variantImage || defaultPrimarySource;
        morphImage(fallbackSource);
        syncFallbackColorImage(fallbackSource);
      }
    };

    const returnToVariantGallery = () => {
      if (!mobileQuery.matches) return;
      window.clearTimeout(onboardingTimer);
      root.classList.remove(
        'mobile-info-open',
        'mobile-info-closing',
        'mobile-info-dragging',
        'mobile-info-settling',
        'mobile-gallery-onboarding'
      );
      sheetHandle?.setAttribute('aria-expanded', 'false');
      sheetHandle?.setAttribute('aria-label', 'Open product information');
      mobileGallery?.scrollTo({ top: 0, behavior: 'auto' });
      scrollHint?.classList.remove('is-visible');

      window.requestAnimationFrame(() => {
        (root.closest('.shopify-section') || root).scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    };

    const playMobileOnboarding = () => {
      if (!mobileQuery.matches || !mobileGallery || galleryMedia.length < 2) return;
      window.clearTimeout(onboardingTimer);
      root.classList.add('mobile-gallery-onboarding');
      onboardingTimer = window.setTimeout(() => {
        root.classList.remove('mobile-gallery-onboarding');
        scrollHintConsumed = true;
      }, 3200);
    };

    const closeMobileSheet = () => {
      if (!root.classList.contains('mobile-info-open') || root.classList.contains('mobile-info-closing')) return;
      root.classList.add('mobile-info-closing');
      root.classList.remove('mobile-info-dragging', 'mobile-info-settling');
      sheetHandle?.setAttribute('aria-expanded', 'false');
      sheetHandle?.setAttribute('aria-label', 'Open product information');
      mobileGallery?.scrollTo({ top: mobileGallery.scrollHeight - mobileGallery.clientHeight, behavior: 'auto' });
      window.requestAnimationFrame(() => {
        (root.closest('.shopify-section') || root).scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      window.setTimeout(() => {
        root.classList.remove('mobile-info-open', 'mobile-info-closing');
      }, 420);
    };
    const openMobileSheet = () => {
      if (!mobileQuery.matches || root.classList.contains('mobile-info-open')) return;
      root.classList.remove('mobile-info-closing');
      root.classList.add('mobile-info-open');
      sheetHandle?.setAttribute('aria-expanded', 'true');
      sheetHandle?.setAttribute('aria-label', 'Close product information');
      window.requestAnimationFrame(() => mobilePanel?.scrollIntoView({ behavior: 'smooth', block: 'start' }));
    };
    const updateMobileGallery = () => {
      if (!mobileQuery.matches || !mobileGallery || galleryMedia.length < 2) return;
      const remaining = mobileGallery.scrollHeight - mobileGallery.scrollTop - mobileGallery.clientHeight;
      const atLastMedia = remaining <= 8;
      const hasStarted = mobileGallery.scrollTop > 10;
      if (hasStarted) {
        scrollHintConsumed = true;
        root.classList.remove('mobile-gallery-onboarding');
      }
      if (scrollHint) scrollHint.classList.toggle('is-visible', !scrollHintConsumed && hasStarted && !atLastMedia);
    };

    mobileGallery?.addEventListener('scroll', updateMobileGallery, { passive: true });
    mobileGallery?.addEventListener('touchstart', (event) => {
      window.clearTimeout(onboardingTimer);
      scrollHintConsumed = true;
      root.classList.remove('mobile-gallery-onboarding');
      scrollHint?.classList.remove('is-visible');
      galleryTouchStart = event.touches[0].clientY;
      const remaining = mobileGallery.scrollHeight - mobileGallery.scrollTop - mobileGallery.clientHeight;
      galleryTouchStartedAtEnd = remaining <= 8;
    }, { passive: true });
    mobileGallery?.addEventListener('touchend', (event) => {
      const upwardDistance = galleryTouchStart - event.changedTouches[0].clientY;
      if (galleryTouchStartedAtEnd && upwardDistance > 45) openMobileSheet();
      galleryTouchStartedAtEnd = false;
    }, { passive: true });
    sheetHandle?.addEventListener('click', () => {
      if (suppressHandleClick) {
        suppressHandleClick = false;
        return;
      }
      if (root.classList.contains('mobile-info-open')) closeMobileSheet();
      else openMobileSheet();
    });
    sheetHandle?.addEventListener('touchstart', (event) => {
      if (!root.classList.contains('mobile-info-open')) return;
      event.stopPropagation();
      handleIsDragging = true;
      suppressHandleClick = false;
      sheetTouchStart = event.touches[0].clientY;
      handleDragY = 0;
      root.classList.remove('mobile-info-settling');
      root.classList.add('mobile-info-dragging');
    }, { passive: true });
    sheetHandle?.addEventListener('touchmove', (event) => {
      if (!handleIsDragging) return;
      event.stopPropagation();
      handleDragY = Math.max(0, event.touches[0].clientY - sheetTouchStart);
      if (handleDragY > 5) suppressHandleClick = true;
    }, { passive: true });
    sheetHandle?.addEventListener('touchend', (event) => {
      if (!handleIsDragging) return;
      event.stopPropagation();
      handleIsDragging = false;
      handleDragY = Math.max(handleDragY, event.changedTouches[0].clientY - sheetTouchStart);
      if (handleDragY > 5) suppressHandleClick = true;
      if (handleDragY > 70) {
        closeMobileSheet();
      } else {
        root.classList.remove('mobile-info-dragging', 'mobile-info-settling');
        window.requestAnimationFrame(() => mobilePanel?.scrollIntoView({ behavior: 'smooth', block: 'start' }));
      }
      window.setTimeout(() => { suppressHandleClick = false; }, 500);
    }, { passive: true });
    sheetHandle?.addEventListener('touchcancel', () => {
      handleIsDragging = false;
      handleDragY = 0;
      suppressHandleClick = true;
      root.classList.remove('mobile-info-dragging', 'mobile-info-settling');
      window.setTimeout(() => { suppressHandleClick = false; }, 500);
    }, { passive: true });
    mobilePanel?.addEventListener('touchstart', (event) => {
      sheetTouchStart = event.touches[0].clientY;
      panelTouchStartX = event.touches[0].clientX;
    }, { passive: true });
    mobilePanel?.addEventListener('touchend', (event) => {
      const verticalDistance = sheetTouchStart - event.changedTouches[0].clientY;
      const horizontalDistance = Math.abs(panelTouchStartX - event.changedTouches[0].clientX);
      const isVerticalGesture = Math.abs(verticalDistance) > horizontalDistance;
      if (root.classList.contains('mobile-info-open') && isVerticalGesture && verticalDistance < -70) {
        closeMobileSheet();
      } else if (!root.classList.contains('mobile-info-open') && isVerticalGesture && verticalDistance > 45) {
        openMobileSheet();
      }
    }, { passive: true });
    mobileQuery.addEventListener?.('change', () => {
      if (!mobileQuery.matches) root.classList.remove('mobile-info-open', 'mobile-info-closing');
      else updateMobileGallery();
    });

    if (document.readyState === 'complete') {
      window.setTimeout(playMobileOnboarding, 650);
    } else {
      window.addEventListener('load', () => window.setTimeout(playMobileOnboarding, 650), { once: true });
    }

    setupProductVideos();
    updateVariant({ updateHistory: false });
  })();
</script>

{% schema %}
{
  "name": "Prada product",
  "tag": "section",
  "class": "section-prada-product",
  "settings": [
    {
      "type": "image_picker",
      "id": "size_chart_image",
      "label": "Size chart image"
    }
  ],
  "blocks": [
    {
      "type": "color_swatch",
      "name": "Color swatch",
      "settings": [
        {
          "type": "text",
          "id": "variant_value",
          "label": "Variant color value",
          "info": "Enter the exact product option value, for example Black or Desert Beige."
        },
        {
          "type": "color",
          "id": "swatch_color",
          "label": "Swatch color",
          "default": "#000000"
        }
      ]
    }
  ],
  "presets": [{ "name": "Prada product" }]
}
{% endschema %}
