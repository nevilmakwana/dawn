<section class="prada-category-showcase color-{{ section.settings.color_scheme }} gradient">
  <div class="prada-category-showcase__intro">
    {%- if section.settings.heading != blank -%}
      <h2 class="prada-category-showcase__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="prada-category-showcase__text rte">
        {{ section.settings.text }}
      </div>
    {%- endif -%}

    <div class="prada-category-showcase__tabs" role="tablist" aria-label="Category tabs">
      {%- if section.settings.women_label != blank -%}
        <button
          type="button"
          role="tab"
          aria-selected="{% if section.settings.active_tab == 'women' %}true{% else %}false{% endif %}"
          aria-controls="PradaCategoryGrid-{{ section.id }}"
          data-prada-category-tab="women"
          class="prada-category-showcase__tab{% if section.settings.active_tab == 'women' %} is-active{% endif %}"
        >
          {{ section.settings.women_label }}
        </button>
      {%- endif -%}

      {%- if section.settings.men_label != blank -%}
        <button
          type="button"
          role="tab"
          aria-selected="{% if section.settings.active_tab == 'men' %}true{% else %}false{% endif %}"
          aria-controls="PradaCategoryGrid-{{ section.id }}"
          data-prada-category-tab="men"
          class="prada-category-showcase__tab{% if section.settings.active_tab == 'men' %} is-active{% endif %}"
        >
          {{ section.settings.men_label }}
        </button>
      {%- endif -%}
    </div>
  </div>

  <div id="PradaCategoryGrid-{{ section.id }}" class="prada-category-showcase__viewport prada-category-showcase__grid" role="tabpanel" data-prada-category-viewport data-active="{{ section.settings.active_tab }}">
    {%- for block in section.blocks -%}
      <div class="prada-category-showcase__slot" style="--tile-index: {{ forloop.index0 }};">
        {%- liquid
          assign fallback_product = collections.all.products[forloop.index0]
          assign women_title = block.settings.women_title | default: fallback_product.title | default: block.settings.title
          assign women_image = block.settings.women_image
          assign women_url = blank

          if women_image == blank and block.settings.women_product != blank
            assign women_image = block.settings.women_product.featured_media.preview_image
          endif
          if women_image == blank and block.settings.women_collection != blank
            assign women_image = block.settings.women_collection.image | default: block.settings.women_collection.products.first.featured_media.preview_image
          endif
          if women_image == blank and fallback_product != blank
            assign women_image = fallback_product.featured_media.preview_image
          endif
          if women_image == blank
            assign women_image_product = block.settings.women_product
            if women_image_product == blank and block.settings.women_collection != blank
              assign women_image_product = block.settings.women_collection.products.first
            endif
            if women_image_product == blank
              assign women_image_product = fallback_product
            endif
            assign women_variant_gallery = women_image_product.selected_or_first_available_variant.metafields.custom.variant_images.value
            if women_variant_gallery == blank
              assign women_variant_gallery = women_image_product.selected_or_first_available_variant.metafields.custom.custom_variant_images.value
            endif
            for variant_media in women_variant_gallery
              if variant_media.media_type == 'image'
                assign women_image = variant_media.preview_image
                break
              endif
            endfor
          endif

          if block.settings.women_collection != blank
            assign women_url = block.settings.women_collection.url
          elsif block.settings.women_link != blank
            assign women_url = block.settings.women_link
          elsif block.settings.women_product != blank
            assign women_url = block.settings.women_product.url
          elsif fallback_product != blank
            assign women_url = fallback_product.url
          else
            assign women_url = section.settings.women_link | default: routes.all_products_collection_url
          endif

          assign men_title = block.settings.title | default: fallback_product.title
          assign men_image = block.settings.image
          assign men_url = blank

          if men_image == blank and block.settings.product != blank
            assign men_image = block.settings.product.featured_media.preview_image
          endif
          if men_image == blank and block.settings.collection != blank
            assign men_image = block.settings.collection.image | default: block.settings.collection.products.first.featured_media.preview_image
          endif
          if men_image == blank and fallback_product != blank
            assign men_image = fallback_product.featured_media.preview_image
          endif
          if men_image == blank
            assign men_image_product = block.settings.product
            if men_image_product == blank and block.settings.collection != blank
              assign men_image_product = block.settings.collection.products.first
            endif
            if men_image_product == blank
              assign men_image_product = fallback_product
            endif
            assign men_variant_gallery = men_image_product.selected_or_first_available_variant.metafields.custom.variant_images.value
            if men_variant_gallery == blank
              assign men_variant_gallery = men_image_product.selected_or_first_available_variant.metafields.custom.custom_variant_images.value
            endif
            for variant_media in men_variant_gallery
              if variant_media.media_type == 'image'
                assign men_image = variant_media.preview_image
                break
              endif
            endfor
          endif

          if block.settings.collection != blank
            assign men_url = block.settings.collection.url
          elsif block.settings.link != blank
            assign men_url = block.settings.link
          elsif block.settings.product != blank
            assign men_url = block.settings.product.url
          elsif fallback_product != blank
            assign men_url = fallback_product.url
          else
            assign men_url = section.settings.men_link | default: routes.all_products_collection_url
          endif
        -%}
        {%- render 'prada-category-tile', tile_image: women_image, tile_url: women_url, tile_title: women_title, tile_gender: 'women', active_tab: section.settings.active_tab -%}
        {%- render 'prada-category-tile', tile_image: men_image, tile_url: men_url, tile_title: men_title, tile_gender: 'men', active_tab: section.settings.active_tab, block: block -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    background: rgb(var(--color-background));
  }

  #shopify-section-{{ section.id }} .prada-category-showcase {
    width: 100%;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__intro {
    min-height: {{ section.settings.intro_height }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px 20px 46px;
    text-align: center;
    background: rgb(var(--color-background));
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__heading {
    margin: 0 0 14px;
    color: rgb(var(--color-foreground));
    font-family: inherit;
    font-size: 24px;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__text {
    max-width: 680px;
    color: rgb(var(--color-foreground));
    font-size: 14px;
    line-height: 1.28;
    font-weight: 600;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__tabs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-top: 26px;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__tab {
    appearance: none;
    margin: 0;
    border: 0;
    border-bottom: 1px solid transparent;
    background: transparent;
    color: rgb(var(--color-foreground));
    font-family: inherit;
    font-size: 14px;
    line-height: 1;
    font-weight: 600;
    cursor: pointer;
    padding-bottom: 10px;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__tab.is-active {
    border-bottom-color: currentColor;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__viewport {
    overflow: hidden;
    background: #ffffff;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    background: #ffffff;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__slot {
    display: grid;
    min-width: 0;
    overflow: hidden;
    background: #ffffff;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__item {
    grid-area: 1 / 1;
    display: grid;
    grid-template-rows: auto 74px;
    min-width: 0;
    color: #000000;
    text-decoration: none;
    background: #ffffff;
    will-change: transform;
    backface-visibility: hidden;
    transform: translate3d(100%, 0, 0);
    pointer-events: none;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__item.is-active,
  #shopify-section-{{ section.id }} .prada-category-showcase__item.is-entering {
    z-index: 2;
    transform: translate3d(0, 0, 0);
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__item.is-leaving {
    z-index: 2;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} [data-direction='forward'] .prada-category-showcase__item.is-leaving {
    animation: prada-category-out-left-{{ section.id }} 300ms ease both;
  }

  #shopify-section-{{ section.id }} [data-direction='forward'] .prada-category-showcase__item.is-entering {
    animation: prada-category-in-right-{{ section.id }} 300ms ease both;
  }

  #shopify-section-{{ section.id }} [data-direction='backward'] .prada-category-showcase__item.is-leaving {
    animation: prada-category-out-right-{{ section.id }} 300ms ease both;
  }

  #shopify-section-{{ section.id }} [data-direction='backward'] .prada-category-showcase__item.is-entering {
    animation: prada-category-in-left-{{ section.id }} 300ms ease both;
  }

  @keyframes prada-category-out-left-{{ section.id }} {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-100%, 0, 0); }
  }

  @keyframes prada-category-in-right-{{ section.id }} {
    from { transform: translate3d(100%, 0, 0); }
    to { transform: translate3d(0, 0, 0); }
  }

  @keyframes prada-category-out-right-{{ section.id }} {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(100%, 0, 0); }
  }

  @keyframes prada-category-in-left-{{ section.id }} {
    from { transform: translate3d(-100%, 0, 0); }
    to { transform: translate3d(0, 0, 0); }
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__media {
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    background: {{ section.settings.tile_background }};
    border-right: 1px solid #ffffff;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__slot:last-child .prada-category-showcase__media {
    border-right: 0;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__placeholder {
    width: 70%;
    height: 70%;
    opacity: 0.45;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__item:hover .prada-category-showcase__image {
    transform: scale(1.025);
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__label {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px 12px;
    color: #000000;
    background: #ffffff;
    text-align: center;
    font-size: 14px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: 0;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .prada-category-showcase__intro {
      min-height: auto;
      padding: 42px 24px 38px;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__text {
      max-width: 520px;
      font-size: 13px;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__heading {
      font-size: 20px;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1px;
      background: #ffffff;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__item {
      grid-template-rows: auto 58px;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__media {
      border-right: 0;
      border-bottom: 0;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__image {
      width: 100%;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__label {
      min-height: 58px;
      padding: 14px 8px;
      font-size: 13px;
    }
  }

  @media screen and (max-width: 520px) {
    #shopify-section-{{ section.id }} .prada-category-showcase__intro {
      padding: 36px 22px 32px;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__tabs {
      margin-top: 22px;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__item { grid-template-rows: auto 56px; }

    #shopify-section-{{ section.id }} .prada-category-showcase__label {
      min-height: 56px;
      padding: 13px 6px;
    }
  }

{% endstyle %}

<script>
  (() => {
    const root = document.querySelector('#shopify-section-{{ section.id }} .prada-category-showcase');
    if (!root || root.dataset.tabsReady === 'true') return;
    root.dataset.tabsReady = 'true';
    const viewport = root.querySelector('[data-prada-category-viewport]');
    const tabs = [...root.querySelectorAll('[data-prada-category-tab]')];
    const tiles = [...root.querySelectorAll('[data-prada-category-tile]')];
    let transitionTimer;

    tabs.forEach((tab) => tab.addEventListener('click', () => {
      const next = tab.dataset.pradaCategoryTab;
      if (!viewport || viewport.dataset.active === next) return;
      const current = viewport.dataset.active;
      const outgoing = tiles.filter((tile) => tile.dataset.pradaCategoryTile === current);
      const incoming = tiles.filter((tile) => tile.dataset.pradaCategoryTile === next);

      clearTimeout(transitionTimer);
      tiles.forEach((tile) => tile.classList.remove('is-entering', 'is-leaving'));
      viewport.offsetWidth;

      viewport.dataset.direction = current === 'women' && next === 'men' ? 'forward' : 'backward';
      viewport.dataset.active = next;
      tabs.forEach((item) => {
        const active = item === tab;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-selected', String(active));
      });
      outgoing.forEach((tile) => {
        tile.classList.remove('is-active');
        tile.classList.add('is-leaving');
      });
      incoming.forEach((tile) => {
        tile.classList.add('is-entering');
      });
      tiles.forEach((tile) => {
        const active = tile.dataset.pradaCategoryTile === next;
        tile.setAttribute('aria-hidden', String(!active));
        tile.toggleAttribute('inert', !active);
        if (active) tile.removeAttribute('tabindex');
        else tile.setAttribute('tabindex', '-1');
      });

      transitionTimer = window.setTimeout(() => {
        outgoing.forEach((tile) => tile.classList.remove('is-leaving'));
        incoming.forEach((tile) => {
          tile.classList.remove('is-entering');
          tile.classList.add('is-active');
        });
      }, 340);
    }));
  })();
</script>

{% schema %}
{
  "name": "Prada category showcase",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
