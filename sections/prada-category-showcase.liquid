{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-related-products.css' | asset_url | stylesheet_tag }}
{{ 'prada-collection.css' | asset_url | stylesheet_tag }}
{{ 'greyexim-prada-mobile-flow.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign showcase_mode = section.settings.content_mode | default: 'categories'
  assign heading_handle = section.settings.heading | handleize
  if showcase_mode == 'categories' and heading_handle == 'best-sellers'
    assign showcase_mode = 'best_sellers'
  endif

  assign is_best_sellers = false
  if showcase_mode == 'best_sellers'
    assign is_best_sellers = true
  endif
-%}

<section
  id="PradaCategoryShowcase-{{ section.id }}"
  class="prada-category-showcase{% if is_best_sellers %} prada-best-sellers{% endif %} color-{{ section.settings.color_scheme }} gradient"
  data-showcase-mode="{{ showcase_mode }}"
  data-section-id="{{ section.id }}"
>
  <div class="prada-category-showcase__intro{% if is_best_sellers %} prada-best-sellers__intro{% endif %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="prada-category-showcase__heading{% if is_best_sellers %} prada-best-sellers__heading{% endif %}">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="prada-category-showcase__text{% if is_best_sellers %} prada-best-sellers__text{% endif %} rte">
        {{ section.settings.text }}
      </div>
    {%- endif -%}

    {%- unless is_best_sellers -%}
      <div class="prada-category-showcase__tabs" role="tablist" aria-label="Category tabs">
      {%- if section.settings.women_label != blank -%}
        <button
          type="button"
          role="tab"
          aria-selected="{% if section.settings.active_tab == 'women' %}true{% else %}false{% endif %}"
          aria-controls="PradaCategoryGrid-{{ section.id }}"
          data-prada-category-tab="women"
          class="prada-category-showcase__tab{% if section.settings.active_tab == 'women' %} is-active{% endif %}"
        >
          {{ section.settings.women_label }}
        </button>
      {%- endif -%}

      {%- if section.settings.men_label != blank -%}
        <button
          type="button"
          role="tab"
          aria-selected="{% if section.settings.active_tab == 'men' %}true{% else %}false{% endif %}"
          aria-controls="PradaCategoryGrid-{{ section.id }}"
          data-prada-category-tab="men"
          class="prada-category-showcase__tab{% if section.settings.active_tab == 'men' %} is-active{% endif %}"
        >
          {{ section.settings.men_label }}
        </button>
      {%- endif -%}
      </div>
    {%- endunless -%}
  </div>

  {%- if is_best_sellers -%}
    {%- liquid
      assign products_to_show = section.settings.products_to_show | default: 8
      assign rendered_count = 0
      assign fallback_collection = section.settings.collection

      if fallback_collection == blank or fallback_collection.products_count == 0
        assign configured_best_sellers = collections['best-sellers']
        if configured_best_sellers != blank and configured_best_sellers.products_count > 0
          assign fallback_collection = configured_best_sellers
        else
          assign fallback_collection = collections.all
        endif
      endif
    -%}

    <div class="prada-best-sellers__viewport">
      <ul
        class="grid product-grid prada-best-sellers__track"
        role="list"
        data-prada-related-list
      >
        {%- for product in fallback_collection.products limit: products_to_show -%}
          {%- unless product.available -%}{% continue %}{%- endunless -%}
          {%- assign rendered_position = rendered_count | plus: 1 -%}
          {%- render 'prada-related-product', related_product: product, forloop_index: rendered_position -%}
          {%- assign rendered_count = rendered_count | plus: 1 -%}
        {%- endfor -%}
      </ul>

      {%- if rendered_count > 4 -%}
        <div class="prada-related-arrows" data-prada-related-arrows>
          <button
            type="button"
            class="prada-related-arrow prada-related-arrow--prev"
            data-prada-related-prev
            aria-label="Previous best sellers"
            disabled
          >
            &#8249;
          </button>
          <button
            type="button"
            class="prada-related-arrow prada-related-arrow--next"
            data-prada-related-next
            aria-label="Next best sellers"
          >
            &#8250;
          </button>
        </div>
      {%- endif -%}
    </div>

    {%- assign page_count = rendered_count | plus: 1 | divided_by: 2 -%}
    {%- if page_count > 1 -%}
      <div class="prada-related-pagination" data-prada-related-pagination aria-label="Best sellers pages">
        {%- for page_number in (1..page_count) -%}
          <button
            type="button"
            class="prada-related-page-dot{% if forloop.first %} is-active{% endif %}"
            data-prada-related-page="{{ forloop.index0 }}"
            aria-label="Show best sellers page {{ page_number }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- else -%}
    <div id="PradaCategoryGrid-{{ section.id }}" class="prada-category-showcase__viewport prada-category-showcase__grid" role="tabpanel" data-prada-category-viewport data-active="{{ section.settings.active_tab }}">
    {%- for block in section.blocks -%}
      <div class="prada-category-showcase__slot" style="--tile-index: {{ forloop.index0 }};">
        {%- liquid
          assign fallback_product = collections.all.products[forloop.index0]
          assign women_title = block.settings.women_title | default: fallback_product.title | default: block.settings.title
          assign women_image = block.settings.women_image
          assign women_url = blank

          if women_image == blank and block.settings.women_product != blank
            assign women_image = block.settings.women_product.featured_media.preview_image
          endif
          if women_image == blank and block.settings.women_collection != blank
            assign women_image = block.settings.women_collection.image | default: block.settings.women_collection.products.first.featured_media.preview_image
          endif
          if women_image == blank and fallback_product != blank
            assign women_image = fallback_product.featured_media.preview_image
          endif
          if women_image == blank
            assign women_image_product = block.settings.women_product
            if women_image_product == blank and block.settings.women_collection != blank
              assign women_image_product = block.settings.women_collection.products.first
            endif
            if women_image_product == blank
              assign women_image_product = fallback_product
            endif
            assign women_variant_gallery = women_image_product.selected_or_first_available_variant.metafields.custom.variant_images.value
            if women_variant_gallery == blank
              assign women_variant_gallery = women_image_product.selected_or_first_available_variant.metafields.custom.custom_variant_images.value
            endif
            for variant_media in women_variant_gallery
              if variant_media.media_type == 'image'
                assign women_image = variant_media.preview_image
                break
              endif
            endfor
          endif

          if block.settings.women_collection != blank
            assign women_url = block.settings.women_collection.url
          elsif block.settings.women_link != blank
            assign women_url = block.settings.women_link
          elsif block.settings.women_product != blank
            assign women_url = block.settings.women_product.url
          elsif fallback_product != blank
            assign women_url = fallback_product.url
          else
            assign women_url = section.settings.women_link | default: routes.all_products_collection_url
          endif

          assign men_title = block.settings.title | default: fallback_product.title
          assign men_image = block.settings.image
          assign men_url = blank

          if men_image == blank and block.settings.product != blank
            assign men_image = block.settings.product.featured_media.preview_image
          endif
          if men_image == blank and block.settings.collection != blank
            assign men_image = block.settings.collection.image | default: block.settings.collection.products.first.featured_media.preview_image
          endif
          if men_image == blank and fallback_product != blank
            assign men_image = fallback_product.featured_media.preview_image
          endif
          if men_image == blank
            assign men_image_product = block.settings.product
            if men_image_product == blank and block.settings.collection != blank
              assign men_image_product = block.settings.collection.products.first
            endif
            if men_image_product == blank
              assign men_image_product = fallback_product
            endif
            assign men_variant_gallery = men_image_product.selected_or_first_available_variant.metafields.custom.variant_images.value
            if men_variant_gallery == blank
              assign men_variant_gallery = men_image_product.selected_or_first_available_variant.metafields.custom.custom_variant_images.value
            endif
            for variant_media in men_variant_gallery
              if variant_media.media_type == 'image'
                assign men_image = variant_media.preview_image
                break
              endif
            endfor
          endif

          if block.settings.collection != blank
            assign men_url = block.settings.collection.url
          elsif block.settings.link != blank
            assign men_url = block.settings.link
          elsif block.settings.product != blank
            assign men_url = block.settings.product.url
          elsif fallback_product != blank
            assign men_url = fallback_product.url
          else
            assign men_url = section.settings.men_link | default: routes.all_products_collection_url
          endif
        -%}
        {%- render 'prada-category-tile', tile_image: women_image, tile_url: women_url, tile_title: women_title, tile_gender: 'women', active_tab: section.settings.active_tab -%}
        {%- render 'prada-category-tile', tile_image: men_image, tile_url: men_url, tile_title: men_title, tile_gender: 'men', active_tab: section.settings.active_tab, block: block -%}
      </div>
    {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    background: rgb(var(--color-background));
  }

  #shopify-section-{{ section.id }} .prada-category-showcase {
    width: 100%;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__intro {
    min-height: {{ section.settings.intro_height }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px 20px 46px;
    text-align: center;
    background: rgb(var(--color-background));
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__heading {
    margin: 0 0 14px;
    color: rgb(var(--color-foreground));
    font-family: inherit;
    font-size: 24px;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__text {
    max-width: 680px;
    color: rgb(var(--color-foreground));
    font-size: 14px;
    line-height: 1.28;
    font-weight: 600;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__tabs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-top: 26px;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__tab {
    appearance: none;
    margin: 0;
    border: 0;
    border-bottom: 1px solid transparent;
    background: transparent;
    color: rgb(var(--color-foreground));
    font-family: inherit;
    font-size: 14px;
    line-height: 1;
    font-weight: 600;
    cursor: pointer;
    padding-bottom: 10px;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__tab.is-active {
    border-bottom-color: currentColor;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__viewport {
    overflow: hidden;
    background: #ffffff;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    background: #ffffff;
  }

  #shopify-section-{{ section.id }} .prada-best-sellers__carousel {
    position: relative;
    background: #ffffff;
  }

  #shopify-section-{{ section.id }} [data-showcase-mode='best_sellers'] .prada-category-showcase__grid {
    display: flex;
    grid-template-columns: none;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  #shopify-section-{{ section.id }} [data-showcase-mode='best_sellers'] .prada-category-showcase__grid::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} [data-showcase-mode='best_sellers'] .prada-category-showcase__slot {
    flex: 0 0 25%;
    scroll-snap-align: start;
  }

  #shopify-section-{{ section.id }} .prada-best-sellers__controls[hidden] {
    display: none;
  }

  #shopify-section-{{ section.id }} .prada-best-sellers__button {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: grid;
    width: 48px;
    height: 88px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #000000;
    place-items: center;
    cursor: pointer;
    transform: translateY(-50%);
    transition: opacity 160ms ease;
  }

  #shopify-section-{{ section.id }} .prada-best-sellers__button--prev {
    left: 0;
  }

  #shopify-section-{{ section.id }} .prada-best-sellers__button--next {
    right: 0;
  }

  #shopify-section-{{ section.id }} .prada-best-sellers__button .icon-caret {
    width: 14px;
    height: 9px;
  }

  #shopify-section-{{ section.id }} .prada-best-sellers__button--prev .icon-caret {
    transform: rotate(90deg);
  }

  #shopify-section-{{ section.id }} .prada-best-sellers__button--next .icon-caret {
    transform: rotate(-90deg);
  }

  #shopify-section-{{ section.id }} .prada-best-sellers__button:disabled {
    opacity: 0.24;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .prada-best-sellers__button:focus-visible {
    outline: 2px solid #000000;
    outline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__slot {
    display: grid;
    min-width: 0;
    overflow: hidden;
    background: #ffffff;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__empty {
    grid-column: 1 / -1;
    margin: 0;
    padding: 48px 24px;
    color: #000000;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__item {
    grid-area: 1 / 1;
    display: grid;
    grid-template-rows: auto 74px;
    min-width: 0;
    color: #000000;
    text-decoration: none;
    background: #ffffff;
    will-change: transform;
    backface-visibility: hidden;
    transform: translate3d(100%, 0, 0);
    pointer-events: none;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__item.is-active,
  #shopify-section-{{ section.id }} .prada-category-showcase__item.is-entering {
    z-index: 2;
    transform: translate3d(0, 0, 0);
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__item.is-leaving {
    z-index: 2;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} [data-direction='forward'] .prada-category-showcase__item.is-leaving {
    animation: prada-category-out-left-{{ section.id }} 300ms ease both;
  }

  #shopify-section-{{ section.id }} [data-direction='forward'] .prada-category-showcase__item.is-entering {
    animation: prada-category-in-right-{{ section.id }} 300ms ease both;
  }

  #shopify-section-{{ section.id }} [data-direction='backward'] .prada-category-showcase__item.is-leaving {
    animation: prada-category-out-right-{{ section.id }} 300ms ease both;
  }

  #shopify-section-{{ section.id }} [data-direction='backward'] .prada-category-showcase__item.is-entering {
    animation: prada-category-in-left-{{ section.id }} 300ms ease both;
  }

  @keyframes prada-category-out-left-{{ section.id }} {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-100%, 0, 0); }
  }

  @keyframes prada-category-in-right-{{ section.id }} {
    from { transform: translate3d(100%, 0, 0); }
    to { transform: translate3d(0, 0, 0); }
  }

  @keyframes prada-category-out-right-{{ section.id }} {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(100%, 0, 0); }
  }

  @keyframes prada-category-in-left-{{ section.id }} {
    from { transform: translate3d(-100%, 0, 0); }
    to { transform: translate3d(0, 0, 0); }
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__media {
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    background: {{ section.settings.tile_background }};
    border-right: 1px solid #ffffff;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__slot:last-child .prada-category-showcase__media {
    border-right: 0;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__placeholder {
    width: 70%;
    height: 70%;
    opacity: 0.45;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__item:hover .prada-category-showcase__image {
    transform: scale(1.025);
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__label {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px 12px;
    color: #000000;
    background: #ffffff;
    text-align: center;
    font-size: 14px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: 0;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .prada-category-showcase__intro {
      min-height: auto;
      padding: 42px 24px 38px;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__text {
      max-width: 520px;
      font-size: 13px;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__heading {
      font-size: 20px;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1px;
      background: #ffffff;
    }

    #shopify-section-{{ section.id }} [data-showcase-mode='best_sellers'] .prada-category-showcase__slot {
      flex-basis: 50%;
    }

    #shopify-section-{{ section.id }} .prada-best-sellers__button {
      width: 40px;
      height: 72px;
    }

    #shopify-section-{{ section.id }} .prada-best-sellers__button--prev {
      left: 0;
    }

    #shopify-section-{{ section.id }} .prada-best-sellers__button--next {
      right: 0;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__item {
      grid-template-rows: auto 58px;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__media {
      border-right: 0;
      border-bottom: 0;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__image {
      width: 100%;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__label {
      min-height: 58px;
      padding: 14px 8px;
      font-size: 13px;
    }
  }

  @media screen and (max-width: 520px) {
    #shopify-section-{{ section.id }} .prada-category-showcase__intro {
      padding: 36px 22px 32px;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__tabs {
      margin-top: 22px;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__item { grid-template-rows: auto 56px; }

    #shopify-section-{{ section.id }} .prada-category-showcase__label {
      min-height: 56px;
      padding: 13px 6px;
    }
  }

{% endstyle %}

{%- if is_best_sellers -%}
<script>
  (() => {
    const section = document.getElementById('PradaCategoryShowcase-{{ section.id }}');
    if (!section || section.dataset.pradaBestSellersReady === 'true') return;
    section.dataset.pradaBestSellersReady = 'true';

    const list = section.querySelector('[data-prada-related-list]');
    const prevButton = section.querySelector('[data-prada-related-prev]');
    const nextButton = section.querySelector('[data-prada-related-next]');
    const pageDots = Array.from(section.querySelectorAll('[data-prada-related-page]'));
    if (!list) return;

    const initialiseCardCarousels = () => {
      section.querySelectorAll('[data-prada-mobile-carousel]').forEach((carousel) => {
        if (carousel.dataset.carouselReady === 'true') return;
        carousel.dataset.carouselReady = 'true';

        const dotButtons = Array.from(carousel.querySelectorAll('[data-prada-carousel-dot]'));
        const mediaLink = carousel.querySelector('.prada-related-card__media-link');
        if (!mediaLink) return;

        const updateDots = () => {
          if (!dotButtons.length) return;
          const maxScroll = Math.max(mediaLink.scrollWidth - mediaLink.clientWidth, 0);
          const activeIndex = maxScroll > 1 && mediaLink.scrollLeft > maxScroll / 2 ? 1 : 0;
          dotButtons.forEach((dot, index) => {
            dot.classList.toggle('is-active', index === activeIndex);
            dot.setAttribute('aria-current', index === activeIndex ? 'true' : 'false');
          });
        };

        dotButtons.forEach((dot) => {
          dot.addEventListener('click', (event) => {
            event.preventDefault();
            event.stopPropagation();
            const targetIndex = Number(dot.dataset.pradaCarouselDot || 0);
            mediaLink.scrollTo({ left: mediaLink.clientWidth * targetIndex, behavior: 'smooth' });
          });
        });

        mediaLink.addEventListener('scroll', () => window.requestAnimationFrame(updateDots), { passive: true });
        updateDots();
      });
    };

    const updateControls = () => {
      const maxScroll = Math.max(list.scrollWidth - list.clientWidth, 0);
      const currentPage = list.clientWidth > 0 ? Math.round(list.scrollLeft / list.clientWidth) : 0;

      if (prevButton) prevButton.disabled = list.scrollLeft <= 2;
      if (nextButton) nextButton.disabled = list.scrollLeft >= maxScroll - 2;

      pageDots.forEach((dot, index) => {
        dot.classList.toggle('is-active', index === currentPage);
        dot.setAttribute('aria-current', index === currentPage ? 'true' : 'false');
      });
    };

    const scrollToPage = (pageIndex) => {
      list.scrollTo({ left: list.clientWidth * pageIndex, behavior: 'smooth' });
    };

    const scrollByItem = (direction) => {
      const firstItem = list.querySelector(':scope > .grid__item');
      const listStyles = window.getComputedStyle(list);
      const itemGap = Number.parseFloat(listStyles.columnGap || listStyles.gap) || 0;
      const itemStep = firstItem ? firstItem.getBoundingClientRect().width + itemGap : list.clientWidth;
      list.scrollBy({ left: direction * itemStep, behavior: 'smooth' });
    };

    prevButton?.addEventListener('click', () => scrollByItem(-1));
    nextButton?.addEventListener('click', () => scrollByItem(1));
    pageDots.forEach((dot) => dot.addEventListener('click', () => scrollToPage(Number(dot.dataset.pradaRelatedPage || 0))));

    list.addEventListener('scroll', () => window.requestAnimationFrame(updateControls), { passive: true });
    window.addEventListener('resize', updateControls, { passive: true });
    initialiseCardCarousels();
    updateControls();
  })();
</script>
{%- else -%}
<script>
  (() => {
    const root = document.querySelector('#shopify-section-{{ section.id }} .prada-category-showcase');
    if (!root || root.dataset.tabsReady === 'true') return;
    root.dataset.tabsReady = 'true';
    const viewport = root.querySelector('[data-prada-category-viewport]');
    const tabs = [...root.querySelectorAll('[data-prada-category-tab]')];
    const tiles = [...root.querySelectorAll('[data-prada-category-tile]')];
    let transitionTimer;

    tabs.forEach((tab) => tab.addEventListener('click', () => {
      const next = tab.dataset.pradaCategoryTab;
      if (!viewport || viewport.dataset.active === next) return;
      const current = viewport.dataset.active;
      const outgoing = tiles.filter((tile) => tile.dataset.pradaCategoryTile === current);
      const incoming = tiles.filter((tile) => tile.dataset.pradaCategoryTile === next);

      clearTimeout(transitionTimer);
      tiles.forEach((tile) => tile.classList.remove('is-entering', 'is-leaving'));
      viewport.offsetWidth;

      viewport.dataset.direction = current === 'women' && next === 'men' ? 'forward' : 'backward';
      viewport.dataset.active = next;
      tabs.forEach((item) => {
        const active = item === tab;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-selected', String(active));
      });
      outgoing.forEach((tile) => {
        tile.classList.remove('is-active');
        tile.classList.add('is-leaving');
      });
      incoming.forEach((tile) => {
        tile.classList.add('is-entering');
      });
      tiles.forEach((tile) => {
        const active = tile.dataset.pradaCategoryTile === next;
        tile.setAttribute('aria-hidden', String(!active));
        tile.toggleAttribute('inert', !active);
        if (active) tile.removeAttribute('tabindex');
        else tile.setAttribute('tabindex', '-1');
      });

      transitionTimer = window.setTimeout(() => {
        outgoing.forEach((tile) => tile.classList.remove('is-leaving'));
        incoming.forEach((tile) => {
          tile.classList.remove('is-entering');
          tile.classList.add('is-active');
        });
      }, 340);
    }));
  })();
</script>
{%- endif -%}

