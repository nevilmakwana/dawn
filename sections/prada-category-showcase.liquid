  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Men's Bags"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Fallback product"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Fallback collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Women tile"
        },
        {
          "type": "text",
          "id": "women_title",
          "label": "Women title"
        },
        {
          "type": "image_picker",
          "id": "women_image",
          "label": "Women image"
        },
        {
          "type": "product",
          "id": "women_product",
          "label": "Women fallback product"
        },
        {
          "type": "collection",
          "id": "women_collection",
          "label": "Women collection"
        },
        {
          "type": "url",
          "id": "women_link",
          "label": "Women link"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Prada category showcase",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Men's Bags"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Men's Ready to Wear"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Men's Shoes"
          }
        },
        {
          "type": "category",
          "settings": {
