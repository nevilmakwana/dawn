<section class="prada-category-showcase color-{{ section.settings.color_scheme }} gradient">
  <div class="prada-category-showcase__intro">
    {%- if section.settings.text != blank -%}
      <div class="prada-category-showcase__text rte">
        {{ section.settings.text }}
      </div>
    {%- endif -%}

    <div class="prada-category-showcase__tabs" role="tablist" aria-label="Category tabs">
      {%- if section.settings.women_label != blank -%}
        <button
          type="button"
          role="tab"
          aria-selected="{% if section.settings.active_tab == 'women' %}true{% else %}false{% endif %}"
          aria-controls="PradaCategoryWomen-{{ section.id }}"
          data-prada-category-tab="women"
          class="prada-category-showcase__tab{% if section.settings.active_tab == 'women' %} is-active{% endif %}"
        >
          {{ section.settings.women_label }}
        </button>
      {%- endif -%}

      {%- if section.settings.men_label != blank -%}
        <button
          type="button"
          role="tab"
          aria-selected="{% if section.settings.active_tab == 'men' %}true{% else %}false{% endif %}"
          aria-controls="PradaCategoryMen-{{ section.id }}"
          data-prada-category-tab="men"
          class="prada-category-showcase__tab{% if section.settings.active_tab == 'men' %} is-active{% endif %}"
        >
          {{ section.settings.men_label }}
        </button>
      {%- endif -%}
    </div>
  </div>

  <div class="prada-category-showcase__viewport" data-prada-category-viewport data-active="{{ section.settings.active_tab }}">
    <div id="PradaCategoryWomen-{{ section.id }}" class="prada-category-showcase__grid prada-category-showcase__panel" role="tabpanel" data-prada-category-panel="women"{% unless section.settings.active_tab == 'women' %} aria-hidden="true" inert{% endunless %}>
      {%- for block in section.blocks -%}
        {%- liquid
          assign fallback_product = collections.all.products[forloop.index0]
          assign tile_title = block.settings.women_title | default: fallback_product.title | default: block.settings.title
          assign tile_image = block.settings.women_image
          assign tile_url = blank

          if tile_image == blank and block.settings.women_product != blank
            assign tile_image = block.settings.women_product.featured_media.preview_image
          endif
          if tile_image == blank and block.settings.women_collection != blank
            assign tile_image = block.settings.women_collection.image | default: block.settings.women_collection.products.first.featured_media.preview_image
          endif
          if tile_image == blank and fallback_product != blank
            assign tile_image = fallback_product.featured_media.preview_image
          endif

          if block.settings.women_collection != blank
            assign tile_url = block.settings.women_collection.url
          elsif block.settings.women_link != blank
            assign tile_url = block.settings.women_link
          elsif block.settings.women_product != blank
            assign tile_url = block.settings.women_product.url
          elsif fallback_product != blank
            assign tile_url = fallback_product.url
          else
            assign tile_url = section.settings.women_link | default: routes.all_products_collection_url
          endif
        -%}
        {%- render 'prada-category-tile', tile_image: tile_image, tile_url: tile_url, tile_title: tile_title -%}
      {%- endfor -%}
    </div>

    <div id="PradaCategoryMen-{{ section.id }}" class="prada-category-showcase__grid prada-category-showcase__panel" role="tabpanel" data-prada-category-panel="men"{% unless section.settings.active_tab == 'men' %} aria-hidden="true" inert{% endunless %}>
      {%- for block in section.blocks -%}
        {%- liquid
          assign fallback_product = collections.all.products[forloop.index0]
          assign tile_title = block.settings.title | default: fallback_product.title
          assign tile_image = block.settings.image
          assign tile_url = blank

          if tile_image == blank and block.settings.product != blank
            assign tile_image = block.settings.product.featured_media.preview_image
          endif
          if tile_image == blank and block.settings.collection != blank
            assign tile_image = block.settings.collection.image | default: block.settings.collection.products.first.featured_media.preview_image
          endif
          if tile_image == blank and fallback_product != blank
            assign tile_image = fallback_product.featured_media.preview_image
          endif

          if block.settings.collection != blank
            assign tile_url = block.settings.collection.url
          elsif block.settings.link != blank
            assign tile_url = block.settings.link
          elsif block.settings.product != blank
            assign tile_url = block.settings.product.url
          elsif fallback_product != blank
            assign tile_url = fallback_product.url
          else
            assign tile_url = section.settings.men_link | default: routes.all_products_collection_url
          endif
        -%}
        {%- render 'prada-category-tile', tile_image: tile_image, tile_url: tile_url, tile_title: tile_title, block: block -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    background: rgb(var(--color-background));
  }

  #shopify-section-{{ section.id }} .prada-category-showcase {
    width: 100%;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__intro {
    min-height: {{ section.settings.intro_height }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px 20px 46px;
    text-align: center;
    background: rgb(var(--color-background));
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__text {
    max-width: 680px;
    color: rgb(var(--color-foreground));
    font-size: 14px;
    line-height: 1.28;
    font-weight: 600;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__tabs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-top: 26px;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__tab {
    appearance: none;
    margin: 0;
    border: 0;
    border-bottom: 1px solid transparent;
    background: transparent;
    color: rgb(var(--color-foreground));
    font-family: inherit;
    font-size: 14px;
    line-height: 1;
    font-weight: 600;
    cursor: pointer;
    padding-bottom: 10px;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__tab.is-active {
    border-bottom-color: currentColor;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__viewport {
    position: relative;
    display: grid;
    overflow: hidden;
    background: #ffffff;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__grid {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    background: #ffffff;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__panel {
    width: 100%;
    transition: transform 560ms cubic-bezier(0.22, 1, 0.36, 1), opacity 360ms ease;
    will-change: transform;
  }

  #shopify-section-{{ section.id }} [data-active='women'] [data-prada-category-panel='women'],
  #shopify-section-{{ section.id }} [data-active='men'] [data-prada-category-panel='men'] {
    z-index: 2;
    opacity: 1;
    transform: translate3d(0, 0, 0);
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} [data-active='men'] [data-prada-category-panel='women'] {
    z-index: 1;
    opacity: 0;
    transform: translate3d(-100%, 0, 0);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} [data-active='women'] [data-prada-category-panel='men'] {
    z-index: 1;
    opacity: 0;
    transform: translate3d(100%, 0, 0);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__item {
    display: grid;
    grid-template-rows: minmax(420px, {{ section.settings.tile_height }}px) 74px;
    min-width: 0;
    color: #000000;
    text-decoration: none;
    background: #ffffff;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__media {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    background: {{ section.settings.tile_background }};
    border-right: 1px solid #ffffff;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__item:last-child .prada-category-showcase__media {
    border-right: 0;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__placeholder {
    width: 70%;
    height: 70%;
    opacity: 0.45;
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__item:hover .prada-category-showcase__image {
    transform: scale(1.025);
  }

  #shopify-section-{{ section.id }} .prada-category-showcase__label {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px 12px;
    color: #000000;
    background: #ffffff;
    text-align: center;
    font-size: 14px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: 0;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .prada-category-showcase__intro {
      min-height: auto;
      padding: 42px 24px 38px;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__text {
      max-width: 520px;
      font-size: 13px;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1px;
      background: #ffffff;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__item {
      grid-template-rows: minmax(260px, 52vw) 58px;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__media {
      border-right: 0;
      border-bottom: 0;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__image {
      width: 100%;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__label {
      min-height: 58px;
      padding: 14px 8px;
      font-size: 13px;
    }
  }

  @media screen and (max-width: 520px) {
    #shopify-section-{{ section.id }} .prada-category-showcase__intro {
      padding: 36px 22px 32px;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__tabs {
      margin-top: 22px;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__item {
      grid-template-rows: minmax(238px, 61vw) 56px;
    }

    #shopify-section-{{ section.id }} .prada-category-showcase__label {
      min-height: 56px;
      padding: 13px 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .prada-category-showcase__panel {
      transition: none;
    }
  }
{% endstyle %}

<script>
  (() => {
    const root = document.querySelector('#shopify-section-{{ section.id }} .prada-category-showcase');
    if (!root || root.dataset.tabsReady === 'true') return;
    root.dataset.tabsReady = 'true';
    const viewport = root.querySelector('[data-prada-category-viewport]');
    const tabs = [...root.querySelectorAll('[data-prada-category-tab]')];
    const panels = [...root.querySelectorAll('[data-prada-category-panel]')];

    tabs.forEach((tab) => tab.addEventListener('click', () => {
      const next = tab.dataset.pradaCategoryTab;
      if (!viewport || viewport.dataset.active === next) return;
      viewport.dataset.active = next;
      tabs.forEach((item) => {
        const active = item === tab;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-selected', String(active));
      });
      panels.forEach((panel) => {
        const active = panel.dataset.pradaCategoryPanel === next;
        panel.setAttribute('aria-hidden', String(!active));
        panel.toggleAttribute('inert', !active);
      });
    }));
  })();
</script>

{% schema %}
{
