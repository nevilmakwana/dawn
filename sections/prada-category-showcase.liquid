      "default": "<p>Rooted in memory and shaped by transformation, evolving forms and refined details reveal new expressions of individuality.</p>"
    },
    {
      "type": "text",
      "id": "women_label",
      "label": "Women label",
      "default": "Women"
    },
    {
      "type": "url",
      "id": "women_link",
      "label": "Women link"
    },
    {
      "type": "text",
      "id": "men_label",
      "label": "Men label",
      "default": "Men"
    },
    {
      "type": "url",
      "id": "men_link",
      "label": "Men link"
    },
    {
      "type": "select",
      "id": "active_tab",
      "label": "Active tab",
      "default": "men",
