{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{{ 'prada-footer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<footer class="footer footer--greyexim color-{{ section.settings.color_scheme }} gradient{% if request.page_type == 'product' %} footer--prada-product{% endif %}">
  {%- liquid
    assign has_social_icons = true
    if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_bluesky_link == blank and settings.social_linkedin_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
      assign has_social_icons = false
    endif

    if settings.brand_image == blank and settings.brand_headline == blank and settings.brand_description == blank
      assign brand_empty = true
    endif

    if section.blocks.size == 1 and section.blocks[0].type == 'brand_information' and brand_empty and has_social_icons == false and section.settings.newsletter_enable == false and section.settings.enable_follow_on_shop == false
      assign only_empty_brand = true
    endif

    assign greyexim_footer_logo = settings.logo_hover
    if greyexim_footer_logo == blank
      assign greyexim_footer_logo = settings.logo
    endif

    assign greyexim_privacy_url = routes.root_url | append: 'policies/privacy-policy'
    if shop.privacy_policy != blank
      assign greyexim_privacy_url = shop.privacy_policy.url
    endif
  -%}

  <div id="GreyeximFooter" class="prada-footer">
    <section class="prada-footer__newsletter" aria-labelledby="PradaFooterNewsletter-{{ section.id }}">
      <h2 id="PradaFooterNewsletter-{{ section.id }}">Subscribe to our newsletter</h2>
      {%- form 'customer', id: 'PradaFooterNewsletterForm', class: 'prada-footer__newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="prada-footer__field">
          <input type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" placeholder="Insert your e-mail address *" aria-label="Email address" required>
          <button type="submit" name="commit" aria-label="Subscribe"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M3 16h25M20 8l8 8-8 8" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button>
        </div>
        {%- if form.errors -%}<small class="prada-footer__message">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</small>{%- endif -%}
        {%- if form.posted_successfully? -%}<small class="prada-footer__message">Thank you for subscribing.</small>{%- endif -%}
      {%- endform -%}
      <p class="prada-footer__privacy">By clicking on “Subscribe”, you confirm that you have read and understood our <a href="{{ greyexim_privacy_url }}">Privacy Statement</a> and that you want to receive the newsletter and other marketing communications as set out therein.</p>
      {%- if section.settings.show_social -%}
        <ul class="prada-footer__social" role="list" aria-label="Social media">
          <li><a href="{{ settings.social_instagram_link | default: '#' }}" aria-label="Instagram">{{ 'icon-instagram.svg' | inline_asset_content }}</a></li>
          <li><a href="{{ settings.social_pinterest_link | default: '#' }}" aria-label="Pinterest">{{ 'icon-pinterest.svg' | inline_asset_content }}</a></li>
          <li><a href="{{ settings.social_facebook_link | default: '#' }}" aria-label="Facebook">{{ 'icon-facebook.svg' | inline_asset_content }}</a></li>
          <li><a href="{{ settings.social_bluesky_link | default: '#' }}" aria-label="Bluesky"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 10.8c-1.1-2.1-4.1-6-6.9-7.9C2.4 1.1 1.4 1.4.8 1.7.2 2 0 3 0 3.6c0 .7.4 5.7.7 6.5.9 3 4 4 6.8 3.5-4.9.8-5.8 3.6-3.3 6.4 4.7 4.8 6.4-1 7-3.3.1-.4.2-.6.8-.6s.7.2.8.6c.6 2.3 2.3 8.1 7 3.3 2.5-2.8 1.6-5.6-3.3-6.4 2.8.5 5.9-.5 6.8-3.5.3-.8.7-5.8.7-6.5 0-.6-.2-1.6-.8-1.9-.6-.3-1.6-.6-4.3 1.2-2.8 1.9-5.8 5.8-6.9 7.9Z"/></svg></a></li>
          <li><a href="{{ settings.social_linkedin_link | default: '#' }}" aria-label="LinkedIn"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5.4 7.8H1.8V22h3.6V7.8ZM3.6 1A2.1 2.1 0 1 0 3.6 5.2 2.1 2.1 0 0 0 3.6 1ZM22 13.9c0-4.3-2.3-6.3-5.4-6.3-2.5 0-3.6 1.4-4.2 2.3V7.8H8.8V22h3.6v-7c0-1.8.4-3.6 2.7-3.6 2.3 0 2.3 2.1 2.3 3.7V22H22v-8.1Z"/></svg></a></li>
          <li><a href="{{ settings.social_tiktok_link | default: '#' }}" aria-label="TikTok">{{ 'icon-tiktok.svg' | inline_asset_content }}</a></li>
          <li><a href="{{ settings.social_youtube_link | default: '#' }}" aria-label="YouTube">{{ 'icon-youtube.svg' | inline_asset_content }}</a></li>
        </ul>
      {%- endif -%}
    </section>

    <details class="prada-footer__group prada-footer__group--contact" open>
      <summary><span>Contact us</span><span class="prada-footer__chevron" aria-hidden="true"></span></summary>
      <div class="prada-footer__group-content">
        <ul>
          <li><a href="/pages/contact#send-us-email">{{ section.settings.contact_email | default: shop.email | escape }}</a></li>
          <li><a href="/pages/contact?view=faq">FAQ</a></li>
        </ul>
      </div>
    </details>

    <details class="prada-footer__group prada-footer__group--services" open>
      <summary><span>Services</span><span class="prada-footer__chevron" aria-hidden="true"></span></summary>
      <div class="prada-footer__group-content"><ul>
        <li><a href="/pages/contact?view=track-order">Track your order</a></li>
        <li><a href="/pages/contact?view=returns">Returns</a></li>
        <li><a href="{{ routes.root_url }}pages/contact?view=faq#topic-shipments">Shipping and delivery</a></li>
      </ul></div>
    </details>

    <details class="prada-footer__group prada-footer__group--legal" open>
      <summary><span>Legal terms and conditions</span><span class="prada-footer__chevron" aria-hidden="true"></span></summary>
      <div class="prada-footer__group-content"><ul>
        <li><a href="{{ greyexim_privacy_url }}">Privacy Statement</a></li>
        <li><a href="{{ routes.root_url }}pages/contact?view=cookie-policy">Cookie Policy</a></li>
        <li><a href="{{ routes.root_url }}pages/contact?view=payment-policy">Payment Policy</a></li>
        <li><a href="{{ routes.root_url }}pages/contact?view=terms-and-conditions">Terms and Conditions</a></li>
        <li><button type="button" class="prada-footer__cookie-settings" data-cookie-settings>Cookie settings</button></li>
        <li><a href="{{ routes.root_url }}sitemap.xml">Sitemap</a></li>
      </ul></div>
    </details>

    <div class="prada-footer__bottom">
      <p>Grey Exim &copy; 2026</p>
      <button type="button" class="prada-footer__shipping" data-prada-localization-open aria-haspopup="dialog" aria-controls="PradaLocalizationDrawer-{{ section.id }}">
        <svg class="prada-footer__globe" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.4 2.3 3.6 5.2 3.6 8.5S14.4 18.2 12 20.5M12 3.5C9.6 5.8 8.4 8.7 8.4 12s1.2 6.2 3.6 8.5"/></svg>
        <span data-prada-shipping-label>Shipping to: {{ localization.country.name | escape }} — {{ localization.country.currency.iso_code }} / {{ localization.language.endonym_name | escape }}</span>
      </button>
    </div>

    <div id="PradaLocalizationDrawer-{{ section.id }}" class="prada-localization-drawer" data-prada-localization-drawer role="dialog" aria-modal="true" aria-labelledby="PradaLocalizationTitle-{{ section.id }}" aria-hidden="true">
      <button type="button" class="prada-localization-drawer__overlay" data-prada-localization-close aria-label="Close location and language selector"></button>
      <aside class="prada-localization-drawer__panel">
        <button type="button" class="prada-localization-drawer__close" data-prada-localization-close aria-label="Close location and language selector">&times;</button>
        <div class="prada-localization-drawer__content">
          <h2 id="PradaLocalizationTitle-{{ section.id }}">Select location and language</h2>
          {%- form 'localization', id: 'PradaLocalizationForm', class: 'prada-localization-drawer__form' -%}
            <label class="prada-localization-drawer__field">
              <span class="visually-hidden">Country or region</span>
              <select name="country_code" aria-label="Country and currency" data-prada-country-currency>
                {%- for country in localization.available_countries -%}
                  <option value="{{ country.iso_code }}" data-currency-code="{{ country.currency.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                    {{- country.name }} — {{ country.currency.iso_code }} {{ country.currency.symbol -}}
                  </option>
                {%- endfor -%}
              </select>
            </label>
            <label class="prada-localization-drawer__field">
              <span class="visually-hidden">Language</span>
              <select name="locale_code" aria-label="Language">
                {%- for language in localization.available_languages -%}
                  <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                    {{- language.endonym_name | capitalize -}}
                  </option>
                {%- endfor -%}
              </select>
            </label>
            <input type="hidden" name="return_to" value="{{ request.path }}">
            <button type="submit" class="prada-localization-drawer__confirm">Confirm</button>
          {%- endform -%}
          <p class="prada-localization-drawer__note">Prices, currency and checkout follow the Shopify Market assigned to the selected destination.</p>
        </div>
      </aside>
    </div>
  </div>

  <script>
    (() => {
      const footer = document.getElementById('GreyeximFooter');
      if (!footer || footer.dataset.ready === 'true') return;
      footer.dataset.ready = 'true';
      const mobile = window.matchMedia('(max-width: 989px)');
      const groups = [...footer.querySelectorAll('.prada-footer__group')];
      const localizationDrawer = footer.querySelector('[data-prada-localization-drawer]');
      const countryCurrency = localizationDrawer?.querySelector('[data-prada-country-currency]');
      let localizationTrigger = null;

      const updateShippingLabel = () => {
        if (!countryCurrency) return;
        const destination = countryCurrency.options[countryCurrency.selectedIndex]?.textContent?.trim();
        const language = localizationDrawer?.querySelector('[name="locale_code"]')?.selectedOptions?.[0]?.textContent?.trim();
        document.querySelectorAll('[data-prada-shipping-label]').forEach((label) => {
          label.textContent = `Shipping to: ${destination} / ${language}`;
        });
      };
      const preferredLocalesByCountry = {
        AE: ['ar', 'en'], AU: ['en'], BR: ['pt-BR', 'pt'], CA: ['en', 'fr'], CH: ['de', 'fr', 'it'],
        CN: ['zh-CN', 'zh'], DE: ['de'], DK: ['da'], ES: ['es'], FR: ['fr'], GB: ['en'], HK: ['zh-TW', 'en'],
        ID: ['id', 'en'], IN: ['hi', 'en'], IT: ['it'], JP: ['ja'], KR: ['ko'], MX: ['es'], MY: ['ms', 'en'],
        NL: ['nl'], NO: ['nb', 'no'], NZ: ['en'], PH: ['en'], PL: ['pl'], PT: ['pt-PT', 'pt'], SA: ['ar', 'en'],
        SE: ['sv'], SG: ['en'], TH: ['th'], TW: ['zh-TW', 'zh'], US: ['en'], VN: ['vi'], ZA: ['en']
      };

      const selectPreferredLanguage = () => {
        const languageSelect = localizationDrawer?.querySelector('[name="locale_code"]');
        if (!countryCurrency || !languageSelect) return;
        const available = [...languageSelect.options].map((option) => option.value);
        const preferred = preferredLocalesByCountry[countryCurrency.value] || [];
        const match = preferred.find((locale) => available.includes(locale));
        if (match) languageSelect.value = match;
      };

      countryCurrency?.addEventListener('change', () => {
        selectPreferredLanguage();
        updateShippingLabel();
      });
      localizationDrawer?.querySelector('[name="locale_code"]')?.addEventListener('change', updateShippingLabel);
      updateShippingLabel();

      const closeLocalization = () => {
        if (!localizationDrawer?.classList.contains('is-open')) return;
        localizationDrawer.classList.remove('is-open');
        localizationDrawer.setAttribute('aria-hidden', 'true');
        document.documentElement.classList.remove('prada-localization-open');
        localizationTrigger?.focus();
      };

      const openLocalization = (trigger) => {
        if (!localizationDrawer) return;
        localizationTrigger = trigger;
        localizationDrawer.classList.add('is-open');
        localizationDrawer.setAttribute('aria-hidden', 'false');
        document.documentElement.classList.add('prada-localization-open');
        window.requestAnimationFrame(() => localizationDrawer.querySelector('select')?.focus());
      };

      document.addEventListener('click', (event) => {
        const opener = event.target.closest('[data-prada-localization-open]');
        const controls = opener?.getAttribute('aria-controls');
        if (opener && (!controls || controls === localizationDrawer?.id)) openLocalization(opener);
      });
      footer.querySelectorAll('[data-prada-localization-close]').forEach((closer) => closer.addEventListener('click', closeLocalization));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && localizationDrawer?.classList.contains('is-open')) closeLocalization();
      });

      const syncGroups = () => groups.forEach((group) => {
        const summary = group.querySelector('summary');
        const content = group.querySelector('.prada-footer__group-content');
        group.classList.remove('is-expanded');
        group.open = true;
        if (mobile.matches) {
          const expandedHeight = (content?.scrollHeight || 0) + 30;
          group.style.setProperty('--prada-footer-content-height', `${expandedHeight}px`);
          summary?.setAttribute('aria-expanded', 'false');
        } else {
          group.style.removeProperty('--prada-footer-content-height');
          summary?.setAttribute('aria-expanded', 'true');
        }
      });
      syncGroups();
      mobile.addEventListener?.('change', syncGroups);

      groups.forEach((group) => {
        const summary = group.querySelector('summary');
        const content = group.querySelector('.prada-footer__group-content');
        if (!summary || !content) return;
        summary.addEventListener('click', (event) => {
          if (!mobile.matches) return;
          event.preventDefault();
          const willExpand = !group.classList.contains('is-expanded');
          if (willExpand) {
            groups.forEach((sibling) => {
              if (sibling === group) return;
              sibling.classList.remove('is-expanded');
              sibling.querySelector('summary')?.setAttribute('aria-expanded', 'false');
            });
            group.style.setProperty('--prada-footer-content-height', `${content.scrollHeight + 30}px`);
          }
          group.classList.toggle('is-expanded', willExpand);
          summary.setAttribute('aria-expanded', String(willExpand));
        });
      });

      footer.querySelector('[data-cookie-settings]')?.addEventListener('click', () => {
        if (window.Shopify?.customerPrivacy?.showPreferences) {
          window.Shopify.customerPrivacy.showPreferences();
        } else {
          document.dispatchEvent(new CustomEvent('shopify:open-cookie-preferences'));
        }
      });
    })();
  </script>

  {%- if section.blocks.size > 0
    or section.settings.newsletter_enable
    or section.settings.show_social
    and has_social_icons == true
    or section.settings.enable_follow_on_shop
  -%}
    {%- unless only_empty_brand -%}
      <div class="footer__content-top page-width">
        {%- if section.blocks.size > 0 -%}
          {%- liquid
            if section.blocks.size == 9
              assign footer_grid_class = 'grid--3-col-tablet'
            elsif section.blocks.size > 6
              assign footer_grid_class = 'grid--4-col-desktop'
            elsif section.blocks.size > 4
              assign footer_grid_class = 'grid--3-col-tablet'
            endif
          -%}
          <div
            class="footer__blocks-wrapper grid grid--1-col grid--2-col grid--4-col-tablet {{ footer_grid_class }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
            {% endif %}
          >
            {%- for block in section.blocks -%}
              <div
                class="footer-block grid__item{% if block.type == 'link_list' %} footer-block--menu{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer-block__heading inline-richtext">{{- block.settings.heading -}}</h2>
                {%- endif -%}

                {%- case block.type -%}
                  {%- when '@app' -%}
                    {% render block %}
                  {%- when 'text' -%}
                    <div class="footer-block__details-content rte">
                      {{ block.settings.subtext }}
                    </div>
                  {%- when 'link_list' -%}
                    {%- if block.settings.menu != blank -%}
                      <ul class="footer-block__details-content list-unstyled">
                        {%- for link in block.settings.menu.links -%}
                          <li>
                            <a
                              href="{{ link.url }}"
                              class="link link--text list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}"
                            >
                              {{ link.title | escape }}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  {%- when 'brand_information' -%}
                    <div class="footer-block__brand-info">
                      {%- if settings.brand_image != blank -%}
                        {%- assign brand_image_height = settings.brand_image_width
                          | divided_by: settings.brand_image.aspect_ratio
                        -%}
                        <div
                          class="footer-block__image-wrapper"
                          style="max-width: min(100%, {{ settings.brand_image_width }}px);"
                        >
                          {{
                            settings.brand_image
                            | image_url: width: 1100
                            | image_tag:
                              loading: 'lazy',
                              widths: '50, 100, 150, 200, 300, 400, 550, 800, 1100',
                              height: brand_image_height,
                              width: settings.brand_image_width
                          }}
                        </div>
                      {%- endif -%}
                      {%- if settings.brand_headline != blank -%}
                        <h2 class="footer-block__heading rte">{{ settings.brand_headline }}</h2>
                      {%- endif -%}
                      {%- if settings.brand_description != blank -%}
                        <div class="rte">{{ settings.brand_description }}</div>
                      {%- endif -%}
                      {%- if block.settings.show_social and has_social_icons -%}
                        {%- render 'social-icons', class: 'footer__list-social' -%}
                      {%- endif -%}
                    </div>
                  {%- when 'image' -%}
                    <div class="footer-block__details-content footer-block-image {{ block.settings.alignment }}">
                      {%- if block.settings.image != blank -%}
                        {%- assign image_size_2x = block.settings.image_width | times: 2 | at_most: 5760 -%}
                        <div
                          class="footer-block__image-wrapper"
                          style="max-width: min(100%, {{ block.settings.image_width }}px);"
                        >
                          <img
                            srcset="{{ block.settings.image | image_url: width: block.settings.image_width }}, {{ block.settings.image | image_url: width: image_size_2x }} 2x"
                            src="{{ block.settings.image | image_url: width: 760 }}"
                            alt="{{ block.settings.image.alt | escape }}"
                            loading="lazy"
                            width="{{ block.settings.image.width }}"
                            height="{{ block.settings.image.height }}"
                          >
                        </div>
                      {%- else -%}
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                      {%- endif -%}
                    </div>
                {%- endcase -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div
          class="footer-block--newsletter{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
          {% endif %}
        >
          {%- if section.settings.newsletter_enable -%}
            <div class="footer-block__newsletter">
              {%- if section.settings.newsletter_heading != blank -%}
                <h2 class="footer-block__heading inline-richtext">{{ section.settings.newsletter_heading }}</h2>
              {%- endif -%}
              {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="newsletter-form__field-wrapper">
                  <div class="field">
                    <input
                      id="NewsletterForm--{{ section.id }}"
                      type="email"
                      name="contact[email]"
                      class="field__input"
                      value="{{ form.email }}"
                      aria-required="true"
                      autocorrect="off"
                      autocapitalize="off"
                      autocomplete="email"
                      {% if form.errors %}
                        autofocus
                        aria-invalid="true"
                        aria-describedby="ContactFooter-error"
                      {% elsif form.posted_successfully? %}
                        aria-describedby="ContactFooter-success"
                      {% endif %}
                      placeholder="{{ 'newsletter.label' | t }}"
                      required
                    >
                    <label class="field__label" for="NewsletterForm--{{ section.id }}">
                      {{ 'newsletter.label' | t }}
                    </label>
                    <button
                      type="submit"
                      class="newsletter-form__button field__button"
                      name="commit"
                      id="Subscribe"
                      aria-label="{{ 'newsletter.button_label' | t }}"
                    >
                      <span class="svg-wrapper">
                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                      </span>
                    </button>
                  </div>
                  {%- if form.errors -%}
                    <small class="newsletter-form__message form__message" id="ContactFooter-error">
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      {{- form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email -}}
                    </small>
                  {%- endif -%}
                </div>
                {%- if form.posted_successfully? -%}
                  <h3
                    class="newsletter-form__message newsletter-form__message--success form__message"
                    id="ContactFooter-success"
                    tabindex="-1"
                    autofocus
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-success.svg' | inline_asset_content -}}
                    </span>
                    {{- 'newsletter.success' | t }}
                  </h3>
                {%- endif -%}
              {%- endform -%}
            </div>
          {%- endif -%}

          {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
            <div class="footer__follow-on-shop">
              {{ shop | login_button: action: 'follow' }}
            </div>
          {%- endif -%}

          {%- if section.settings.show_social and has_social_icons -%}
            {%- render 'social-icons', class: 'footer__list-social' -%}
          {%- endif -%}
        </div>
      </div>
    {%- endunless -%}
  {%- endif -%}

  <div
    class="footer__content-bottom{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    <div class="footer__content-bottom-wrapper page-width">
      <div class="footer__column footer__localization isolate">
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
              <div>
                <h2 class="caption-large text-body" id="FooterCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'FooterCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}

        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
              <div>
                <h2 class="caption-large text-body" id="FooterLanguageLabel">
                  {{ 'localization.language_label' | t }}
                </h2>
                {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>
      <div class="footer__column footer__column--info">
        {%- if section.settings.payment_enable -%}
          <div class="footer__payment">
            <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
            <ul class="list list-payment" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li class="list-payment__item">
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
    <div class="footer__content-bottom-wrapper page-width{% if section.settings.enable_country_selector == false and section.settings.enable_language_selector == false %} footer__content-bottom-wrapper--center{% endif %}">
      <div class="footer__copyright caption">
        <small class="copyright__content"
          >&copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url -}}
        </small>
        <small class="copyright__content">{{ powered_by_link }}</small>
        {%- if section.settings.show_policy -%}
          <ul class="policies list-unstyled">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li>
                  <small class="copyright__content"
                    ><a href="{{ policy.url }}">{{ policy.title | escape }}</a></small
                  >
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if false -%}
    <div class="prada-mobile-footer">
      <section class="prada-mobile-footer__newsletter" aria-labelledby="PradaMobileNewsletterHeading-{{ section.id }}">
        <h2 id="PradaMobileNewsletterHeading-{{ section.id }}">Subscribe to our newsletter</h2>
        {%- form 'customer', id: 'PradaMobileNewsletter', class: 'prada-mobile-footer__newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="prada-mobile-footer__field">
            <input
              id="PradaMobileNewsletterEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              aria-label="Email address"
              autocomplete="email"
              placeholder="Insert your e-mail address *"
              required
            >
            <button type="submit" name="commit" aria-label="Subscribe">
              <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M4 16h23M20 8l8 8-8 8" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
            </button>
          </div>
          {%- if form.errors -%}
            <small>{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</small>
          {%- elsif form.posted_successfully? -%}
            <small>Thank you for subscribing.</small>
          {%- endif -%}
        {%- endform -%}
        <p class="prada-mobile-footer__privacy">
          By clicking on &ldquo;Subscribe&rdquo;, you confirm that you have read and understood our
          {%- if shop.privacy_policy != blank -%}
            <a href="{{ shop.privacy_policy.url }}"> Privacy Statement</a>
          {%- else -%}
            <a href="{{ routes.root_url }}policies/privacy-policy"> Privacy Statement</a>
          {%- endif -%}
          and that you want to receive marketing communications.
        </p>
        {%- if section.settings.show_social and has_social_icons -%}
          {%- render 'social-icons', class: 'footer__list-social' -%}
        {%- endif -%}
      </section>

      <details class="prada-mobile-footer__accordion">
        <summary><span>Contact us</span><span class="prada-mobile-footer__chevron" aria-hidden="true"></span></summary>
        <div class="prada-mobile-footer__accordion-content">
          <ul>
            <li><a href="/pages/contact">Contact Grey Exim</a></li>
            {%- if shop.email != blank -%}<li><a href="mailto:{{ shop.email | escape }}">{{ shop.email | escape }}</a></li>{%- endif -%}
            <li><a href="/pages/contact?view=faq">FAQ</a></li>
          </ul>
        </div>
      </details>

      <details class="prada-mobile-footer__accordion">
        <summary><span>Services</span><span class="prada-mobile-footer__chevron" aria-hidden="true"></span></summary>
        <div class="prada-mobile-footer__accordion-content">
          <ul>
            {%- if shop.shipping_policy != blank -%}<li><a href="{{ shop.shipping_policy.url }}">Shipping</a></li>{%- endif -%}
            {%- if shop.refund_policy != blank -%}<li><a href="{{ shop.refund_policy.url }}">Returns and refunds</a></li>{%- endif -%}
            <li><a href="{{ routes.cart_url }}">Shopping bag</a></li>
          </ul>
        </div>
      </details>

      <details class="prada-mobile-footer__accordion">
        <summary><span>Legal terms and conditions</span><span class="prada-mobile-footer__chevron" aria-hidden="true"></span></summary>
        <div class="prada-mobile-footer__accordion-content">
          <ul>
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}<li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </details>

      <div class="prada-mobile-footer__utility">
        <a class="prada-mobile-footer__link" href="/pages/contact">Store locator</a>
      </div>
      <div class="prada-mobile-footer__utility">
        <button type="button" class="prada-mobile-footer__localization" data-prada-shipping-label data-prada-localization-open aria-haspopup="dialog" aria-controls="PradaLocalizationDrawer-{{ section.id }}">Shipping to: {{ localization.country.name | escape }} — {{ localization.country.currency.iso_code }} / {{ localization.language.endonym_name | escape }}</button>
      </div>
      <div class="prada-mobile-footer__utility prada-mobile-footer__copyright">
        <span>Grey Exim &copy; 2026</span>
      </div>
      <div class="prada-mobile-footer__legal">
        {%- if shop.privacy_policy != blank -%}<a href="{{ shop.privacy_policy.url }}">Privacy policy</a>{%- endif -%}
        {%- if shop.terms_of_service != blank -%}<a href="{{ shop.terms_of_service.url }}">Terms of service</a>{%- endif -%}
      </div>
    </div>

    <script>
      (() => {
        const footer = document.currentScript?.previousElementSibling;
        if (!footer?.classList.contains('prada-mobile-footer') || footer.dataset.accordionsReady === 'true') return;
        footer.dataset.accordionsReady = 'true';
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        footer.querySelectorAll('.prada-mobile-footer__accordion').forEach((details) => {
          const summary = details.querySelector('summary');
          const content = details.querySelector('.prada-mobile-footer__accordion-content');
          if (!summary || !content) return;

          summary.addEventListener('click', (event) => {
            if (!window.matchMedia('(max-width: 989px)').matches) return;
            event.preventDefault();
            details._pradaFooterAnimation?.cancel();

            if (reducedMotion.matches || typeof content.animate !== 'function') {
              details.open = !details.open;
              return;
            }

            if (details.open) {
              const startHeight = content.getBoundingClientRect().height;
              details._pradaFooterAnimation = content.animate(
                [{ height: `${startHeight}px`, opacity: 1 }, { height: '0px', opacity: 0 }],
                { duration: 280, easing: 'cubic-bezier(.4, 0, 1, 1)' }
              );
              details._pradaFooterAnimation.onfinish = () => {
                details.open = false;
                details._pradaFooterAnimation = null;
              };
            } else {
              footer.querySelectorAll('.prada-mobile-footer__accordion[open]').forEach((sibling) => {
                if (sibling !== details) sibling.querySelector('summary')?.click();
              });
              details.open = true;
              const endHeight = content.getBoundingClientRect().height;
              details._pradaFooterAnimation = content.animate(
                [{ height: '0px', opacity: 0 }, { height: `${endHeight}px`, opacity: 1 }],
                { duration: 320, easing: 'cubic-bezier(.22, 1, .36, 1)' }
              );
              details._pradaFooterAnimation.onfinish = () => {
                details._pradaFooterAnimation = null;
              };
            }
          });
        });
      })();
    </script>
  {%- endif -%}
</footer>

