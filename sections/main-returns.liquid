{{ 'section-track-order.css' | asset_url | stylesheet_tag }}

<section class="prada-track-order prada-returns">
  <aside class="prada-track-order__sidebar" aria-label="Client service navigation">
    <nav>
      <a href="/pages/contact#send-us-email">Contact us</a>
      <a href="/pages/contact?view=track-order">Track your order</a>
      <a class="is-active" href="/pages/contact?view=returns">Returns</a>
      <a href="{{ section.settings.faq_url | default: routes.root_url }}">FAQ</a>
    </nav>
    <div class="prada-track-order__hours">{{ section.settings.opening_hours }}</div>
  </aside>

  <div class="prada-track-order__main">
    <div class="prada-track-order__content">
      <h1>{{ section.settings.heading | escape }}</h1>
      <div class="prada-track-order__intro">
        {{ section.settings.intro }}
        {%- if shop.customer_accounts_enabled -%}
          <a href="{{ routes.account_login_url }}">Log in</a>
        {%- endif -%}
      </div>

      {%- form 'contact', id: 'ReturnOrderForm', class: 'prada-track-order__form' -%}
        <input type="hidden" name="contact[Request type]" value="Order return request">
        <input type="hidden" name="contact[body]" value="A customer has requested help returning an order.">
        {%- if form.posted_successfully? -%}
          <p class="prada-track-order__success" tabindex="-1" autofocus>Your return request has been received. Our client service team will contact you.</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="prada-track-order__error" role="alert">Please enter a valid email address and order number.</p>
        {%- endif -%}
        <div class="prada-track-order__fields">
          <label>
            <span>E-mail*</span>
            <input type="email" name="contact[email]" autocomplete="email" required value="{% if customer %}{{ customer.email }}{% endif %}">
          </label>
          <label>
            <span>Order number*</span>
            <input type="text" name="contact[Order number]" autocomplete="off" required>
          </label>
        </div>
        <button type="submit">Continue</button>
      {%- endform -%}

      <div class="prada-track-order__questions">
        <h2>{{ section.settings.questions_heading | escape }}</h2>
        <div class="prada-track-order__question-list">
          {%- for block in section.blocks -%}
            <a href="{{ block.settings.link | default: section.settings.faq_url | default: routes.root_url }}" {{ block.shopify_attributes }}>
              {{ block.settings.text | escape }}
            </a>
          {%- endfor -%}
        </div>
        <a class="prada-track-order__faq-link" href="{{ section.settings.faq_url | default: routes.root_url }}">View all FAQs</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Prada returns",
  "tag": "section",
  "class": "section-prada-returns",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Return your order"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Free returns for purchases made online within 30 days of delivery, provided the return conditions are met. If you have already registered, log in to your account. If you placed the order as a guest, please fill in the following fields:</p>"
    },
    {
      "type": "text",
      "id": "questions_heading",
      "label": "Questions heading",
      "default": "Suggested Questions"
    },
    {
      "type": "url",
      "id": "faq_url",
      "label": "FAQ link"
    },
    {
      "type": "richtext",
      "id": "opening_hours",
      "label": "Client service opening hours",
      "default": "<p><strong>Client Service Opening Hours:</strong><br/>Monday - Saturday: 10 am - 07 pm<br/>Sunday: Closed</p>"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Suggested question",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Question",
          "default": "Can I return a product purchased online?"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Prada returns"
    }
  ]
}
{% endschema %}
