{%- liquid
  assign section_heading = section.settings.heading | strip
  assign section_label = section_heading | default: 'Collection showcase'
  assign image_sizes = '(max-width: 749px) ' | append: section.settings.mobile_card_width | append: 'px, ' | append: section.settings.desktop_card_width | append: 'px'
  assign allowed_paths = section.settings.allowed_paths | strip
  assign show_showcase = true
  assign parent_count = 0
  assign active_parent_block_id = blank

  for block in section.blocks
    if block.type == 'card'
      assign parent_count = parent_count | plus: 1

      assign landing_collection = block.settings.landing_collection
      if landing_collection == blank and block.settings.collection_list != blank
        assign landing_collection = block.settings.collection_list.first
      endif
      if landing_collection == blank
        assign landing_collection = block.settings.collection
      endif

      assign candidate_title = block.settings.title | strip
      if candidate_title == blank
        assign candidate_title = landing_collection.title
      endif
      assign candidate_group_key = block.settings.group_key | default: candidate_title | handleize
      assign candidate_child_count = 0
      assign candidate_selected_count = 0
      assign candidate_selected_ids = '|'
      assign candidate_matches_current = false

      if request.page_type == 'collection' and landing_collection.id == collection.id
        assign candidate_matches_current = true
      endif

      for child_block in section.blocks
        if child_block.type == 'child_collection'
          assign child_parent_key = child_block.settings.parent_group | handleize
          if child_parent_key != blank and child_parent_key == candidate_group_key
            assign candidate_child_count = candidate_child_count | plus: 1

            if request.page_type == 'collection'
              assign child_collection = child_block.settings.collection
              assign child_custom_path = child_block.settings.link | split: '?' | first | split: '#' | first
              if block.settings.collection_list == blank and block.settings.collection == blank
                if child_collection.id == collection.id or child_custom_path == collection.url
                  assign candidate_matches_current = true
                endif
              endif
            endif
          endif
        endif
      endfor

      for selected_collection in block.settings.collection_list
        assign selected_collection_key = '|' | append: selected_collection.id | append: '|'
        unless candidate_selected_ids contains selected_collection_key
          assign candidate_selected_ids = candidate_selected_ids | append: selected_collection.id | append: '|'
          assign candidate_selected_count = candidate_selected_count | plus: 1
          if request.page_type == 'collection' and selected_collection.id == collection.id
            assign candidate_matches_current = true
          endif
        endunless
      endfor

      assign direct_collection = block.settings.collection
      if direct_collection != blank
        assign direct_collection_key = '|' | append: direct_collection.id | append: '|'
        unless candidate_selected_ids contains direct_collection_key
          assign candidate_selected_count = candidate_selected_count | plus: 1
          if request.page_type == 'collection' and direct_collection.id == collection.id
            assign candidate_matches_current = true
          endif
        endunless
      endif

      if candidate_selected_count > 0
        assign candidate_navigation_count = candidate_selected_count
      else
        assign candidate_navigation_count = candidate_child_count
      endif

      if candidate_matches_current and candidate_navigation_count > 0
        assign active_parent_block_id = block.id
        break
      endif
    endif
  endfor

  if allowed_paths != blank
    assign show_showcase = false
    assign allowed_path_list = allowed_paths | split: ','
    for allowed_path_entry in allowed_path_list
      assign allowed_path = allowed_path_entry | strip
      if request.path == allowed_path
        assign show_showcase = true
        break
      endif
    endfor
  endif

  if active_parent_block_id != blank
    assign show_showcase = true
  endif

  assign hide_showcase = false
  if show_showcase == false or active_parent_block_id != blank
    assign hide_showcase = true
  endif
-%}

<collection-showcase
  class="collection-showcase color-{{ section.settings.color_scheme }} gradient"
  data-collection-showcase
  data-showcase-placement="{{ section.settings.placement }}"
  data-allowed-paths="{{ allowed_paths | escape }}"
  data-showcase-parent-page="{% if active_parent_block_id != blank %}true{% else %}false{% endif %}"
  data-showcase-active-parent="{{ active_parent_block_id }}"
  {% if hide_showcase %}hidden{% endif %}
  style="
    --showcase-max-width: {{ section.settings.max_width }}px;
    --showcase-card-width: {{ section.settings.desktop_card_width }}px;
    --showcase-mobile-card-width: {{ section.settings.mobile_card_width }}px;
    --showcase-gap: {{ section.settings.card_gap }}px;
    --showcase-inline-padding: {{ section.settings.horizontal_padding }}px;
    --showcase-image-ratio: {{ section.settings.image_ratio }};
    --showcase-image-fit: {{ section.settings.image_fit }};
    --showcase-image-background: {{ section.settings.image_background }};
    --showcase-heading-size: {{ section.settings.heading_size }}px;
    --showcase-title-size: {{ section.settings.title_size }}px;
    --showcase-subtitle-size: {{ section.settings.subtitle_size }}px;
    --showcase-padding-top: {{ section.settings.padding_top }}px;
    --showcase-padding-bottom: {{ section.settings.padding_bottom }}px;
    --showcase-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --showcase-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  "
>
  <div data-showcase-root-view {% if active_parent_block_id != blank %}hidden{% endif %}>
    {%- if section_heading != blank or section.settings.intro_text != blank -%}
      <div class="collection-showcase__intro collection-showcase__intro--{{ section.settings.intro_alignment }}">
        {%- if section_heading != blank -%}
          <h2 class="collection-showcase__heading">{{ section_heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.intro_text != blank -%}
          <div class="collection-showcase__intro-text rte">{{ section.settings.intro_text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="collection-showcase__carousel" data-showcase-carousel>
      <div
        id="CollectionShowcaseViewport-{{ section.id }}"
        class="collection-showcase__viewport"
        data-showcase-viewport
        role="region"
        aria-label="{{ section_label | escape }}"
        tabindex="0"
      >
        <div class="collection-showcase__list" data-showcase-list>
          {%- for block in section.blocks -%}
            {%- unless block.type == 'card' -%}
              {%- continue -%}
            {%- endunless -%}
          {%- liquid
            assign selected_collection = block.settings.collection
            assign landing_collection = block.settings.landing_collection
            if landing_collection == blank and block.settings.collection_list != blank
              assign landing_collection = block.settings.collection_list.first
            endif
            if landing_collection == blank
              assign landing_collection = selected_collection
            endif
            if selected_collection == blank
              assign selected_collection = landing_collection
            endif

            assign selected_product = blank
            if block.settings.product_list != blank
              assign selected_product = block.settings.product_list.first
            endif

            assign card_image = block.settings.image
            if card_image == blank and selected_collection != blank
              assign card_image = selected_collection.image
              if card_image == blank and selected_collection.products.first != blank
                assign card_image = selected_collection.products.first.featured_media.preview_image
              endif
            endif
            if card_image == blank and selected_product != blank
              assign card_image = selected_product.featured_media.preview_image
            endif

            assign card_title = block.settings.title | strip
            if card_title == blank and selected_collection != blank
              assign card_title = selected_collection.title
            endif
            if card_title == blank and selected_product != blank
              assign card_title = selected_product.title
            endif
            if card_title == blank
              assign card_title = 'Collection'
            endif

            assign parent_group_key = block.settings.group_key | default: card_title | handleize
            assign child_count = 0
            for child_block in section.blocks
              if child_block.type == 'child_collection'
                assign child_parent_key = child_block.settings.parent_group | handleize
                if child_parent_key != blank and child_parent_key == parent_group_key
                  assign child_count = child_count | plus: 1
                endif
              endif
            endfor

            assign card_url = block.settings.link
            assign tag_handle = block.settings.product_tag | handleize
            if card_url == blank
              if child_count > 0 or block.settings.collection_list != blank
                assign card_url = landing_collection.url
              endif
            endif
            if card_url == blank and selected_collection != blank and tag_handle != blank
              assign card_url = selected_collection.url | append: '/' | append: tag_handle
            elsif card_url == blank and selected_collection != blank
              assign card_url = selected_collection.url
            elsif card_url == blank and selected_product != blank
              assign card_url = selected_product.url
            elsif card_url == blank and tag_handle != blank
              assign card_url = routes.all_products_collection_url | append: '/' | append: tag_handle
            endif

            assign card_alt = card_image.alt | default: card_title
          -%}

          <article class="collection-showcase__card" {{ block.shopify_attributes }}>
            {%- if card_url != blank -%}
              <a class="collection-showcase__link" href="{{ card_url }}">
            {%- elsif child_count > 0 -%}
              <button
                type="button"
                class="collection-showcase__link collection-showcase__link--button"
                data-showcase-open="{{ block.id }}"
                aria-controls="CollectionShowcasePanel-{{ section.id }}-{{ block.id }}"
                aria-expanded="false"
                aria-label="Explore {{ card_title | escape }}"
              >
            {%- else -%}
              <div class="collection-showcase__link collection-showcase__link--static">
            {%- endif -%}

              <div class="collection-showcase__media">
                {%- if card_image != blank -%}
                  {{-
                    card_image
                    | image_url: width: 1000
                    | image_tag:
                      class: 'collection-showcase__image',
                      widths: '160, 220, 320, 400, 480, 640, 800, 1000',
                      sizes: image_sizes,
                      loading: 'lazy',
                      alt: card_alt
                  -}}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'collection-showcase__placeholder placeholder-svg' }}
                {%- endif -%}
              </div>

              <div class="collection-showcase__content collection-showcase__content--{{ section.settings.text_alignment }}">
                <h3 class="collection-showcase__title">{{ card_title | escape }}</h3>
                {%- if block.settings.subtitle != blank -%}
                  <p class="collection-showcase__subtitle">{{ block.settings.subtitle | escape }}</p>
                {%- endif -%}
              </div>

            {%- if card_url != blank -%}
              </a>
            {%- elsif child_count > 0 -%}
              </button>
            {%- else -%}
              </div>
            {%- endif -%}
          </article>
          {%- endfor -%}

          {%- if parent_count == 0 and request.design_mode -%}
            <p class="collection-showcase__empty">Add a parent showcase block to build this row.</p>
          {%- endif -%}
        </div>
      </div>

      {%- if section.settings.show_desktop_arrows and parent_count > 0 -%}
        <div class="collection-showcase__controls" data-showcase-controls hidden>
          <button
            type="button"
            class="collection-showcase__arrow collection-showcase__arrow--previous"
            data-showcase-previous
            aria-controls="CollectionShowcaseViewport-{{ section.id }}"
            aria-label="Previous cards"
            title="Previous cards"
          >
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </button>
          <button
            type="button"
            class="collection-showcase__arrow collection-showcase__arrow--next"
            data-showcase-next
            aria-controls="CollectionShowcaseViewport-{{ section.id }}"
            aria-label="Next cards"
            title="Next cards"
          >
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- for parent_block in section.blocks -%}
    {%- unless parent_block.type == 'card' -%}
      {%- continue -%}
    {%- endunless -%}

    {%- liquid
      assign parent_landing_collection = parent_block.settings.landing_collection
      if parent_landing_collection == blank and parent_block.settings.collection_list != blank
        assign parent_landing_collection = parent_block.settings.collection_list.first
      endif
      if parent_landing_collection == blank
        assign parent_landing_collection = parent_block.settings.collection
      endif

      assign parent_title = parent_block.settings.title | strip
      if parent_title == blank and parent_landing_collection != blank
        assign parent_title = parent_landing_collection.title
      endif
      if parent_title == blank
        assign parent_title = 'Collections'
      endif

      assign parent_group_key = parent_block.settings.group_key | default: parent_title | handleize
      assign child_count = 0
      assign parent_selected_count = 0
      assign parent_selected_ids = '|'
      for child_block in section.blocks
        if child_block.type == 'child_collection'
          assign child_parent_key = child_block.settings.parent_group | handleize
          if child_parent_key != blank and child_parent_key == parent_group_key
            assign child_count = child_count | plus: 1
          endif
        endif
      endfor

      for parent_selected_collection in parent_block.settings.collection_list
        assign parent_selected_key = '|' | append: parent_selected_collection.id | append: '|'
        unless parent_selected_ids contains parent_selected_key
          assign parent_selected_ids = parent_selected_ids | append: parent_selected_collection.id | append: '|'
          assign parent_selected_count = parent_selected_count | plus: 1
        endunless
      endfor

      assign parent_direct_collection = parent_block.settings.collection
      if parent_direct_collection != blank
        assign parent_direct_key = '|' | append: parent_direct_collection.id | append: '|'
        unless parent_selected_ids contains parent_direct_key
          assign parent_selected_count = parent_selected_count | plus: 1
        endunless
      endif
    -%}

    {%- if child_count > 0 or parent_selected_count > 0 -%}
      <section
        id="CollectionShowcasePanel-{{ section.id }}-{{ parent_block.id }}"
        class="collection-showcase__panel"
        data-showcase-panel="{{ parent_block.id }}"
        data-showcase-navigation-title="{{ parent_title | escape }}"
        data-showcase-view-all-url="{{ parent_landing_collection.url }}"
        aria-labelledby="CollectionShowcasePanelTitle-{{ section.id }}-{{ parent_block.id }}"
        {% unless parent_block.id == active_parent_block_id %}hidden{% endunless %}
      >
        {%- if parent_selected_count > 0 -%}
          <div data-showcase-selected-navigation hidden>
            {%- assign rendered_selected_ids = '|' -%}
            {%- for navigation_collection in parent_block.settings.collection_list -%}
              {%- liquid
                assign navigation_collection_key = '|' | append: navigation_collection.id | append: '|'
                if rendered_selected_ids contains navigation_collection_key
                  continue
                endif
                assign rendered_selected_ids = rendered_selected_ids | append: navigation_collection.id | append: '|'
                assign navigation_title = navigation_collection.title
                assign navigation_tab_handle = blank

                for title_block in section.blocks
                  if title_block.type == 'child_collection'
                    assign title_parent_key = title_block.settings.parent_group | handleize
                    if title_parent_key == parent_group_key and title_block.settings.collection.id == navigation_collection.id
                      assign custom_navigation_title = title_block.settings.title | strip
                      if custom_navigation_title != blank
                        assign navigation_title = custom_navigation_title
                      endif
                      assign navigation_tab_handle = title_block.settings.tab_handle
                      break
                    endif
                  endif
                endfor

                assign navigation_tab_handle = navigation_tab_handle | default: navigation_title | handleize
                assign navigation_url = navigation_collection.url | append: '#nested-' | append: navigation_tab_handle
              -%}
              <a
                href="{{ navigation_url }}"
                data-showcase-navigation-link
                data-showcase-tab-handle="{{ navigation_tab_handle }}"
                data-showcase-tab-label="{{ navigation_title | escape }}"
              ></a>
            {%- endfor -%}

            {%- if parent_direct_collection != blank -%}
              {%- assign navigation_collection_key = '|' | append: parent_direct_collection.id | append: '|' -%}
              {%- unless rendered_selected_ids contains navigation_collection_key -%}
                {%- liquid
                  assign navigation_title = parent_direct_collection.title
                  assign navigation_tab_handle = blank

                  for title_block in section.blocks
                    if title_block.type == 'child_collection'
                      assign title_parent_key = title_block.settings.parent_group | handleize
                      if title_parent_key == parent_group_key and title_block.settings.collection.id == parent_direct_collection.id
                        assign custom_navigation_title = title_block.settings.title | strip
                        if custom_navigation_title != blank
                          assign navigation_title = custom_navigation_title
                        endif
                        assign navigation_tab_handle = title_block.settings.tab_handle
                        break
                      endif
                    endif
                  endfor

                  assign navigation_tab_handle = navigation_tab_handle | default: navigation_title | handleize
                  assign navigation_url = parent_direct_collection.url | append: '#nested-' | append: navigation_tab_handle
                -%}
                <a
                  href="{{ navigation_url }}"
                  data-showcase-navigation-link
                  data-showcase-tab-handle="{{ navigation_tab_handle }}"
                  data-showcase-tab-label="{{ navigation_title | escape }}"
                ></a>
              {%- endunless -%}
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="collection-showcase__panel-header">
          {%- unless parent_block.id == active_parent_block_id -%}
            <button type="button" class="collection-showcase__back" data-showcase-back>
              {{- 'icon-caret.svg' | inline_asset_content -}}
              <span>Back</span>
            </button>
          {%- endunless -%}
          <h2
            id="CollectionShowcasePanelTitle-{{ section.id }}-{{ parent_block.id }}"
            class="collection-showcase__panel-title"
          >
            {{- parent_title | escape -}}
          </h2>
        </div>

        <div class="collection-showcase__carousel" data-showcase-carousel>
          <div
            id="CollectionShowcaseChildViewport-{{ section.id }}-{{ parent_block.id }}"
            class="collection-showcase__viewport"
            data-showcase-viewport
            role="region"
            aria-label="{{ parent_title | escape }} collections"
            tabindex="0"
          >
            <div class="collection-showcase__list" data-showcase-list>
              {%- for child_block in section.blocks -%}
                {%- unless child_block.type == 'child_collection' -%}
                  {%- continue -%}
                {%- endunless -%}

                {%- assign child_parent_key = child_block.settings.parent_group | handleize -%}
                {%- unless child_parent_key != blank and child_parent_key == parent_group_key -%}
                  {%- continue -%}
                {%- endunless -%}

                {%- liquid
                  assign child_collection = child_block.settings.collection
                  assign child_image = child_block.settings.image
                  if child_image == blank and child_collection != blank
                    assign child_image = child_collection.image
                    if child_image == blank and child_collection.products.first != blank
                      assign child_image = child_collection.products.first.featured_media.preview_image
                    endif
                  endif

                  assign child_title = child_block.settings.title | strip
                  if child_title == blank and child_collection != blank
                    assign child_title = child_collection.title
                  endif
                  if child_title == blank
                    assign child_title = 'Collection'
                  endif

                  assign child_tab_handle = child_block.settings.tab_handle | default: child_title | handleize
                  assign child_url = child_block.settings.link
                  if child_url == blank and child_collection != blank
                    assign child_url = child_collection.url | append: '#nested-' | append: child_tab_handle
                  endif
                  assign child_alt = child_image.alt | default: child_title
                -%}

                <article
                  class="collection-showcase__card"
                  data-showcase-child-card
                  data-showcase-parent="{{ parent_block.id }}"
                  {{ child_block.shopify_attributes }}
                >
                  {%- if child_url != blank -%}
                    <a
                      class="collection-showcase__link"
                      href="{{ child_url }}"
                      data-showcase-navigation-link
                      data-showcase-tab-handle="{{ child_tab_handle }}"
                      data-showcase-tab-label="{{ child_title | escape }}"
                    >
                  {%- else -%}
                    <div class="collection-showcase__link collection-showcase__link--static">
                  {%- endif -%}

                    <div class="collection-showcase__media">
                      {%- if child_image != blank -%}
                        {{-
                          child_image
                          | image_url: width: 1000
                          | image_tag:
                            class: 'collection-showcase__image',
                            widths: '160, 220, 320, 400, 480, 640, 800, 1000',
                            sizes: image_sizes,
                            loading: 'lazy',
                            alt: child_alt
                        -}}
                      {%- else -%}
                        {{ 'collection-1' | placeholder_svg_tag: 'collection-showcase__placeholder placeholder-svg' }}
                      {%- endif -%}
                    </div>

                    <div class="collection-showcase__content collection-showcase__content--{{ section.settings.text_alignment }}">
                      <h3 class="collection-showcase__title">{{ child_title | escape }}</h3>
                      {%- if child_block.settings.subtitle != blank -%}
                        <p class="collection-showcase__subtitle">{{ child_block.settings.subtitle | escape }}</p>
                      {%- endif -%}
                    </div>

                  {%- if child_url != blank -%}
                    </a>
                  {%- else -%}
                    </div>
                  {%- endif -%}
                </article>
              {%- endfor -%}
            </div>
          </div>

          {%- if section.settings.show_desktop_arrows and child_count > 0 -%}
            <div class="collection-showcase__controls" data-showcase-controls hidden>
              <button
                type="button"
                class="collection-showcase__arrow collection-showcase__arrow--previous"
                data-showcase-previous
                aria-controls="CollectionShowcaseChildViewport-{{ section.id }}-{{ parent_block.id }}"
                aria-label="Previous collections"
                title="Previous collections"
              >
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </button>
              <button
                type="button"
                class="collection-showcase__arrow collection-showcase__arrow--next"
                data-showcase-next
                aria-controls="CollectionShowcaseChildViewport-{{ section.id }}-{{ parent_block.id }}"
                aria-label="Next collections"
                title="Next collections"
              >
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </button>
            </div>
          {%- endif -%}
        </div>
      </section>
    {%- endif -%}
  {%- endfor -%}
</collection-showcase>

{% style %}
  #shopify-section-{{ section.id }} {
    background: rgb(var(--color-background));
  }

  #shopify-section-{{ section.id }} .collection-showcase {
    display: block;
    width: 100%;
    padding-block: var(--showcase-padding-top) var(--showcase-padding-bottom);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .collection-showcase[hidden],
  #shopify-section-{{ section.id }} .collection-showcase [hidden],
  #shopify-section-{{ section.id }} .collection-showcase[data-showcase-placement='below_collection_toolbar']:not([data-showcase-mounted]) {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .collection-showcase__intro {
    width: min(100%, var(--showcase-max-width));
    margin-inline: auto;
    padding: 0 var(--showcase-inline-padding) 34px;
  }

  #shopify-section-{{ section.id }} .collection-showcase__intro--center {
    text-align: center;
  }

  #shopify-section-{{ section.id }} .collection-showcase__intro--left {
    text-align: left;
  }

  #shopify-section-{{ section.id }} .collection-showcase__heading {
    margin: 0;
    color: rgb(var(--color-foreground));
    font-family: inherit;
    font-size: var(--showcase-heading-size);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .collection-showcase__intro-text {
    max-width: 680px;
    margin: 12px auto 0;
    color: rgb(var(--color-foreground));
    font-size: 14px;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .collection-showcase__intro--left .collection-showcase__intro-text {
    margin-left: 0;
  }

  #shopify-section-{{ section.id }} .collection-showcase__intro-text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .collection-showcase__carousel {
    position: relative;
    width: min(100%, var(--showcase-max-width));
    margin-inline: auto;
    padding-inline: var(--showcase-inline-padding);
  }

  #shopify-section-{{ section.id }} .collection-showcase__viewport {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    scroll-snap-type: x proximity;
    scroll-padding-inline: 1px;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  #shopify-section-{{ section.id }} .collection-showcase__viewport::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .collection-showcase__viewport:focus-visible {
    outline: 2px solid rgb(var(--color-foreground));
    outline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .collection-showcase__list {
    display: flex;
    width: max-content;
    min-width: 100%;
    align-items: flex-start;
    justify-content: center;
