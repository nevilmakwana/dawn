<script>
  (() => {
    if (customElements.get('collection-showcase')) return;

    class CollectionShowcase extends HTMLElement {
      connectedCallback() {
        const placementState = this.mountAtRequestedPosition();
        if (placementState === 'pending' || placementState === 'moved') return;

        this.dataset.showcaseMounted = 'true';
        if (this.dataset.showcaseReady === 'true') return;
        this.dataset.showcaseReady = 'true';

        this.rootView = this.querySelector('[data-showcase-root-view]');
        this.panels = Array.from(this.querySelectorAll('[data-showcase-panel]'));
        this.isParentPage = this.dataset.showcaseParentPage === 'true';
        this.activePanel = this.panels.find((panel) => !panel.hidden) || null;
        this.activeOpener = null;

        this.handleVisibilityChange = this.updateVisibility.bind(this);
        this.handleClick = this.onClick.bind(this);
        this.handleKeydown = this.onKeydown.bind(this);
        this.handleScroll = this.queueUpdate.bind(this);
        this.handleBlockSelect = this.onBlockSelect.bind(this);
        window.addEventListener('popstate', this.handleVisibilityChange);
        document.addEventListener('prada:collection:updated', this.handleVisibilityChange);
        document.addEventListener('shopify:block:select', this.handleBlockSelect);
        this.addEventListener('click', this.handleClick);
        this.addEventListener('keydown', this.handleKeydown);
        this.updateVisibility();

        this.updateFrame = null;
        this.carousels = Array.from(this.querySelectorAll('[data-showcase-carousel]')).map((carousel) => ({
          element: carousel,
          viewport: carousel.querySelector('[data-showcase-viewport]'),
          list: carousel.querySelector('[data-showcase-list]'),
          controls: carousel.querySelector('[data-showcase-controls]'),
          previousButton: carousel.querySelector('[data-showcase-previous]'),
          nextButton: carousel.querySelector('[data-showcase-next]'),
        }));
        this.resizeObserver = new ResizeObserver(() => this.queueUpdate());
        this.carousels.forEach((carousel) => {
          carousel.viewport?.addEventListener('scroll', this.handleScroll, { passive: true });
          if (carousel.viewport) this.resizeObserver.observe(carousel.viewport);
          if (carousel.list) this.resizeObserver.observe(carousel.list);
        });
        this.queueUpdate();
      }

      disconnectedCallback() {
        if (this.pendingMount) {
          document.removeEventListener('DOMContentLoaded', this.pendingMount);
          this.pendingMount = null;
        }
        window.removeEventListener('popstate', this.handleVisibilityChange);
        document.removeEventListener('prada:collection:updated', this.handleVisibilityChange);
        document.removeEventListener('shopify:block:select', this.handleBlockSelect);
        this.removeEventListener('click', this.handleClick);
        this.removeEventListener('keydown', this.handleKeydown);
        this.carousels?.forEach((carousel) => carousel.viewport?.removeEventListener('scroll', this.handleScroll));
        this.resizeObserver?.disconnect();
        window.cancelAnimationFrame(this.updateFrame);
        delete this.dataset.showcaseReady;
      }

      mountAtRequestedPosition() {
        if (this.dataset.showcasePlacement !== 'below_collection_toolbar') return 'stable';

        const anchor = document.querySelector('[data-collection-showcase-anchor]');
        const sectionWrapper = this.closest('.shopify-section');
        if (!anchor || !sectionWrapper) {
          if (document.readyState === 'loading') {
            this.pendingMount = () => {
              this.pendingMount = null;
              const nextState = this.mountAtRequestedPosition();
              if (nextState === 'stable') this.connectedCallback();
            };
            document.addEventListener('DOMContentLoaded', this.pendingMount, { once: true });
            return 'pending';
          }
          return 'stable';
        }

        if (anchor.nextElementSibling !== sectionWrapper) {
          anchor.insertAdjacentElement('afterend', sectionWrapper);
          return 'moved';
        }

        return 'stable';
      }

      updateVisibility() {
        if (this.dataset.showcaseParentPage === 'true') {
          this.hidden = true;
          return;
        }

        const allowedPaths = (this.dataset.allowedPaths || '')
          .split(',')
          .map((path) => path.trim())
          .filter(Boolean);
        if (!allowedPaths.length) {
          this.hidden = false;
          return;
        }

        const currentPath = window.location.pathname.replace(/\/+$/, '') || '/';
        this.hidden = !allowedPaths.some((path) => {
          const allowedPath = new URL(path, window.location.origin).pathname.replace(/\/+$/, '') || '/';
          return currentPath === allowedPath;
        });
      }

      queueUpdate() {
        window.cancelAnimationFrame(this.updateFrame);
        this.updateFrame = window.requestAnimationFrame(() => this.updateControls());
      }

      updateControls() {
        const desktop = window.matchMedia('(min-width: 750px)').matches;
        this.carousels?.forEach((carousel) => {
          if (!carousel.viewport || !carousel.controls || !carousel.previousButton || !carousel.nextButton) return;
          const maxScroll = Math.max(0, carousel.viewport.scrollWidth - carousel.viewport.clientWidth);
          carousel.controls.hidden = !desktop || maxScroll <= 1 || carousel.element.closest('[hidden]');
          carousel.previousButton.disabled = carousel.viewport.scrollLeft <= 1;
          carousel.nextButton.disabled = carousel.viewport.scrollLeft >= maxScroll - 1;
        });
      }

      move(carousel, direction) {
        if (!carousel?.viewport || !carousel.list) return;
        const firstCard = carousel.list.querySelector('.collection-showcase__card');
        const styles = window.getComputedStyle(carousel.list);
        const gap = Number.parseFloat(styles.columnGap || styles.gap) || 0;
        const cardWidth = firstCard?.getBoundingClientRect().width || carousel.viewport.clientWidth;
        const visibleCards = Math.max(1, Math.floor(carousel.viewport.clientWidth / (cardWidth + gap)));
        carousel.viewport.scrollBy({
          left: direction * visibleCards * (cardWidth + gap),
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        });
      }

      findCarousel(element) {
        const carouselElement = element?.closest('[data-showcase-carousel]');
        return this.carousels?.find((carousel) => carousel.element === carouselElement);
      }

      handleize(value) {
        return String(value || '')
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-|-$/g, '');
      }

      onClick(event) {
        const childLink = event.target.closest('[data-showcase-tab-handle]');
        if (childLink && this.contains(childLink)) {
          const targetUrl = new URL(childLink.href, window.location.origin);
          if (targetUrl.origin === window.location.origin && targetUrl.pathname === window.location.pathname) {
            const requestedHandle = childLink.dataset.showcaseTabHandle;
            const matchingTab = Array.from(
              document.querySelectorAll('[data-prada-collection-tabs] .prada-collection__tab')
            ).find((tab) => this.handleize(tab.textContent) === requestedHandle);

            event.preventDefault();
            if (matchingTab) {
              matchingTab.click();
              window.history.replaceState(window.history.state, '', targetUrl.href);
              this.updateVisibility();
            } else {
              window.history.pushState({ showcaseTab: requestedHandle }, '', targetUrl.href);
              window.location.reload();
            }
            return;
          }
        }

        const openButton = event.target.closest('[data-showcase-open]');
        if (openButton && this.contains(openButton)) {
          this.openPanel(openButton.dataset.showcaseOpen, openButton);
          return;
        }

        const backButton = event.target.closest('[data-showcase-back]');
        if (backButton && this.contains(backButton)) {
          this.closePanel();
          return;
        }

        const previousButton = event.target.closest('[data-showcase-previous]');
        if (previousButton && this.contains(previousButton)) {
          this.move(this.findCarousel(previousButton), -1);
          return;
        }

        const nextButton = event.target.closest('[data-showcase-next]');
        if (nextButton && this.contains(nextButton)) this.move(this.findCarousel(nextButton), 1);
      }

      openPanel(parentId, opener = null, moveFocus = true) {
        const panel = this.panels.find((candidate) => candidate.dataset.showcasePanel === parentId);
        if (!panel || !this.rootView) return;

        this.panels.forEach((candidate) => {
          candidate.hidden = candidate !== panel;
        });
        this.querySelectorAll('[data-showcase-open]').forEach((button) => {
          button.setAttribute('aria-expanded', String(button.dataset.showcaseOpen === parentId));
        });
        this.rootView.hidden = true;
        panel.hidden = false;
        this.activePanel = panel;
        this.activeOpener =
          opener ||
          Array.from(this.querySelectorAll('[data-showcase-open]')).find(
            (button) => button.dataset.showcaseOpen === parentId
          );
        panel.querySelector('[data-showcase-viewport]')?.scrollTo({ left: 0, behavior: 'auto' });
        this.queueUpdate();
        if (moveFocus) panel.querySelector('[data-showcase-back]')?.focus({ preventScroll: true });
      }

      closePanel(moveFocus = true) {
        if (!this.rootView || this.isParentPage) return;
        const opener = this.activeOpener;
        this.panels.forEach((panel) => {
          panel.hidden = true;
        });
        this.querySelectorAll('[data-showcase-open]').forEach((button) => button.setAttribute('aria-expanded', 'false'));
        this.rootView.hidden = false;
        this.activePanel = null;
        this.activeOpener = null;
        this.queueUpdate();
        if (moveFocus) opener?.focus({ preventScroll: true });
      }

      onBlockSelect(event) {
        if (!event.target || !this.contains(event.target)) return;
        const childCard = event.target.closest('[data-showcase-child-card]');
        if (childCard) {
          this.openPanel(childCard.dataset.showcaseParent, null, false);
          return;
        }
        if (event.target.closest('.collection-showcase__card')) this.closePanel(false);
      }

      onKeydown(event) {
        if (event.key === 'Escape' && this.activePanel && !this.isParentPage) {
          event.preventDefault();
          this.closePanel();
          return;
        }

        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        const viewport = event.target.closest('[data-showcase-viewport]');
        if (!viewport) return;
        event.preventDefault();
        this.move(this.findCarousel(viewport), event.key === 'ArrowLeft' ? -1 : 1);
      }
    }

    customElements.define('collection-showcase', CollectionShowcase);
  })();
</script>

