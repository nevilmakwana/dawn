{{ 'grey-exim-privacy-policy.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign refund_policy_updated = section.settings.last_updated | default: 'Last updated: 14 August 2026'
  assign refund_contact_email = section.settings.contact_email | default: 'care@greyexim.com'
-%}

<article class="grey-policy grey-policy--editorial" aria-labelledby="GreyRefundPolicyTitle">
  <header class="grey-policy__hero">
    <div class="grey-policy__hero-inner">
      <h1 id="GreyRefundPolicyTitle">Return and Refund Policy</h1>
      <p class="grey-policy__updated">{{ refund_policy_updated | escape }}</p>
    </div>
  </header>

  <div class="grey-policy__shell">
    <aside class="grey-policy__aside" data-policy-navigation hidden>
      <details class="grey-policy__toc" open>
        <summary>On this page</summary>
        <nav aria-label="Return and refund policy sections">
          <ol data-policy-navigation-list></ol>
        </nav>
      </details>
    </aside>

    <div class="grey-policy__content rte" data-policy-content>
      {%- if shop.refund_policy.body != blank -%}
        {{ shop.refund_policy.body }}
      {%- else -%}
        <div class="grey-policy__intro">
          <p>Return and refund policy information will be available here shortly.</p>
        </div>
      {%- endif -%}

      <section id="refund-contact" class="grey-policy__section grey-policy__section--contact" data-refund-contact>
        <h2><span data-refund-contact-number aria-hidden="true">01</span> Contact Us</h2>
        <p>For questions, complaints or concerns regarding returns or refunds, your order or our Website, please contact:</p>
        <div class="grey-policy__contact-card">
          <address>
            <strong>Grey Exim</strong><br>
            Shop 105, Building B, Sicilia<br>
            Mota Varachha, Near Bhakti Nandan Circle<br>
            Surat &ndash; 394101<br>
            Gujarat, India
          </address>
          <p><strong>Email</strong><br><a href="mailto:{{ refund_contact_email | escape }}">{{ refund_contact_email | escape }}</a></p>
          <p><strong>Website</strong><br><a href="https://www.greyexim.com">www.greyexim.com</a></p>
        </div>
      </section>
    </div>
  </div>
</article>

<script>
  (() => {
    const section = document.currentScript?.previousElementSibling;
    if (!section) return;

    const publicPath = '{{ routes.root_url }}policies/return-and-refund-policy';
    if (window.location.pathname !== publicPath) {
      window.history.replaceState(window.history.state, '', `${publicPath}${window.location.search}${window.location.hash}`);
    }
    document.title = `Return and Refund Policy – {{ shop.name | escape }}`;

    const content = section.querySelector('[data-policy-content]');
    const navigation = section.querySelector('[data-policy-navigation]');
    const list = section.querySelector('[data-policy-navigation-list]');
    const headings = content ? [...content.querySelectorAll('h2')] : [];
    const contactHeading = section.querySelector('[data-refund-contact] h2');
    const contactNumber = section.querySelector('[data-refund-contact-number]');
    if (contactHeading && contactNumber) {
      const contactIndex = headings.indexOf(contactHeading);
      contactNumber.textContent = String(contactIndex + 1).padStart(2, '0');
    }
    if (!navigation || !list || headings.length < 2) return;

    const usedIds = new Set();
    headings.forEach((heading, index) => {
      const baseId = heading.textContent
        .trim()
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '') || `section-${index + 1}`;
      let id = baseId;
      let suffix = 2;
      while (usedIds.has(id) || document.getElementById(id)) id = `${baseId}-${suffix++}`;
      usedIds.add(id);
      heading.id = id;

      const item = document.createElement('li');
      const link = document.createElement('a');
      link.href = `#${id}`;
      const headingLabel = heading.cloneNode(true);
      headingLabel.querySelector('[data-refund-contact-number]')?.remove();
      link.textContent = headingLabel.textContent.trim();
      item.appendChild(link);
      list.appendChild(item);
    });

    navigation.hidden = false;
  })();
</script>

{% schema %}
{
  "name": "Return & refund policy",
  "tag": "section",
  "class": "section-grey-exim-privacy-policy section-grey-exim-refund-policy",
  "settings": [
    {
      "type": "text",
      "id": "last_updated",
      "label": "Last updated text",
      "default": "Last updated: 14 August 2026"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email",
      "default": "care@greyexim.com"
    }
  ]
}
{% endschema %}
