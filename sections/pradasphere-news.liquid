{{ 'section-pradasphere-news.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign selected_blog = section.settings.blog
  assign article_limit = section.settings.article_limit
-%}

<section
  class="pradasphere-news"
  data-pradasphere-news
  style="--pradasphere-top: {{ section.settings.padding_top }}px; --pradasphere-bottom: {{ section.settings.padding_bottom }}px;"
>
  <h2 class="pradasphere-news__heading">{{ section.settings.heading | escape }}</h2>

  <div class="pradasphere-news__carousel">
    <div class="pradasphere-news__track" data-pradasphere-track tabindex="0" aria-label="{{ section.settings.heading | escape }}">
      {%- if selected_blog != blank and selected_blog.articles_count > 0 -%}
        {%- for article in selected_blog.articles limit: article_limit -%}
          <article class="pradasphere-news__slide{% if forloop.first %} is-active{% endif %}" data-pradasphere-slide>
            <a class="pradasphere-news__media" href="{{ article.url }}" aria-label="{{ article.title | escape }}">
              {%- if article.image -%}
                {{ article.image | image_url: width: 1800 | image_tag:
                  loading: 'lazy',
                  widths: '480, 720, 960, 1200, 1500, 1800',
                  sizes: '(min-width: 990px) 50vw, 68vw',
                  alt: article.image.alt | default: article.title
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'pradasphere-news__placeholder' }}
              {%- endif -%}
              {%- if section.settings.discover_label != blank -%}
                <span class="pradasphere-news__discover">{{ section.settings.discover_label | escape }}</span>
              {%- endif -%}
            </a>
            <div class="pradasphere-news__content">
              <span class="pradasphere-news__category">
                {%- if article.tags.first != blank -%}{{ article.tags.first | escape }}{%- else -%}{{ selected_blog.title | escape }}{%- endif -%}
              </span>
              <h3><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for index in (1..3) -%}
          <article class="pradasphere-news__slide{% if forloop.first %} is-active{% endif %}" data-pradasphere-slide>
            <div class="pradasphere-news__media">
              {%- assign placeholder_index = index | minus: 1 | modulo: 2 | plus: 1 -%}
              {%- assign placeholder_name = 'lifestyle-' | append: placeholder_index -%}
              {{ placeholder_name | placeholder_svg_tag: 'pradasphere-news__placeholder' }}
              <span class="pradasphere-news__discover">{{ section.settings.discover_label | escape }}</span>
            </div>
            <div class="pradasphere-news__content">
              <span class="pradasphere-news__category">News</span>
              <h3>Select a blog in the Theme Editor</h3>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <button class="pradasphere-news__arrow pradasphere-news__arrow--previous" type="button" data-pradasphere-previous aria-label="Previous article">
      <span aria-hidden="true">&#8249;</span>
    </button>
    <button class="pradasphere-news__arrow pradasphere-news__arrow--next" type="button" data-pradasphere-next aria-label="Next article">
      <span aria-hidden="true">&#8250;</span>
    </button>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    const track = section?.querySelector('[data-pradasphere-track]');
    const slides = Array.from(section?.querySelectorAll('[data-pradasphere-slide]') || []);
    const previous = section?.querySelector('[data-pradasphere-previous]');
    const next = section?.querySelector('[data-pradasphere-next]');
    if (!track || slides.length < 2 || !previous || !next) return;

    const slideTarget = (slide) => slide.offsetLeft - ((track.clientWidth - slide.offsetWidth) / 2);

    const getActiveIndex = () => slides.reduce((closestIndex, slide, index) => {
      return Math.abs(slideTarget(slide) - track.scrollLeft) < Math.abs(slideTarget(slides[closestIndex]) - track.scrollLeft)
        ? index
        : closestIndex;
    }, 0);

    const updateButtons = () => {
      const activeIndex = getActiveIndex();
      slides.forEach((slide, index) => {
        slide.classList.toggle('is-active', index === activeIndex);
        slide.setAttribute('aria-current', index === activeIndex ? 'true' : 'false');
      });
      previous.disabled = activeIndex === 0;
      next.disabled = activeIndex === slides.length - 1;
    };

    let animationFrame;

    const ease = (progress) => {
      let time = progress;
      for (let iteration = 0; iteration < 5; iteration += 1) {
        const inverse = 1 - time;
        const x = (3 * inverse * inverse * time * .25) + (3 * inverse * time * time * .25) + (time * time * time);
        const slope = (3 * inverse * inverse * .25) + (3 * time * time * .75);
        if (Math.abs(slope) < .0001) break;
        time -= (x - progress) / slope;
        time = Math.max(0, Math.min(1, time));
      }
      const inverse = 1 - time;
      return (3 * inverse * inverse * time * .1) + (3 * inverse * time * time) + (time * time * time);
    };

    const animateTo = (left) => {
      cancelAnimationFrame(animationFrame);
      const start = track.scrollLeft;
      const distance = left - start;
      const duration = 600;
      const startedAt = performance.now();

      const step = (now) => {
        const progress = Math.min(1, (now - startedAt) / duration);
        track.scrollLeft = start + (distance * ease(progress));
        if (progress < 1) animationFrame = requestAnimationFrame(step);
      };

      animationFrame = requestAnimationFrame(step);
    };

    const move = (direction) => {
      const activeIndex = getActiveIndex();
      const targetIndex = Math.max(0, Math.min(slides.length - 1, activeIndex + direction));
      animateTo(slideTarget(slides[targetIndex]));
    };

    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    track.addEventListener('pointerdown', () => cancelAnimationFrame(animationFrame), { passive: true });
    track.addEventListener('scroll', updateButtons, { passive: true });
    window.addEventListener('resize', updateButtons, { passive: true });
    updateButtons();
  })();
</script>

{% schema %}
{
  "name": "Pradasphere news",
  "tag": "section",
  "class": "section-pradasphere-news",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Pradasphere News"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "article_limit",
      "label": "Articles to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "discover_label",
      "label": "Image link label",
      "default": "Discover"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 76
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 68
    }
  ],
  "presets": [
    {
      "name": "Pradasphere news"
    }
  ]
}
{% endschema %}
