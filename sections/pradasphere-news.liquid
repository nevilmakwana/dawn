{{ 'section-pradasphere-news.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign selected_blog = section.settings.blog
  assign article_limit = section.settings.article_limit
-%}

<section
  class="pradasphere-news"
  data-pradasphere-news
  style="--pradasphere-top: {{ section.settings.padding_top }}px; --pradasphere-bottom: {{ section.settings.padding_bottom }}px;"
>
  <h2 class="pradasphere-news__heading">{{ section.settings.heading | escape }}</h2>

  <div class="pradasphere-news__carousel">
    <div class="pradasphere-news__track" data-pradasphere-track tabindex="0" aria-label="{{ section.settings.heading | escape }}">
      {%- if selected_blog != blank and selected_blog.articles_count > 0 -%}
        {%- for article in selected_blog.articles limit: article_limit -%}
          <article class="pradasphere-news__slide{% if forloop.first %} is-active{% endif %}" data-pradasphere-slide>
            <a class="pradasphere-news__media" href="{{ article.url }}" aria-label="{{ article.title | escape }}">
              {%- if article.image -%}
                {{ article.image | image_url: width: 1800 | image_tag:
                  loading: 'lazy',
                  widths: '480, 720, 960, 1200, 1500, 1800',
                  sizes: '(min-width: 990px) 50vw, 68vw',
                  alt: article.image.alt | default: article.title
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'pradasphere-news__placeholder' }}
              {%- endif -%}
              {%- if section.settings.discover_label != blank -%}
                <span class="pradasphere-news__discover">{{ section.settings.discover_label | escape }}</span>
              {%- endif -%}
            </a>
            <div class="pradasphere-news__content">
              <span class="pradasphere-news__category">
                {%- if article.tags.first != blank -%}{{ article.tags.first | escape }}{%- else -%}{{ selected_blog.title | escape }}{%- endif -%}
              </span>
              <h3><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for index in (1..3) -%}
          <article class="pradasphere-news__slide{% if forloop.first %} is-active{% endif %}" data-pradasphere-slide>
            <div class="pradasphere-news__media">
              {%- assign placeholder_index = index | minus: 1 | modulo: 2 | plus: 1 -%}
              {%- assign placeholder_name = 'lifestyle-' | append: placeholder_index -%}
              {{ placeholder_name | placeholder_svg_tag: 'pradasphere-news__placeholder' }}
              <span class="pradasphere-news__discover">{{ section.settings.discover_label | escape }}</span>
            </div>
            <div class="pradasphere-news__content">
              <span class="pradasphere-news__category">News</span>
              <h3>Select a blog in the Theme Editor</h3>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <button class="pradasphere-news__arrow pradasphere-news__arrow--previous" type="button" data-pradasphere-previous aria-label="Previous article">
      <span aria-hidden="true">&#8249;</span>
    </button>
    <button class="pradasphere-news__arrow pradasphere-news__arrow--next" type="button" data-pradasphere-next aria-label="Next article">
      <span aria-hidden="true">&#8250;</span>
    </button>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    const track = section?.querySelector('[data-pradasphere-track]');
    const slides = Array.from(section?.querySelectorAll('[data-pradasphere-slide]') || []);
    const previous = section?.querySelector('[data-pradasphere-previous]');
    const next = section?.querySelector('[data-pradasphere-next]');
    if (!track || slides.length < 2 || !previous || !next) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const duration = 600;
    let activeIndex = 0;
    let isAnimating = false;
    let pointerId = null;
    let pointerStart = 0;
    let dragStart = 0;
    let didDrag = false;

    const clampIndex = (index) => Math.max(0, Math.min(slides.length - 1, index));
    const stepWidth = () => slides[0]?.getBoundingClientRect().width || 0;
    const indexPosition = (index = activeIndex) => -(index * stepWidth());

    const updateState = () => {
      slides.forEach((slide, index) => {
        slide.classList.toggle('is-active', index === activeIndex);
        slide.setAttribute('aria-current', index === activeIndex ? 'true' : 'false');
      });
      previous.disabled = activeIndex === 0;
      next.disabled = activeIndex === slides.length - 1;
    };

    const render = (position, animate = true) => {
      track.style.transition = animate && !reducedMotion.matches
        ? `transform ${duration}ms ease`
        : 'none';
      track.style.transform = `translate3d(${position}px, 0, 0)`;
    };

    const goTo = (index, animate = true) => {
      const targetIndex = clampIndex(index);
      if (isAnimating && animate) return;
      activeIndex = targetIndex;
      updateState();
      isAnimating = animate && !reducedMotion.matches;
      render(indexPosition(), animate);
    };

    const finishDrag = (event, cancelled = false) => {
      if (pointerId === null || event.pointerId !== pointerId) return;
      const distance = event.clientX - pointerStart;
      const threshold = Math.min(80, stepWidth() * .15);
      const direction = !cancelled && Math.abs(distance) >= threshold ? (distance < 0 ? 1 : -1) : 0;

      if (track.hasPointerCapture(pointerId)) track.releasePointerCapture(pointerId);
      pointerId = null;
      goTo(activeIndex + direction);
    };

    previous.addEventListener('click', () => goTo(activeIndex - 1));
    next.addEventListener('click', () => goTo(activeIndex + 1));

    track.addEventListener('transitionend', (event) => {
      if (event.target === track && event.propertyName === 'transform') isAnimating = false;
    });

    track.addEventListener('pointerdown', (event) => {
      if (isAnimating || event.button !== 0) return;
      pointerId = event.pointerId;
      pointerStart = event.clientX;
      dragStart = indexPosition();
      didDrag = false;
      track.setPointerCapture(pointerId);
      track.style.transition = 'none';
    });

    track.addEventListener('pointermove', (event) => {
      if (pointerId === null || event.pointerId !== pointerId) return;
      const distance = event.clientX - pointerStart;
      didDrag = didDrag || Math.abs(distance) > 5;
      const minimum = indexPosition(slides.length - 1);
      render(Math.max(minimum, Math.min(0, dragStart + distance)), false);
    });

    track.addEventListener('pointerup', (event) => finishDrag(event));
    track.addEventListener('pointercancel', (event) => finishDrag(event, true));
    track.addEventListener('click', (event) => {
      if (!didDrag) return;
      event.preventDefault();
      event.stopPropagation();
      didDrag = false;
    }, true);

    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') goTo(activeIndex - 1);
      if (event.key === 'ArrowRight') goTo(activeIndex + 1);
    });

    window.addEventListener('resize', () => render(indexPosition(), false), { passive: true });
    updateState();
    render(indexPosition(), false);
  })();
</script>

{% schema %}
{
  "name": "Pradasphere news",
  "tag": "section",
  "class": "section-pradasphere-news",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Pradasphere News"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "article_limit",
      "label": "Articles to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "discover_label",
      "label": "Image link label",
      "default": "Discover"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 76
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 68
    }
  ],
  "presets": [
    {
      "name": "Pradasphere news"
    }
  ]
}
{% endschema %}
