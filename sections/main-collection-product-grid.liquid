<collection-component
  class="prada-collection"
  view-event-payload="{{ collection | standard_event_data: 'view' | escape }}"
  data-collection-id="{{ collection.id }}"
  data-section-id="{{ section.id }}"
  data-linked-index-url="{{ collections.all.url }}"
  data-all-products-count="{{ collections.all.products_count }}"
  data-native-product-count="{{ collection.products_count }}"
>
  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- liquid
      assign linked_extra_count = 0

      for linked_product in collections.all.products
        assign linked_product_is_native = false
        for native_collection in linked_product.collections
          if native_collection.id == collection.id
            assign linked_product_is_native = true
            break
          endif
        endfor

        unless linked_product_is_native
          assign linked_match_found = false
          for linked_variant in linked_product.variants
            assign linked_collection_refs = linked_variant.metafields.custom.linked_collections.value
            if linked_collection_refs == blank
              assign linked_collection_refs = linked_variant.metafields.custom.custom_linked_collections.value
            endif
            for linked_collection in linked_collection_refs
              if linked_collection.id == collection.id
                assign linked_match_found = true
                break
              endif
            endfor
            if linked_match_found
              break
            endif
          endfor
          if linked_match_found
            assign linked_extra_count = linked_extra_count | plus: 1
          endif
        endunless
      endfor

      assign displayed_product_count = collection.products_count | plus: linked_extra_count

      assign subcategory_current_found = false
      if section.settings.subcategory_menu != blank
        for subcategory_link in section.settings.subcategory_menu.links
          if subcategory_link.current or subcategory_link.url == collection.url
            assign subcategory_current_found = true
            break
          endif
        endfor
      endif
    -%}
    <header class="prada-collection__header">
      <div class="prada-collection__navigation">
        <h1 class="prada-collection__title" data-prada-collection-title>{{ collection.title | escape }}</h1>

        <nav
          class="prada-collection__tabs"
          aria-label="{{ collection.title | escape }} categories"
          data-prada-collection-tabs
          data-prada-navigation-state="resolving"
        >
          <a
            class="prada-collection__tab{% unless subcategory_current_found %} is-active{% endunless %}"
            href="{{ collection.url }}"
            {% unless subcategory_current_found %}aria-current="page"{% endunless %}
          >
            <span class="prada-collection__tab-text">View all</span>
          </a>
          {%- if section.settings.subcategory_menu != blank -%}
            {%- for link in section.settings.subcategory_menu.links -%}
              <a
                class="prada-collection__tab{% if link.current or link.url == collection.url %} is-active{% endif %}"
                href="{{ link.url }}"
                {% if link.current or link.url == collection.url %}
                  aria-current="page"
                {% endif %}
              >
                <span class="prada-collection__tab-text">{{- link.title | escape -}}</span>
              </a>
            {%- endfor -%}
          {%- endif -%}
        </nav>
      </div>

      <div class="prada-collection__toolbar">
        <p class="prada-collection__count">{{ displayed_product_count }} products</p>

        <form class="prada-collection__controls" action="{{ collection.url }}" method="get">
          {%- if section.settings.enable_sorting -%}
            {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
            <label class="prada-collection__sort">
              <span>Sort by:</span>
              <select name="sort_by" aria-label="Sort products" onchange="this.form.submit()">
                <option value="manual" {% if current_sort == 'manual' or current_sort == 'relevance' %}selected="selected"{% endif %}>Most relevant</option>
                <option value="best-selling" {% if current_sort == 'best-selling' %}selected="selected"{% endif %}>Best selling</option>
                <option value="price-ascending" {% if current_sort == 'price-ascending' %}selected="selected"{% endif %}>Price, low to high</option>
                <option value="price-descending" {% if current_sort == 'price-descending' %}selected="selected"{% endif %}>Price, high to low</option>
              </select>
            </label>
          {%- endif -%}
        </form>
      </div>
    </header>

    <span data-collection-showcase-anchor hidden></span>
    <script>document.dispatchEvent(new CustomEvent('prada:collection:showcase-anchor-ready'));</script>

    <div class="prada-collection__grid-container" id="ProductGridContainer">
      {%- if displayed_product_count == 0 -%}
        <div class="prada-collection__empty" id="product-grid" data-id="{{ section.id }}">
          <h2>{{ 'sections.collection_template.empty' | t }}</h2>
          <a href="{{ collection.url }}" class="underlined-link">View all products</a>
        </div>
      {%- else -%}
        <ul class="prada-collection__grid" id="product-grid" data-id="{{ section.id }}" role="list">
          {%- liquid
            assign normal_product_total = 0
            for candidate_product in collection.products
              assign candidate_featured = false
              assign candidate_featured_primary = candidate_product.metafields.custom.featured_tile.value | append: '' | strip | downcase
              assign candidate_featured_legacy = candidate_product.metafields.custom.custom_featured_tile.value | append: '' | strip | downcase
              if candidate_featured_primary == 'true' or candidate_featured_legacy == 'true'
                assign candidate_featured = true
              endif
              unless candidate_featured
                assign normal_product_total = normal_product_total | plus: 1
              endunless
            endfor
            assign rendered_normal_count = 0
          -%}
          {%- for product in collection.products -%}
            {%- liquid
              assign featured_tile_enabled = false
              assign featured_tile_primary = product.metafields.custom.featured_tile.value | append: '' | strip | downcase
              assign featured_tile_legacy = product.metafields.custom.custom_featured_tile.value | append: '' | strip | downcase
              if featured_tile_primary == 'true' or featured_tile_legacy == 'true'
                assign featured_tile_enabled = true
              endif

            -%}
            {%- unless featured_tile_enabled -%}
            {%- assign collection_card_index = rendered_normal_count | plus: 1 -%}
            {% render 'prada-nested-collection-product-card',
              product: product,
              collection_context: collection,
              card_index: collection_card_index
            %}
            {%- liquid
              assign rendered_normal_count = rendered_normal_count | plus: 1
            -%}
            {%- for featured_product in collection.products -%}
              {%- liquid
                assign candidate_featured = false
                assign candidate_featured_primary = featured_product.metafields.custom.featured_tile.value | append: '' | strip | downcase
                assign candidate_featured_legacy = featured_product.metafields.custom.custom_featured_tile.value | append: '' | strip | downcase
                if candidate_featured_primary == 'true' or candidate_featured_legacy == 'true'
                  assign candidate_featured = true
                endif
                assign candidate_position = featured_product.metafields.custom.featured_tile_position.value
                if candidate_position == blank
                  assign candidate_position = featured_product.metafields.custom.custom_featured_tile_position.value
                endif
                assign candidate_position = candidate_position | default: normal_product_total | at_least: 1 | at_most: normal_product_total
                assign candidate_size = featured_product.metafields.custom.featured_tile_size.value | default: 'wide' | downcase
                if featured_product.metafields.custom.featured_tile_size.value == blank and featured_product.metafields.custom.custom_featured_tile_size.value != blank
                  assign candidate_size = featured_product.metafields.custom.custom_featured_tile_size.value | downcase
                endif
                unless candidate_size == 'normal' or candidate_size == 'wide' or candidate_size == 'large' or candidate_size == 'full'
                  assign candidate_size = 'wide'
                endunless
              -%}
              {%- if candidate_featured and candidate_position == rendered_normal_count -%}
                <li
                  class="prada-collection__item prada-collection__item--featured prada-collection__item--featured-{{ candidate_size }}"
                  data-prada-product-id="{{ featured_product.id }}"
                >
                  {% render 'prada-featured-product-tile', product: featured_product %}
                </li>
              {%- endif -%}
            {%- endfor -%}
            {%- endunless -%}
          {%- endfor -%}

          {%- if paginate.current_page == 1 and linked_extra_count > 0 -%}
            {%- for linked_product in collections.all.products -%}
              {%- liquid
                assign linked_product_is_native = false
                for native_collection in linked_product.collections
                  if native_collection.id == collection.id
                    assign linked_product_is_native = true
                    break
                  endif
                endfor

                assign linked_variant_match = blank
                unless linked_product_is_native
                  for linked_variant in linked_product.variants
                    assign linked_collection_refs = linked_variant.metafields.custom.linked_collections.value
                    if linked_collection_refs == blank
                      assign linked_collection_refs = linked_variant.metafields.custom.custom_linked_collections.value
                    endif
                    for linked_collection in linked_collection_refs
                      if linked_collection.id == collection.id
                        assign linked_variant_match = linked_variant
                        break
                      endif
                    endfor
                    if linked_variant_match != blank
                      break
                    endif
                  endfor
                endunless
              -%}
              {%- if linked_variant_match != blank -%}
                {% render 'prada-linked-variant-card', product: linked_product, variant: linked_variant_match, lazy_load: true %}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>

        {%- if paginate.next -%}
          <div class="prada-collection__show-more" data-prada-load-more>
            <a
              class="prada-collection__show-more-link"
              href="{{ paginate.next.url }}"
              data-prada-load-more-link
              aria-controls="product-grid"
            >
              <span data-prada-load-more-label>Show more</span>
            </a>
            <p class="visually-hidden" role="status" aria-live="polite" data-prada-load-more-status></p>
          </div>
        {%- endif -%}
      {%- endif -%}

      {%- if paginate.current_page == 1 and collection.description != blank -%}
        <section class="prada-collection__seo" aria-labelledby="CollectionSeoHeading-{{ section.id }}">
          <h2 id="CollectionSeoHeading-{{ section.id }}" class="prada-collection__seo-title">
            {{ collection.title | escape }}
          </h2>
          <div class="prada-collection__seo-content rte">
            {{ collection.description }}
          </div>
        </section>
      {%- endif -%}
    </div>
  {%- endpaginate -%}
</collection-component>

<script>
  if (!window.pradaCollectionCarouselSetup) {
    window.pradaCollectionCarouselSetup = function (root) {
      root.querySelectorAll('[data-prada-mobile-carousel]').forEach(function (carousel) {
        if (carousel.dataset.pradaCarouselReady === 'true') return;

        var dots = carousel.parentElement.querySelectorAll('.prada-product-tile__pagination-dot');
        if (dots.length !== 2) return;

        carousel.dataset.pradaCarouselReady = 'true';
        var animationFrame;

        function updatePagination() {
          var secondImageIsActive = carousel.scrollLeft >= carousel.clientWidth / 2;
          dots[0].classList.toggle('is-active', !secondImageIsActive);
          dots[1].classList.toggle('is-active', secondImageIsActive);
          animationFrame = undefined;
        }

        carousel.addEventListener(
          'scroll',
          function () {
            if (animationFrame) return;
            animationFrame = window.requestAnimationFrame(updatePagination);
          },
          { passive: true }
        );

        updatePagination();
      });
    };

    document.addEventListener('shopify:section:load', function (event) {
      window.pradaCollectionCarouselSetup(event.target);
    });
  }

  window.pradaCollectionCarouselSetup(document);

  if (!window.pradaCollectionLoadMoreSetup) {
    window.pradaCollectionLoadMoreSetup = true;

    document.addEventListener('click', function (event) {
      var link = event.target.closest('[data-prada-load-more-link]');
      if (
        !link ||
        event.defaultPrevented ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        event.button !== 0 ||
        link.dataset.pradaLoadMoreFailed === 'true'
      ) {
        return;
      }

      var collectionRoot = link.closest('.prada-collection');
      var targetGrid = collectionRoot?.querySelector('#product-grid');
      var loadMore = link.closest('[data-prada-load-more]');
      var label = link.querySelector('[data-prada-load-more-label]');
      var status = loadMore?.querySelector('[data-prada-load-more-status]');
      if (!collectionRoot || !targetGrid || !loadMore || link.getAttribute('aria-disabled') === 'true') return;

      event.preventDefault();

      var targetUrl = new URL(link.href, window.location.origin);
      var requestUrl = new URL(targetUrl.href);
      var sectionId = collectionRoot.dataset.sectionId;
      if (sectionId) requestUrl.searchParams.set('section_id', sectionId);

      link.setAttribute('aria-disabled', 'true');
      link.classList.add('is-loading');
      if (label) label.textContent = 'Loading';
      if (status) status.textContent = 'Loading more products';

      fetch(requestUrl.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function (response) {
          if (!response.ok) throw new Error('Unable to load more products');
          return response.text();
        })
        .then(function (html) {
          var sourceDocument = new DOMParser().parseFromString(html, 'text/html');
          var sourceGrid = sourceDocument.querySelector('#product-grid');
          var sourceNextLink = sourceDocument.querySelector('[data-prada-load-more-link]');
          if (!sourceGrid) throw new Error('Product grid response is incomplete');

          var newItems = Array.from(sourceGrid.children);
          var fragment = document.createDocumentFragment();
          newItems.forEach(function (item) {
            fragment.appendChild(item);
          });
          targetGrid.appendChild(fragment);

          if (sourceNextLink) {
            link.href = new URL(sourceNextLink.getAttribute('href'), targetUrl.href).href;
            link.removeAttribute('aria-disabled');
            link.classList.remove('is-loading');
            if (label) label.textContent = 'Show more';
            if (status) status.textContent = newItems.length + ' more products loaded';
          } else {
            if (status) status.textContent = newItems.length + ' more products loaded. All products are shown.';
            loadMore.remove();
          }

          if (window.pradaCollectionCarouselSetup) window.pradaCollectionCarouselSetup(targetGrid);
          if (window.PradaWishlist) window.PradaWishlist.sync?.();
          document.dispatchEvent(new Event('prada:collection:updated'));
        })
        .catch(function () {
          link.dataset.pradaLoadMoreFailed = 'true';
          window.location.href = targetUrl.href;
        });
    });
  }

  if (!window.pradaCollectionNavigationSetup) {
    window.pradaCollectionNavigationState = window.pradaCollectionNavigationState || {
      request: null,
      navigationId: 0,
    };
    window.pradaCollectionNavigationState.cache = window.pradaCollectionNavigationState.cache || new Map();
    window.pradaCollectionNavigationState.prefetchRequests =
      window.pradaCollectionNavigationState.prefetchRequests || new Map();

    window.pradaCollectionNavigationSetup = function (root) {
      root.querySelectorAll('[data-prada-collection-tabs]').forEach(function (tabs) {
        if (tabs.dataset.pradaNavigationReady === 'true') return;

        var desktopMenu = document.querySelector('.prada-desktop-menu');
        var title = tabs.closest('.prada-collection__navigation')?.querySelector('[data-prada-collection-title]');
        var collectionRoot = tabs.closest('.prada-collection');
        if (!title || !collectionRoot) {
          tabs.dataset.pradaNavigationState = 'ready';
          document.documentElement.classList.remove('prada-collection-route-pending');
          return;
        }

        function normalizeUrl(url) {
          var rawUrl = (url || '').trim();

          if (!rawUrl || rawUrl === '#' || rawUrl.charAt(0) === '#' || /^javascript:/i.test(rawUrl)) {
            return '';
          }

          try {
            return new URL(rawUrl, window.location.origin).pathname.replace(/\/$/, '') || '/';
          } catch (error) {
            return '';
          }
        }

        function pathFromLink(link) {
          return normalizeUrl(link?.getAttribute('href') || '');
        }

        function hrefFromLink(link) {
          return pathFromLink(link) ? link.href : '';
        }

        function textFrom(element) {
          return (element?.textContent || '').replace(/\s+/g, ' ').trim();
        }

        function showcaseParentFromUrl(url) {
          try {
            return new URL(url, window.location.origin).searchParams.get('showcase_parent') || '';
          } catch (_error) {
            return '';
          }
        }

        function syncShowcaseContextInput(parentId) {
          var controls = collectionRoot.querySelector('.prada-collection__controls');
          if (!controls) return;

          var input = controls.querySelector('input[name="showcase_parent"]');
          if (!parentId) {
            input?.remove();
            return;
          }

          if (!input) {
            input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'showcase_parent';
            controls.appendChild(input);
          }
          input.value = parentId;
        }

        function cacheKeyFromUrl(url) {
          var cacheUrl = new URL(url.href, window.location.origin);
          cacheUrl.hash = '';
          cacheUrl.searchParams.delete('section_id');
          return cacheUrl.href;
        }

        function sectionRequestUrl(targetUrl) {
          var requestUrl = new URL(targetUrl.href, window.location.origin);
          var sectionId = collectionRoot.dataset.sectionId;

          if (sectionId) requestUrl.searchParams.set('section_id', sectionId);
          return requestUrl;
        }

        function fetchCollectionHtml(targetUrl, signal) {
          var requestOptions = { headers: { 'X-Requested-With': 'XMLHttpRequest' } };
          var cacheKey = cacheKeyFromUrl(targetUrl);
          if (signal) requestOptions.signal = signal;

          return fetch(sectionRequestUrl(targetUrl).href, requestOptions)
            .then(function (response) {
              if (!response.ok) throw new Error('Unable to load collection');
              return response.text();
            })
            .then(function (html) {
              if (!html || !html.includes('id="ProductGridContainer"')) {
                throw new Error('Collection section response is incomplete');
              }

              window.pradaCollectionNavigationState.cache.set(cacheKey, html);
              return html;
            });
        }

        function loadCollectionHtml(targetUrl, signal) {
          var cacheKey = cacheKeyFromUrl(targetUrl);
          var cachedHtml = window.pradaCollectionNavigationState.cache.get(cacheKey);
          var pendingPrefetch = window.pradaCollectionNavigationState.prefetchRequests.get(cacheKey);

          if (cachedHtml) return Promise.resolve(cachedHtml);
          if (pendingPrefetch) {
            return pendingPrefetch.then(function (html) {
              return html || fetchCollectionHtml(targetUrl, signal);
            });
          }

          return fetchCollectionHtml(targetUrl, signal);
        }

        function prefetchCollection(tab) {
          if (tab.dataset.pradaProductTemplate) return null;

          var targetUrl = new URL(tab.href, window.location.origin);
          var cacheKey = cacheKeyFromUrl(targetUrl);

          if (
            targetUrl.origin !== window.location.origin ||
            targetUrl.href === window.location.href ||
            window.pradaCollectionNavigationState.cache.has(cacheKey)
          ) {
            return null;
          }

          var pendingRequest = window.pradaCollectionNavigationState.prefetchRequests.get(cacheKey);
          if (pendingRequest) return pendingRequest;

          var prefetchRequest = fetchCollectionHtml(targetUrl)
            .catch(function () {
              return '';
            })
            .finally(function () {
              if (window.pradaCollectionNavigationState.prefetchRequests.get(cacheKey) === prefetchRequest) {
                window.pradaCollectionNavigationState.prefetchRequests.delete(cacheKey);
              }
            });

          window.pradaCollectionNavigationState.prefetchRequests.set(cacheKey, prefetchRequest);
          return prefetchRequest;
        }

        function enableTabPrefetch() {
          function prefetchEventTab(event) {
            var tab = event.target.closest('.prada-collection__tab');
            if (tab && tabs.contains(tab)) prefetchCollection(tab);
          }

          tabs.addEventListener('pointerover', prefetchEventTab, { passive: true });
          tabs.addEventListener('focusin', prefetchEventTab);
          tabs.addEventListener('touchstart', prefetchEventTab, { passive: true });

          if (navigator.connection?.saveData) return;

          var queuedTabs = Array.from(tabs.querySelectorAll('.prada-collection__tab:not(.is-active)'));
          function prefetchNext() {
            var nextTab = queuedTabs.shift();
            if (!nextTab) return;

            var request = prefetchCollection(nextTab);
            if (request) request.then(function () { window.setTimeout(prefetchNext, 100); });
            else prefetchNext();
          }

          if (window.requestIdleCallback) {
            window.requestIdleCallback(prefetchNext, { timeout: 1200 });
          } else {
            window.setTimeout(prefetchNext, 600);
          }
        }

        var currentCacheKey = cacheKeyFromUrl(new URL(window.location.href));
        if (!window.pradaCollectionNavigationState.cache.has(currentCacheKey)) {
          window.pradaCollectionNavigationState.cache.set(currentCacheKey, collectionRoot.outerHTML);
        }

        function makeTab(label, href, active, productTemplateId, aggregateProducts, aggregateCollectionIds) {
          var tab = document.createElement('a');
          var labelText = document.createElement('span');

          tab.className = 'prada-collection__tab' + (active ? ' is-active' : '');
          tab.href = href;
          labelText.className = 'prada-collection__tab-text';
          labelText.textContent = label;
          tab.appendChild(labelText);
          if (productTemplateId) tab.dataset.pradaProductTemplate = productTemplateId;
          if (aggregateProducts) tab.dataset.pradaAggregateProducts = 'true';
          if (aggregateCollectionIds) tab.dataset.pradaAggregateCollectionIds = aggregateCollectionIds;
          if (active) tab.setAttribute('aria-current', 'page');
          return tab;
        }

        function getTabTextElement(tab) {
          var existingText = tab.querySelector('.prada-collection__tab-text');
          if (existingText) return existingText;

          var labelText = document.createElement('span');
          labelText.className = 'prada-collection__tab-text';
          labelText.textContent = textFrom(tab);
          tab.replaceChildren(labelText);
          return labelText;
        }

        function setActiveTab(tabsElement, activeTab) {
          tabsElement.querySelectorAll('.prada-collection__tab').forEach(function (tab) {
            var isActive = tab === activeTab;
            tab.classList.toggle('is-active', isActive);
            if (isActive) tab.setAttribute('aria-current', 'page');
            else tab.removeAttribute('aria-current');
          });

          updateTabIndicator(tabsElement, activeTab);
        }

        var tabTextCanvasContext;

        function measureTabText(labelText) {
          if (!labelText) return 0;

          var text = textFrom(labelText);
          if (!text) return 0;

          if (!tabTextCanvasContext) {
            tabTextCanvasContext = document.createElement('canvas').getContext('2d');
          }

          var styles = window.getComputedStyle(labelText);
          tabTextCanvasContext.font = styles.font;

          return tabTextCanvasContext.measureText(text).width;
        }

        function updateTabIndicator(tabsElement, activeTab) {
          if (!activeTab) return;

          var tabsRect = tabsElement.getBoundingClientRect();
          var labelText = getTabTextElement(activeTab);
          var labelRect = labelText.getBoundingClientRect();
          var measuredWidth = measureTabText(labelText);
          var indicatorWidth = measuredWidth || labelRect.width || activeTab.getBoundingClientRect().width;
          var indicatorLeft = labelRect.left - tabsRect.left + tabsElement.scrollLeft;

          if (labelRect.width > indicatorWidth) {
            indicatorLeft += (labelRect.width - indicatorWidth) / 2;
          }

          tabsElement.style.setProperty(
            '--prada-tab-indicator-left',
            indicatorLeft + 'px'
          );
          tabsElement.style.setProperty(
            '--prada-tab-indicator-width',
            Math.max(indicatorWidth, 16) + 'px'
          );
        }

        function queueTabIndicatorUpdate(tabsElement) {
          window.requestAnimationFrame(function () {
            window.requestAnimationFrame(function () {
              updateTabIndicator(tabsElement, tabsElement.querySelector('.prada-collection__tab.is-active'));
            });
          });
        }

        function refreshCollectionCarousel() {
          if (window.pradaCollectionCarouselSetup) window.pradaCollectionCarouselSetup(document);
          if (window.PradaWishlist) window.PradaWishlist.sync?.();
          document.dispatchEvent(new Event('prada:collection:updated'));
        }

        function scrollCollectionToStart(collectionRoot, behavior) {
          if (!collectionRoot) return;

          var collectionTop = window.scrollY + collectionRoot.getBoundingClientRect().top;
          var reduceMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;

          window.scrollTo({
            top: Math.max(0, collectionTop),
            behavior: reduceMotion ? 'auto' : behavior || 'auto',
          });
        }

        function clearInitialCollectionPending() {
          document.documentElement.classList.remove('prada-collection-route-pending');
        }

        function setCollectionNavigationPending(isPending) {
          collectionRoot.classList.toggle('is-prada-navigation-loading', isPending);
          if (isPending) collectionRoot.setAttribute('aria-busy', 'true');
          else collectionRoot.removeAttribute('aria-busy');
        }

        function replaceCollectionContent(sourceDocument, targetUrl) {
          var sourceCollection = sourceDocument.querySelector('.prada-collection');
          var sourceGrid = sourceDocument.querySelector('#ProductGridContainer');
          var sourceCount = sourceDocument.querySelector('.prada-collection__count');
          var sourceControls = sourceDocument.querySelector('.prada-collection__controls');
          var targetCollection = document.querySelector('.prada-collection');
          var targetGrid = document.querySelector('#ProductGridContainer');
          var targetCount = document.querySelector('.prada-collection__count');
          var targetControls = document.querySelector('.prada-collection__controls');

          if (!sourceGrid || !targetGrid) return false;

          targetGrid.replaceWith(sourceGrid);
          scrollCollectionToStart(targetCollection, 'auto');

          if (sourceCount && targetCount) targetCount.replaceWith(sourceCount);
          if (sourceControls && targetControls) targetControls.replaceWith(sourceControls);
          syncShowcaseContextInput(showcaseParentFromUrl(targetUrl.href));
          if (sourceCollection && targetCollection) {
            delete targetCollection.dataset.pradaAggregateCollectionIds;
            delete targetCollection.dataset.pradaNestedActive;
            targetCollection.dataset.collectionId = sourceCollection.dataset.collectionId || targetCollection.dataset.collectionId;
            targetCollection.dataset.linkedIndexUrl = sourceCollection.dataset.linkedIndexUrl || targetCollection.dataset.linkedIndexUrl;
            targetCollection.dataset.allProductsCount = sourceCollection.dataset.allProductsCount || targetCollection.dataset.allProductsCount;
            targetCollection.dataset.nativeProductCount = sourceCollection.dataset.nativeProductCount || targetCollection.dataset.nativeProductCount;
            targetCollection.setAttribute('view-event-payload', sourceCollection.getAttribute('view-event-payload') || '');
          }

          document.title = sourceDocument.title || document.title;
          window.history.pushState({ pradaCollectionUrl: targetUrl.href }, '', targetUrl.href);
          setCollectionNavigationPending(false);
          clearInitialCollectionPending();
          refreshCollectionCarousel();

          return true;
        }

        var nestedViewAllSnapshot = null;

        function nestedTabHandle(tab) {
          return textFrom(tab)
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-|-$/g, '');
        }

        function productTemplateForTab(tab) {
          var templateId = tab?.dataset.pradaProductTemplate;
          return templateId ? document.getElementById(templateId) : null;
        }

        function captureViewAllSnapshot() {
          if (nestedViewAllSnapshot) return;

          var gridContainer = document.querySelector('#ProductGridContainer');
          var count = document.querySelector('.prada-collection__count');
          if (!gridContainer) return;

          nestedViewAllSnapshot = {
            gridContainer: gridContainer.cloneNode(true),
            count: count ? count.cloneNode(true) : null,
            path: normalizeUrl(window.location.href),
          };
        }

        function renderNestedProducts(tab, updateHistory) {
          var productTemplate = productTemplateForTab(tab);
          var currentGridContainer = document.querySelector('#ProductGridContainer');
          if (!currentGridContainer) return false;

          var aggregateCollectionIds =
            tab.dataset.pradaAggregateCollectionIds || productTemplate?.dataset.pradaAggregateCollectionIds || '';
          var hasAggregateCollections = aggregateCollectionIds.split('|').filter(Boolean).length > 0;

          if (!productTemplate && hasAggregateCollections) {
            captureViewAllSnapshot();
            currentGridContainer.querySelector('[data-prada-load-more]')?.remove();
            collectionRoot.dataset.pradaAggregateCollectionIds = aggregateCollectionIds;
            collectionRoot.dataset.pradaNestedActive = 'true';
            setActiveTab(tabs, tab);
            syncShowcaseContextInput(showcaseParentFromUrl(tab.href));
            setCollectionNavigationPending(false);
            clearInitialCollectionPending();
            refreshCollectionCarousel();

            if (updateHistory) {
              var aggregateUrl = new URL(tab.href, window.location.origin);
              window.history.pushState({ pradaAggregateCollection: true }, '', aggregateUrl.href);
            }

            scrollCollectionToStart(collectionRoot);
            return true;
          }

          if (!productTemplate) return false;

          var productItems = Array.from(productTemplate.content.children).filter(function (item) {
            return item.matches('.prada-collection__item');
          });
          if (!productItems.length && !aggregateCollectionIds) return false;

          captureViewAllSnapshot();

          var replacementContainer = currentGridContainer.cloneNode(false);
          var replacementGrid = document.createElement('ul');
          replacementGrid.className = 'prada-collection__grid';
          replacementGrid.id = 'product-grid';
          replacementGrid.dataset.id = collectionRoot.dataset.sectionId || '';
          replacementGrid.setAttribute('role', 'list');

          productItems.forEach(function (item) {
            replacementGrid.appendChild(item.cloneNode(true));
          });

          replacementContainer.appendChild(replacementGrid);
          currentGridContainer.replaceWith(replacementContainer);

          if (tab.dataset.pradaAggregateProducts === 'true' && aggregateCollectionIds) {
            collectionRoot.dataset.pradaAggregateCollectionIds = aggregateCollectionIds;
          } else {
            delete collectionRoot.dataset.pradaAggregateCollectionIds;
          }

          var count = document.querySelector('.prada-collection__count');
          var renderedProductIds = new Set();
          replacementGrid.querySelectorAll('[data-prada-product-id]').forEach(function (item) {
            if (item.dataset.pradaProductId) renderedProductIds.add(item.dataset.pradaProductId);
          });
          var renderedProductCount = renderedProductIds.size || productItems.length;
          if (count) count.textContent = renderedProductCount + (renderedProductCount === 1 ? ' product' : ' products');

          collectionRoot.dataset.pradaNestedActive = 'true';
          setActiveTab(tabs, tab);
          setCollectionNavigationPending(false);
          clearInitialCollectionPending();
          refreshCollectionCarousel();

          if (updateHistory) {
            if (tab.dataset.pradaAggregateProducts === 'true') {
              var aggregateUrl = new URL(tab.href, window.location.origin);
              window.history.pushState({ pradaAggregateCollection: true }, '', aggregateUrl.href);
            } else {
              var nestedUrl = new URL(window.location.href);
              nestedUrl.hash = 'nested-' + nestedTabHandle(tab);
              window.history.pushState({ pradaNestedCollection: nestedTabHandle(tab) }, '', nestedUrl.href);
            }
          }

          scrollCollectionToStart(collectionRoot);
          return true;
        }

        function restoreViewAllProducts(tab, targetUrl) {
          if (!nestedViewAllSnapshot) return false;

          var currentGridContainer = document.querySelector('#ProductGridContainer');
          var currentCount = document.querySelector('.prada-collection__count');
          if (!currentGridContainer) return false;

          currentGridContainer.replaceWith(nestedViewAllSnapshot.gridContainer.cloneNode(true));
          if (currentCount && nestedViewAllSnapshot.count) {
            currentCount.replaceWith(nestedViewAllSnapshot.count.cloneNode(true));
          }

          delete collectionRoot.dataset.pradaNestedActive;
          delete collectionRoot.dataset.pradaAggregateCollectionIds;
          setActiveTab(tabs, tab);
          window.history.pushState({ pradaCollectionUrl: targetUrl.href }, '', targetUrl.href);
          setCollectionNavigationPending(false);
          clearInitialCollectionPending();
          refreshCollectionCarousel();
          scrollCollectionToStart(collectionRoot);
          return true;
        }

        function navigateCollection(event) {
          var tab = event.target.closest('.prada-collection__tab');
          if (!tab || event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;

          var targetUrl = new URL(tab.href, window.location.origin);

          if (productTemplateForTab(tab) || tab.dataset.pradaAggregateCollectionIds) {
            event.preventDefault();
            if (window.pradaCollectionNavigationState.request) {
              window.pradaCollectionNavigationState.request.abort();
              window.pradaCollectionNavigationState.request = null;
            }
            window.pradaCollectionNavigationState.navigationId += 1;
            renderNestedProducts(tab, true);
            return;
          }

          if (
            collectionRoot.dataset.pradaNestedActive === 'true' &&
            nestedViewAllSnapshot?.path === normalizeUrl(targetUrl.href) &&
            normalizeUrl(targetUrl.href) === normalizeUrl(window.location.href)
          ) {
            event.preventDefault();
            restoreViewAllProducts(tab, targetUrl);
            return;
          }

          if (targetUrl.origin !== window.location.origin || targetUrl.href === window.location.href) {
            if (window.pradaCollectionNavigationState.request) {
              window.pradaCollectionNavigationState.request.abort();
              window.pradaCollectionNavigationState.request = null;
            }

            window.pradaCollectionNavigationState.navigationId += 1;
            setActiveTab(tabs, tab);
            event.preventDefault();
            scrollCollectionToStart(collectionRoot);
            return;
          }

          event.preventDefault();

          if (window.pradaCollectionNavigationState.request) {
            window.pradaCollectionNavigationState.request.abort();
          }

          var controller = new AbortController();
          var navigationId = window.pradaCollectionNavigationState.navigationId + 1;
          window.pradaCollectionNavigationState.navigationId = navigationId;
          window.pradaCollectionNavigationState.request = controller;

          setActiveTab(tabs, tab);
          setCollectionNavigationPending(true);

          loadCollectionHtml(targetUrl, controller.signal)
            .then(function (html) {
              if (
                window.pradaCollectionNavigationState.request !== controller ||
                window.pradaCollectionNavigationState.navigationId !== navigationId
              ) {
                return;
              }

              var sourceDocument = new DOMParser().parseFromString(html, 'text/html');
              if (!replaceCollectionContent(sourceDocument, targetUrl)) window.location.href = targetUrl.href;
            })
            .catch(function (error) {
              if (error.name !== 'AbortError') window.location.href = targetUrl.href;
            })
            .finally(function () {
              if (window.pradaCollectionNavigationState.request === controller) {
                window.pradaCollectionNavigationState.request = null;
              }
            });
        }

        var currentPath = normalizeUrl(window.location.href);
        var currentTitle = textFrom(title).toLowerCase();
        var match = getShowcaseNavigationMatch();

        function addUniqueTab(
          tabList,
          label,
          href,
          path,
          productTemplateId,
          aggregateProducts,
          aggregateCollectionIds
        ) {
          var normalizedLabel = (label || '').trim();
          var normalizedHref = (href || '').trim();
          var normalizedPath = path || '';

          if (!normalizedLabel || !normalizedHref) return;
          if (
            tabList.some(function (tab) {
              return (
                tab.label.toLowerCase() === normalizedLabel.toLowerCase() &&
                (tab.path || tab.href) === (normalizedPath || normalizedHref)
              );
            })
          )
            return;

          tabList.push({
            label: normalizedLabel,
            href: normalizedHref,
            path: normalizedPath,
            productTemplateId: productTemplateId || '',
            aggregateProducts: Boolean(aggregateProducts),
            aggregateCollectionIds: aggregateCollectionIds || '',
          });
        }

        function collectGrandchildTabs(grandchildPanel, tabList, fallbackHref) {
          if (!grandchildPanel) return;

          grandchildPanel
            .querySelectorAll(':scope > .prada-desktop-menu__grandchild-list > li > a')
            .forEach(function (grandchildLink) {
              var productTemplateId = grandchildLink.dataset.pradaProductTemplate;
              var grandchildPath = productTemplateId ? '' : pathFromLink(grandchildLink);
              var grandchildHref = hrefFromLink(grandchildLink) || fallbackHref;

              addUniqueTab(
                tabList,
                textFrom(grandchildLink),
                grandchildHref,
                grandchildPath,
                productTemplateId
              );
            });
        }

        function getShowcaseNavigationMatch() {
          var requestedShowcaseParent = showcaseParentFromUrl(window.location.href);
          if (!requestedShowcaseParent) return null;

          var showcase = Array.from(
            document.querySelectorAll('collection-showcase[data-showcase-active-parent]')
          ).find(function (candidate) {
            return Boolean(candidate.dataset.showcaseActiveParent);
          });
          var activeParentId = showcase?.dataset.showcaseActiveParent;
          if (!showcase || !activeParentId || activeParentId !== requestedShowcaseParent) return null;

          var panel = Array.from(showcase.querySelectorAll('[data-showcase-panel]')).find(function (candidate) {
            return candidate.dataset.showcasePanel === activeParentId;
          });
          var viewAllHref = panel?.dataset.showcaseViewAllUrl;
          if (!panel || !normalizeUrl(viewAllHref)) return null;

          var withShowcaseContext = function (href) {
            var url = new URL(href, window.location.origin);
            url.searchParams.set('showcase_parent', requestedShowcaseParent);
            return url.href;
          };
          var aggregateCollectionIds = panel.dataset.showcaseAggregateCollectionIds || '';
          var aggregateCollectionCount = aggregateCollectionIds.split('|').filter(Boolean).length;
          var contextualViewAllHref = withShowcaseContext(viewAllHref);
          var showcaseTabs = [];
          addUniqueTab(
            showcaseTabs,
            'View all',
            contextualViewAllHref,
            normalizeUrl(viewAllHref),
            '',
            aggregateCollectionCount > 1,
            aggregateCollectionCount > 1 ? aggregateCollectionIds : ''
          );

          var selectedLinks = Array.from(panel.querySelectorAll('[data-showcase-selected-navigation] a'));
          var childLinks = Array.from(panel.querySelectorAll('[data-showcase-child-card] [data-showcase-navigation-link]'));
          var navigationLinks = childLinks.concat(selectedLinks);

          navigationLinks.forEach(function (childLink) {
            var childHref = withShowcaseContext(childLink.href);
            addUniqueTab(
              showcaseTabs,
              childLink.dataset.showcaseTabLabel || textFrom(childLink),
              childHref,
              normalizeUrl(childHref)
            );
          });

          var requestedNestedHandle =
            window.location.hash.indexOf('#nested-') === 0
              ? decodeURIComponent(window.location.hash.slice(8))
              : '';
          var activeTab = requestedNestedHandle
            ? showcaseTabs.find(function (tab) {
                var tabUrl = new URL(tab.href, window.location.origin);
                return decodeURIComponent(tabUrl.hash.slice(8)) === requestedNestedHandle;
              })
            : showcaseTabs.find(function (tab) {
                return tab.label === 'View all' && tab.path === currentPath;
              });

          if (!activeTab) {
            activeTab = showcaseTabs.find(function (tab) {
              return tab.path === currentPath;
            });
          }
          if (!activeTab || showcaseTabs.length < 2) return null;

          return {
            title: panel.dataset.showcaseNavigationTitle || title.textContent,
            tabs: showcaseTabs,
            activePath: activeTab.path,
            activeTab: activeTab,
            showcaseParentId: requestedShowcaseParent,
          };
        }

        function enableNestedMenuNavigation() {
          if (!desktopMenu) return;
          var headerDrawer = desktopMenu.closest('header-drawer');
          if (!headerDrawer) return;

          if (headerDrawer.pradaNestedNavigationHandler) {
            headerDrawer.removeEventListener('click', headerDrawer.pradaNestedNavigationHandler);
          }

          headerDrawer.pradaNestedNavigationHandler = function (event) {
            var nestedLink = event.target.closest('a[data-prada-product-template]');
            if (
              !nestedLink ||
              event.defaultPrevented ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey ||
              event.button !== 0
            ) {
              return;
            }

            var templateId = nestedLink.dataset.pradaProductTemplate;
            var nestedTab = Array.from(tabs.querySelectorAll('[data-prada-product-template]')).find(function (tab) {
              return tab.dataset.pradaProductTemplate === templateId;
            });

            if (!nestedTab) return;

            event.preventDefault();
            nestedTab.click();
            headerDrawer.querySelector('[data-prada-drawer-close]')?.click();
          };

          headerDrawer.addEventListener('click', headerDrawer.pradaNestedNavigationHandler);
        }

        desktopMenu?.querySelectorAll('.prada-desktop-menu__item').forEach(function (parentItem) {
          if (match) return;

          var parentLabel = parentItem.querySelector('.prada-desktop-menu__primary-link span:first-child');
          var parentTitle = textFrom(parentLabel);
          var submenu = parentItem.querySelector(':scope > .prada-desktop-menu__submenu');
          if (!submenu) return;

          var childItems = submenu.querySelectorAll(':scope > .prada-desktop-menu__submenu-list > .prada-desktop-menu__submenu-item');
          var parentTabs = [];
          var parentViewAll = submenu.querySelector(':scope > .prada-desktop-menu__submenu-list > .prada-desktop-menu__submenu-view-all .prada-desktop-menu__view-all');
          var parentViewAllPath = pathFromLink(parentViewAll);

          if (parentViewAllPath) {
            addUniqueTab(parentTabs, 'View all', parentViewAll.href, parentViewAllPath);
          }

          childItems.forEach(function (childItem) {
            if (match) return;

            var childLabel = childItem.querySelector(':scope > .prada-desktop-menu__submenu-link[for]');
            var childLink = childItem.querySelector(':scope > a.prada-desktop-menu__submenu-link');
            var childTitle = textFrom(childLabel || childLink);
            var grandchildPanel = childItem.querySelector(':scope > .prada-desktop-menu__grandchild-panel');
            var childViewAll = grandchildPanel?.querySelector(':scope > .prada-desktop-menu__view-all');
            var childHref = hrefFromLink(childViewAll) || hrefFromLink(childLink);
            var childPath = pathFromLink(childViewAll) || pathFromLink(childLink);
            var childTitleMatchesCurrentCollection = childTitle.toLowerCase() === currentTitle;

            if (childTitle && childHref) {
              addUniqueTab(parentTabs, childTitle, childHref, childPath);
            }

            if (grandchildPanel && childViewAll && childPath) {
              var childTabs = [];
              var childViewAllTemplateId = childViewAll.dataset.pradaProductTemplate;

              addUniqueTab(
                childTabs,
                'View all',
                childViewAll.href,
                childPath,
                childViewAllTemplateId,
                childViewAll.dataset.pradaAggregateProducts === 'true',
                childViewAll.dataset.pradaAggregateCollectionIds || ''
              );
              collectGrandchildTabs(grandchildPanel, childTabs, childViewAll.href);

              var requestedNestedHandle =
                window.location.hash.indexOf('#nested-') === 0
                  ? decodeURIComponent(window.location.hash.slice(8))
                  : '';
              var activeChildTab = null;

              if (requestedNestedHandle && requestedNestedHandle !== 'view-all') {
                activeChildTab = childTabs.find(function (tab) {
                  return (
                    (tab.label || '')
                      .toLowerCase()
                      .replace(/[^a-z0-9]+/g, '-')
                      .replace(/^-|-$/g, '') === requestedNestedHandle
                  );
                });
              }

              if (!activeChildTab) {
                activeChildTab = childTabs.find(function (tab) {
                  return !tab.aggregateProducts && tab.path && tab.path === currentPath;
                });
              }

              if (!activeChildTab) {
                activeChildTab = childTabs.find(function (tab) {
                  return tab.path && tab.path === currentPath;
                });
              }

              if ((activeChildTab || childTitleMatchesCurrentCollection) && childTabs.length > 1) {
                match = {
                  title: childTitle,
                  tabs: childTabs,
                  activePath: activeChildTab ? currentPath : childPath,
                  activeTab: activeChildTab,
                };
              }
            } else if (childPath === currentPath && parentTabs.length > 1) {
              match = {
                title: parentTitle || title.textContent,
                tabs: parentTabs,
                activePath: currentPath,
              };
            }
          });

          if (!match && parentViewAllPath === currentPath && parentTabs.length > 1) {
            match = {
              title: parentTitle || title.textContent,
              tabs: parentTabs,
              activePath: currentPath,
            };
          }
        });

        if (!match || !match.tabs || match.tabs.length < 2) {
          syncShowcaseContextInput('');
          updateTabIndicator(tabs, tabs.querySelector('.prada-collection__tab.is-active'));
          // Resolve the initial indicator position while the navigation is
          // still hidden. This prevents it animating from View all on load.
          void tabs.offsetWidth;
          tabs.dataset.pradaNavigationState = 'ready';
          tabs.dataset.pradaNavigationReady = 'true';
          queueTabIndicatorUpdate(tabs);
          document.fonts?.ready?.then(function () {
            queueTabIndicatorUpdate(tabs);
          });
          tabs.addEventListener('click', navigateCollection);
          enableNestedMenuNavigation();
          enableTabPrefetch();
          window.addEventListener('resize', function () {
            queueTabIndicatorUpdate(tabs);
          });
          clearInitialCollectionPending();
          return;
        }

        syncShowcaseContextInput(match.showcaseParentId || '');
        tabs.replaceChildren();
        title.textContent = match.title;
        tabs.setAttribute('aria-label', match.title + ' categories');

        match.tabs.forEach(function (tab) {
          tabs.appendChild(
            makeTab(
              tab.label,
              tab.href,
              match.activeTab ? tab === match.activeTab : tab.path === match.activePath,
              tab.productTemplateId,
              tab.aggregateProducts,
              tab.aggregateCollectionIds
            )
          );
        });

        updateTabIndicator(tabs, tabs.querySelector('.prada-collection__tab.is-active'));
        // The rebuilt tabs already know the current URL. Commit that position
        // before revealing the navigation so only the selected tab is shown.
        void tabs.offsetWidth;
        tabs.dataset.pradaNavigationState = 'ready';
        tabs.dataset.pradaNavigationReady = 'true';
        queueTabIndicatorUpdate(tabs);
        document.fonts?.ready?.then(function () {
          queueTabIndicatorUpdate(tabs);
        });
        tabs.addEventListener('click', navigateCollection);
        enableNestedMenuNavigation();
        enableTabPrefetch();
        var initialCollectionResolutionScheduled = false;
        if (window.location.hash.indexOf('#nested-') === 0) {
          var requestedNestedHandle = decodeURIComponent(window.location.hash.slice(8));
          var requestedNestedTab = Array.from(tabs.querySelectorAll('.prada-collection__tab')).find(function (tab) {
            return nestedTabHandle(tab) === requestedNestedHandle;
          });

          if (requestedNestedTab) {
            initialCollectionResolutionScheduled = true;
            window.requestAnimationFrame(function () {
              if (productTemplateForTab(requestedNestedTab)) {
                if (!renderNestedProducts(requestedNestedTab, false)) clearInitialCollectionPending();
              } else {
                setActiveTab(tabs, requestedNestedTab);
                clearInitialCollectionPending();
                document.dispatchEvent(new Event('prada:collection:updated'));
              }
            });
          }
        } else {
          var initialAggregateTab = tabs.querySelector(
            '.prada-collection__tab.is-active[data-prada-aggregate-products="true"]'
          );
          if (initialAggregateTab) {
            initialCollectionResolutionScheduled = true;
            window.requestAnimationFrame(function () {
              if (!renderNestedProducts(initialAggregateTab, false)) clearInitialCollectionPending();
            });
          }
        }
        if (!initialCollectionResolutionScheduled) clearInitialCollectionPending();
        tabs.addEventListener('scroll', function () {
          updateTabIndicator(tabs, tabs.querySelector('.prada-collection__tab.is-active'));
        }, { passive: true });
        window.addEventListener('resize', function () {
          queueTabIndicatorUpdate(tabs);
        });
        document.dispatchEvent(new Event('prada:collection:updated'));
      });
    };

    window.addEventListener('popstate', function () {
      window.location.reload();
    });

    document.addEventListener('shopify:section:load', function (event) {
      window.pradaCollectionNavigationSetup(event.target);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener(
      'DOMContentLoaded',
      function () {
        window.pradaCollectionNavigationSetup(document);
      },
      { once: true }
    );
  } else {
    window.pradaCollectionNavigationSetup(document);
  }
</script>

{% schema %}
{
  "name": "Prada collection grid",
  "class": "section",
  "settings": [
    {
      "type": "link_list",
      "id": "subcategory_menu",
      "label": "Subcategory menu",
      "info": "Links appear beside the collection title."
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filters"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    }
  ]
}
{% endschema %}
