{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'prada-collection.css' | asset_url | stylesheet_tag }}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'prada-collection.js' | asset_url }}" defer="defer"></script>

<collection-component
  class="prada-collection"
  view-event-payload="{{ collection | standard_event_data: 'view' | escape }}"
  data-collection-id="{{ collection.id }}"
>
  {%- paginate collection.products by section.settings.products_per_page -%}
    <header class="prada-collection__header">
      <div class="prada-collection__navigation">
        <h1 class="prada-collection__title">{{ collection.title | escape }}</h1>

        <nav class="prada-collection__tabs" aria-label="{{ collection.title | escape }} categories">
          <a class="prada-collection__tab is-active" href="{{ collection.url }}" aria-current="page">View all</a>
          {%- if section.settings.subcategory_menu != blank -%}
            {%- for link in section.settings.subcategory_menu.links -%}
              <a
                class="prada-collection__tab{% if link.current or link.url == collection.url %} is-active{% endif %}"
                href="{{ link.url }}"
                {% if link.current or link.url == collection.url %}
                  aria-current="page"
                {% endif %}
              >
                {{- link.title | escape -}}
              </a>
            {%- endfor -%}
          {%- endif -%}
        </nav>
      </div>

      <div class="prada-collection__toolbar">
        <p class="prada-collection__count" aria-live="polite">
          <span data-prada-collection-count>{{ collection.products_count }}</span> products
        </p>

        {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
          <aside
            class="prada-collection__filters"
            id="main-collection-filters"
            data-id="{{ section.id }}"
            aria-label="Product filters and sorting"
          >
            {% render 'facets',
              results: collection,
              enable_filtering: section.settings.enable_filtering,
              enable_sorting: section.settings.enable_sorting,
              filter_type: 'horizontal',
              paginate: paginate
            %}
          </aside>
        {%- endif -%}
      </div>
    </header>

    <div
      class="product-grid-container prada-collection__grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      id="ProductGridContainer"
      {% if settings.animations_reveal_on_scroll %}
        data-cascade
      {% endif %}
    >
      {%- if collection.products.size == 0 -%}
        <div class="collection collection--empty prada-collection__empty" id="product-grid" data-id="{{ section.id }}">
          <div class="loading-overlay gradient"></div>
          <h2>{{ 'sections.collection_template.empty' | t }}</h2>
          <a href="{{ collection.url }}" class="underlined-link">View all products</a>
        </div>
      {%- else -%}
        <div class="collection prada-collection__products">
          <div class="loading-overlay gradient"></div>
          <ul
            id="product-grid"
            data-id="{{ section.id }}"
            class="grid product-grid prada-collection__grid grid--2-col-tablet-down grid--4-col-desktop"
          >
            {% assign skip_card_product_styles = false %}
            {%- for product in collection.products -%}
              {% assign lazy_load = false %}
              {%- if forloop.index > 4 -%}
                {% assign lazy_load = true %}
              {%- endif -%}
              <li
                class="grid__item prada-collection__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: 'square',
                  image_shape: 'default',
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: false,
                  show_rating: false,
                  lazy_load: lazy_load,
                  skip_styles: skip_card_product_styles,
                  quick_add: section.settings.quick_add,
                  section_id: section.id,
                  product_view_context: 'collection'
                %}
              </li>
              {% assign skip_card_product_styles = true %}
            {%- endfor -%}
          </ul>

          {%- if paginate.pages > 1 -%}
            {% render 'pagination', paginate: paginate, anchor: '' %}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- endpaginate -%}
</collection-component>

{% schema %}
{
  "name": "Prada collection grid",
  "class": "section",
  "settings": [
    {
      "type": "link_list",
      "id": "subcategory_menu",
      "label": "Subcategory menu",
      "info": "Links appear beside the collection title."
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "Show second product image on hover"
    },
    {
      "type": "select",
      "id": "quick_add",
      "default": "none",
      "label": "Quick add",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "standard", "label": "Standard" }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filters"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    }
  ]
}
{% endschema %}
