{{ 'prada-collection.css' | asset_url | stylesheet_tag }}

<collection-component
  class="prada-collection"
  view-event-payload="{{ collection | standard_event_data: 'view' | escape }}"
  data-collection-id="{{ collection.id }}"
>
  {%- paginate collection.products by section.settings.products_per_page -%}
    <header class="prada-collection__header">
      <div class="prada-collection__navigation">
        <h1 class="prada-collection__title">{{ collection.title | escape }}</h1>

        <nav class="prada-collection__tabs" aria-label="{{ collection.title | escape }} categories">
          <a class="prada-collection__tab is-active" href="{{ collection.url }}" aria-current="page">View all</a>
          {%- if section.settings.subcategory_menu != blank -%}
            {%- for link in section.settings.subcategory_menu.links -%}
              <a
                class="prada-collection__tab{% if link.current or link.url == collection.url %} is-active{% endif %}"
                href="{{ link.url }}"
                {% if link.current or link.url == collection.url %}
                  aria-current="page"
                {% endif %}
              >
                {{- link.title | escape -}}
              </a>
            {%- endfor -%}
          {%- endif -%}
        </nav>
      </div>

      <div class="prada-collection__toolbar">
        <p class="prada-collection__count">{{ collection.products_count }} products</p>

        <form class="prada-collection__controls" action="{{ collection.url }}" method="get">
          {%- if section.settings.enable_filtering and collection.filters != empty -%}
            <details class="prada-collection__filter-menu">
              <summary>Filters</summary>
              <div class="prada-collection__filter-panel">
                {%- for filter in collection.filters -%}
                  {%- case filter.type -%}
                    {%- when 'boolean', 'list' -%}
                      <fieldset class="prada-collection__filter-group">
                        <legend>{{ filter.label | escape }}</legend>
                        {%- for value in filter.values limit: 12 -%}
                          <label class="prada-collection__filter-option{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                            <input
                              type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              {% if value.active %}checked{% endif %}
                              {% if value.count == 0 and value.active == false %}disabled{% endif %}
                            >
                            <span>{{ value.label | escape }}</span>
                            <small>{{ value.count }}</small>
                          </label>
                        {%- endfor -%}
                      </fieldset>
                    {%- when 'price_range' -%}
                      <fieldset class="prada-collection__filter-group">
                        <legend>{{ filter.label | escape }}</legend>
                        <div class="prada-collection__price-fields">
                          <label>
                            <span>Min</span>
                            <input name="{{ filter.min_value.param_name }}" type="number" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}" min="0">
                          </label>
                          <label>
                            <span>Max</span>
                            <input name="{{ filter.max_value.param_name }}" type="number" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}" min="0">
                          </label>
                        </div>
                      </fieldset>
                  {%- endcase -%}
                {%- endfor -%}
                <button class="prada-collection__apply-filter" type="submit">Apply filters</button>
              </div>
            </details>
            <span class="prada-collection__control-divider" aria-hidden="true">&middot;</span>
          {%- endif -%}

          {%- if section.settings.enable_sorting -%}
            <label class="prada-collection__sort">
              <span>Sort by:</span>
              <select name="sort_by" aria-label="Sort products" onchange="this.form.submit()">
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value | escape }}" {% if option.value == collection.sort_by %}selected="selected"{% endif %}>
                    {{ option.name | escape }}
                  </option>
                {%- endfor -%}
              </select>
            </label>
          {%- endif -%}
        </form>
      </div>
    </header>

    <div class="prada-collection__grid-container" id="ProductGridContainer">
      {%- if collection.products.size == 0 -%}
        <div class="prada-collection__empty" id="product-grid" data-id="{{ section.id }}">
          <h2>{{ 'sections.collection_template.empty' | t }}</h2>
          <a href="{{ collection.url }}" class="underlined-link">View all products</a>
        </div>
      {%- else -%}
        <ul class="prada-collection__grid" id="product-grid" data-id="{{ section.id }}" role="list">
          {%- for product in collection.products -%}
            {%- liquid
              assign featured_tile_enabled = product.metafields.custom.featured_tile.value
              if featured_tile_enabled == blank
                assign featured_tile_enabled = product.metafields.custom.custom_featured_tile.value
              endif
              assign featured_tile_size = product.metafields.custom.featured_tile_size.value | default: 'wide' | downcase
              if product.metafields.custom.featured_tile_size.value == blank and product.metafields.custom.custom_featured_tile_size.value != blank
                assign featured_tile_size = product.metafields.custom.custom_featured_tile_size.value | downcase
              endif
              unless featured_tile_size == 'normal' or featured_tile_size == 'wide' or featured_tile_size == 'large' or featured_tile_size == 'full'
                assign featured_tile_size = 'wide'
              endunless
              assign product_grid_order = forloop.index | times: 10
              if featured_tile_enabled
                assign featured_tile_position = product.metafields.custom.featured_tile_position.value | default: forloop.index
                if product.metafields.custom.featured_tile_position.value == blank and product.metafields.custom.custom_featured_tile_position.value != blank
                  assign featured_tile_position = product.metafields.custom.custom_featured_tile_position.value
                endif
                assign featured_tile_position = featured_tile_position | at_least: 1 | at_most: collection.products.size
                assign product_grid_order = featured_tile_position | times: 10 | minus: 5
              endif
            -%}
            {%- assign secondary_media = product.media[1] -%}
            {%- assign has_secondary_image = false -%}
            {%- if secondary_media and secondary_media.media_type == 'image' -%}
              {%- assign has_secondary_image = true -%}
            {%- endif -%}
            <li
              class="prada-collection__item{% if featured_tile_enabled %} prada-collection__item--featured prada-collection__item--featured-{{ featured_tile_size }}{% endif %}"
              style="--prada-grid-order: {{ product_grid_order }};"
            >
              {%- if featured_tile_enabled -%}
                {% render 'prada-featured-product-tile', product: product %}
              {%- else -%}
              <product-component view-event-payload="{{ product | standard_event_data: 'view', context: 'collection' | escape }}">
                <article class="prada-product-tile">
                  <div class="prada-product-tile__media">
                    <a
                      class="prada-product-tile__carousel"
                      href="{{ product.url }}"
                      {% if has_secondary_image %}
                        data-prada-mobile-carousel
                      {% endif %}
                    >
                    {%- if product.featured_media -%}
                      <img
                        class="prada-product-tile__image"
                        srcset="
                          {%- if product.featured_media.width >= 360 -%}{{ product.featured_media | image_url: width: 360 }} 360w,{%- endif -%}
                          {%- if product.featured_media.width >= 533 -%}{{ product.featured_media | image_url: width: 533 }} 533w,{%- endif -%}
                          {%- if product.featured_media.width >= 720 -%}{{ product.featured_media | image_url: width: 720 }} 720w,{%- endif -%}
                          {%- if product.featured_media.width >= 940 -%}{{ product.featured_media | image_url: width: 940 }} 940w,{%- endif -%}
                          {{ product.featured_media | image_url }} {{ product.featured_media.width }}w
                        "
                        src="{{ product.featured_media | image_url: width: 720 }}"
                        sizes="(min-width: 990px) 25vw, 50vw"
                        alt="{{ product.featured_media.alt | default: product.title | escape }}"
                        {% if forloop.index > 4 %}loading="lazy"{% endif %}
                        width="{{ product.featured_media.width }}"
                        height="{{ product.featured_media.height }}"
                      >
                      {%- if has_secondary_image -%}
                        <img
                          class="prada-product-tile__image prada-product-tile__image--secondary"
                          srcset="
                            {%- if secondary_media.width >= 360 -%}{{ secondary_media | image_url: width: 360 }} 360w,{%- endif -%}
                            {%- if secondary_media.width >= 533 -%}{{ secondary_media | image_url: width: 533 }} 533w,{%- endif -%}
                            {%- if secondary_media.width >= 720 -%}{{ secondary_media | image_url: width: 720 }} 720w,{%- endif -%}
                            {%- if secondary_media.width >= 940 -%}{{ secondary_media | image_url: width: 940 }} 940w,{%- endif -%}
                            {{ secondary_media | image_url }} {{ secondary_media.width }}w
                          "
                          src="{{ secondary_media | image_url: width: 720 }}"
                          sizes="(min-width: 990px) 25vw, 50vw"
                          alt=""
                          aria-hidden="true"
                          loading="lazy"
                          decoding="async"
                          width="{{ secondary_media.width }}"
                          height="{{ secondary_media.height }}"
                        >
                      {%- endif -%}
                    {%- else -%}
                      {{ 'product-apparel-2' | placeholder_svg_tag: 'prada-product-tile__placeholder' }}
                    {%- endif -%}
                    </a>

                    {%- if has_secondary_image -%}
                      <span class="prada-product-tile__pagination" aria-hidden="true">
                        <span class="prada-product-tile__pagination-dot is-active"></span>
                        <span class="prada-product-tile__pagination-dot"></span>
                      </span>
                    {%- endif -%}
                  </div>

                  <button
                    class="prada-product-wishlist-button"
                    type="button"
                    data-prada-product-wishlist
                    data-product-id="{{ product.id }}"
                    data-product-title="{{ product.title | escape }}"
                    data-product-url="{{ product.url | escape }}"
                    data-product-image="{% if product.featured_media %}{{ product.featured_media | image_url: width: 720 | escape }}{% endif %}"
                    data-product-image-alt="{{ product.featured_media.alt | default: product.title | escape }}"
                    data-product-price="{{ product.price | money | escape }}"
                    data-product-variant-id="{{ product.selected_or_first_available_variant.id }}"
                    data-product-available="{{ product.available }}"
                    aria-label="Add {{ product.title | escape }} to wishlist"
                    aria-pressed="false"
                  >
                    <span class="svg-wrapper">{{- 'prada-wishlist.svg' | inline_asset_content -}}</span>
                  </button>

                  <div class="prada-product-tile__information">
                    <h2 class="prada-product-tile__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h2>
                    <p class="prada-product-tile__price" data-currency-price>
                      {%- if product.price_varies -%}From {% endif -%}<span class="money">{{ product.price | money }}</span>
                    </p>
                  </div>
                </article>
              </product-component>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          {% render 'pagination', paginate: paginate, anchor: '' %}
        {%- endif -%}
      {%- endif -%}
    </div>
  {%- endpaginate -%}
</collection-component>

<script>
  if (!window.pradaCollectionCarouselSetup) {
    window.pradaCollectionCarouselSetup = function (root) {
      root.querySelectorAll('[data-prada-mobile-carousel]').forEach(function (carousel) {
        if (carousel.dataset.pradaCarouselReady === 'true') return;

        var dots = carousel.parentElement.querySelectorAll('.prada-product-tile__pagination-dot');
        if (dots.length !== 2) return;

        carousel.dataset.pradaCarouselReady = 'true';
        var animationFrame;

        function updatePagination() {
          var secondImageIsActive = carousel.scrollLeft >= carousel.clientWidth / 2;
          dots[0].classList.toggle('is-active', !secondImageIsActive);
          dots[1].classList.toggle('is-active', secondImageIsActive);
          animationFrame = undefined;
        }

        carousel.addEventListener(
          'scroll',
          function () {
            if (animationFrame) return;
            animationFrame = window.requestAnimationFrame(updatePagination);
          },
          { passive: true }
        );

        updatePagination();
      });
    };

    document.addEventListener('shopify:section:load', function (event) {
      window.pradaCollectionCarouselSetup(event.target);
    });
  }

  window.pradaCollectionCarouselSetup(document);
</script>

{% schema %}
{
  "name": "Prada collection grid",
  "class": "section",
  "settings": [
    {
      "type": "link_list",
      "id": "subcategory_menu",
      "label": "Subcategory menu",
      "info": "Links appear beside the collection title."
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filters"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    }
  ]
}
{% endschema %}
