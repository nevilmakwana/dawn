{{ 'prada-shipping-policy.css' | asset_url | stylesheet_tag }}

<div class="prada-shipping-policy">
  <aside class="prada-shipping-policy__sidebar">
    <nav class="prada-shipping-policy__nav" aria-label="Customer service">
      <a href="/pages/contact">Contact us</a>
      <a href="/pages/contact?view=track-order">Track your order</a>
      <a href="/pages/contact?view=returns">Returns</a>
      <a href="/pages/contact?view=shipping-policy" aria-current="page">Shipping and delivery</a>
    </nav>
    <p class="prada-shipping-policy__support">Customer service<br>Monday – Saturday: 10:00 – 18:00</p>
  </aside>

  <section class="prada-shipping-policy__main" aria-labelledby="ShippingPolicyTitle">
    <a class="prada-shipping-policy__back" href="/pages/contact">Customer service</a>
    <h1 id="ShippingPolicyTitle" class="prada-shipping-policy__heading">Shipping and delivery</h1>
    <div class="prada-shipping-policy__lead">
      <p>Welcome to Grey Exim! We are committed to providing a seamless shopping experience, including efficient and reliable shipping services across India. Please review the shipping policy below before placing your order.</p>
    </div>

    <div class="prada-shipping-policy__accordion">
      <details class="prada-shipping-policy__item" open>
        <summary>Order processing &amp; delivery timeline</summary>
        <div class="prada-shipping-policy__answer">
          <p>At Grey Exim, products are processed on the same date of placing the order, and are typically delivered to your location within 5 to 7 working days, depending on your shipping address and courier availability.</p>
        </div>
      </details>
      <details class="prada-shipping-policy__item">
        <summary>Shipping coverage</summary>
        <div class="prada-shipping-policy__answer">
          <p>We ship across India through trusted delivery partners such as DTDC, Delhivery, DHL, and other region-specific courier or transport services to ensure efficient and secure deliveries.</p>
        </div>
      </details>
      <details class="prada-shipping-policy__item">
        <summary>Shipping charges</summary>
        <div class="prada-shipping-policy__answer">
          <p>Shipping charges, if any, will be calculated and displayed at checkout, based on your order total and delivery location. Occasionally, free shipping promotions may be available and will be clearly mentioned on the website.</p>
        </div>
      </details>
      <details class="prada-shipping-policy__item">
        <summary>Payment before dispatch</summary>
        <div class="prada-shipping-policy__answer">
          <p>All orders are dispatched only after receiving full advance payment. We accept secure online payment through Paytm, PayU, UPI, Net Banking, Debit/Credit Cards, and more.</p>
        </div>
      </details>
      <details class="prada-shipping-policy__item">
        <summary>Tracking your order</summary>
        <div class="prada-shipping-policy__answer">
          <p>Once your order is shipped, you will receive a tracking number and link via email to track your package journey. If you face any issues with tracking, our customer care team is always available to help.</p>
        </div>
      </details>
      <details class="prada-shipping-policy__item">
        <summary>Delivery delays</summary>
        <div class="prada-shipping-policy__answer">
          <p>While we strive to deliver your products within the promised timeframe, delays may occur due to weather, transport strikes, or other unforeseen circumstances. We appreciate your patience in such cases.</p>
        </div>
      </details>
      <details class="prada-shipping-policy__item">
        <summary>Contact &amp; support</summary>
        <div class="prada-shipping-policy__answer">
          <p>For shipping support, contact us through chat or email at <a href="mailto:info@greyexim.com">info@greyexim.com</a>.</p>
          <p>Opening hours:<br>Monday – Saturday, 10:00 – 18:00</p>
        </div>
      </details>
    </div>
  </section>
</div>

<script>
  (() => {
    const accordion = document.currentScript.previousElementSibling?.querySelector('.prada-shipping-policy__accordion');
    if (!accordion) return;
    accordion.addEventListener('toggle', (event) => {
      const opened = event.target;
      if (!(opened instanceof HTMLDetailsElement) || !opened.open) return;
      accordion.querySelectorAll('details[open]').forEach((item) => {
        if (item !== opened) item.open = false;
      });
    }, true);
  })();
</script>

{% schema %}
{
  "name": "Shipping policy",
  "settings": []
}
{% endschema %}
