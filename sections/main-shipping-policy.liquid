{{ 'prada-shipping-policy.css' | asset_url | stylesheet_tag }}

<div class="prada-shipping-policy">
  <aside class="prada-shipping-policy__sidebar">
    <nav class="prada-shipping-policy__nav" aria-label="Customer service">
      <a href="/pages/contact">Contact us</a>
      <a href="/pages/contact?view=track-order">Track your order</a>
      <a href="/pages/contact?view=returns">Returns</a>
      <a href="/pages/contact?view=faq" aria-current="page">FAQ</a>
    </nav>
    <p class="prada-shipping-policy__support">Customer service<br>Monday – Saturday: 10:00 – 18:00</p>
  </aside>

  <section class="prada-shipping-policy__main" aria-labelledby="ShippingPolicyTitle">
    <a class="prada-shipping-policy__back" href="/pages/contact?view=faq">FAQs</a>
    <h1 id="ShippingPolicyTitle" class="prada-shipping-policy__heading">Shipments</h1>

    <div class="prada-shipping-policy__accordion">
      <details class="prada-shipping-policy__item">
        <summary>How long will it take to receive my order?</summary>
        <div class="prada-shipping-policy__answer">
          <p>At Grey Exim, products are processed on the same date of placing the order, and are typically delivered to your location within 5 to 7 working days, depending on your shipping address and courier availability.</p>
        </div>
      </details>
      <details class="prada-shipping-policy__item">
        <summary>Are there any restrictions on deliveries?</summary>
        <div class="prada-shipping-policy__answer">
          <p>We ship across India through trusted delivery partners such as DTDC, Delhivery, DHL, and other region-specific courier or transport services to ensure efficient and secure deliveries.</p>
          <p>Delivery may be affected by courier availability, weather, transport strikes, or other unforeseen circumstances.</p>
        </div>
      </details>
      <details class="prada-shipping-policy__item">
        <summary>How can I select the shipment method?</summary>
        <div class="prada-shipping-policy__answer">
          <p>The available shipment method is determined at checkout according to your delivery location, order contents, and courier availability.</p>
        </div>
      </details>
      <details class="prada-shipping-policy__item">
        <summary>How much does shipping cost and how long does it take?</summary>
        <div class="prada-shipping-policy__answer">
          <p>Shipping charges, if any, are calculated and displayed at checkout based on your order total and delivery location. Occasionally, free shipping promotions may be available and will be clearly mentioned on the website.</p>
          <p>Orders are normally delivered within 5 to 7 working days. All orders are dispatched only after receiving full advance payment.</p>
        </div>
      </details>
      <details class="prada-shipping-policy__item">
        <summary>How can I track the shipment of my order?</summary>
        <div class="prada-shipping-policy__answer">
          <p>Once your order is shipped, you will receive a tracking number and link by email. If you face any issue, use <a href="/pages/contact?view=track-order">Track your order</a> or email <a href="mailto:info@greyexim.com">info@greyexim.com</a>.</p>
        </div>
      </details>
    </div>
  </section>
</div>

<script>
  (() => {
    const accordion = document.currentScript.previousElementSibling?.querySelector('.prada-shipping-policy__accordion');
    if (!accordion) return;
    accordion.addEventListener('toggle', (event) => {
      const opened = event.target;
      if (!(opened instanceof HTMLDetailsElement) || !opened.open) return;
      accordion.querySelectorAll('details[open]').forEach((item) => {
        if (item !== opened) item.open = false;
      });
    }, true);
  })();
</script>

{% schema %}
{
  "name": "Shipping policy",
  "settings": []
}
{% endschema %}
