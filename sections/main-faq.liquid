{{ 'section-faq.css' | asset_url | stylesheet_tag }}
{{ 'prada-support-tabs.css' | asset_url | stylesheet_tag }}

{%- assign topic_keys = 'online,account,returns,shipments,payments,privacy' | split: ',' -%}

<section class="prada-faq" data-prada-faq data-prada-support-page data-prada-support-view="faq">
  <aside class="prada-faq__sidebar" aria-label="Client service navigation">
    <nav class="prada-support-tabs" data-prada-support-tabs>
      <a href="/pages/contact#send-us-email">Contact us</a>
      <a href="/pages/contact?view=track-order">Track your order</a>
      <a href="/pages/contact?view=returns">Returns</a>
      <a class="is-active" href="/pages/contact?view=faq" aria-current="page">FAQ</a>
    </nav>
    <div class="prada-faq__hours">{{ section.settings.opening_hours }}</div>
  </aside>

  <div class="prada-faq__main">
    <div class="prada-faq__overview" data-faq-overview>
      <div class="prada-faq__content">
        <h1>{{ section.settings.suggested_heading | escape }}</h1>
        <div class="prada-faq__suggested">
          {%- for block in section.blocks -%}
            {%- if block.settings.suggested -%}
              <a href="#faq-{{ block.id }}" data-faq-question-link data-faq-topic="{{ block.settings.topic }}">{{ block.settings.question | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="prada-faq__topics">
          <h2>{{ section.settings.topics_heading | escape }}</h2>
          <div class="prada-faq__topic-list">
            <a href="#topic-online" data-faq-topic-link="online"><span aria-hidden="true">{{- 'prada-cart.svg' | inline_asset_content -}}</span><strong>Online purchase</strong><b aria-hidden="true"></b></a>
            <a href="#topic-account" data-faq-topic-link="account"><span aria-hidden="true">{{- 'prada-account.svg' | inline_asset_content -}}</span><strong>Personal account</strong><b aria-hidden="true"></b></a>
            <a href="#topic-returns" data-faq-topic-link="returns"><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 7h14v12H5zM7 3h10l2 4H5l2-4Z"/><path d="m13 12-3 3 3 3M10 15h6"/></svg></span><strong>Returns</strong><b aria-hidden="true"></b></a>
            <a href="#topic-shipments" data-faq-topic-link="shipments"><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg></span><strong>Shipments</strong><b aria-hidden="true"></b></a>
            <a href="#topic-payments" data-faq-topic-link="payments"><span aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h4"/></svg></span><strong>Payments</strong><b aria-hidden="true"></b></a>
            <a href="#topic-privacy" data-faq-topic-link="privacy"><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.6 2.9 8.1 7 10 4.1-1.9 7-5.4 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg></span><strong>Privacy &amp; cookies</strong><b aria-hidden="true"></b></a>
          </div>
        </div>
      </div>
    </div>

    <div class="prada-faq__details" data-faq-details hidden>
      <div class="prada-faq__detail-content">
        <button class="prada-faq__back" type="button" data-faq-back><span aria-hidden="true">‹</span> FAQs</button>
        {%- for topic_key in topic_keys -%}
          {%- case topic_key -%}
            {%- when 'online' -%}{%- assign topic_title = 'Online Purchases' -%}
            {%- when 'account' -%}{%- assign topic_title = 'Personal Account' -%}
            {%- when 'returns' -%}{%- assign topic_title = 'Returns' -%}
            {%- when 'shipments' -%}{%- assign topic_title = 'Shipments' -%}
            {%- when 'payments' -%}{%- assign topic_title = 'Payments' -%}
            {%- when 'privacy' -%}{%- assign topic_title = 'Privacy & Cookies' -%}
          {%- endcase -%}
          <div class="prada-faq__topic-panel" data-faq-panel="{{ topic_key }}" hidden>
            <h2>{{ topic_title }}</h2>
            <div class="prada-faq__accordions" data-prada-exclusive-accordion>
              {%- for block in section.blocks -%}
                {%- if block.settings.topic == topic_key -%}
                  <details id="faq-{{ block.id }}" {{ block.shopify_attributes }}>
                    <summary>
                      <span>{{ block.settings.question | escape }}</span>
                      <span class="prada-faq__chevron" aria-hidden="true"></span>
                    </summary>
                    <div class="prada-faq__answer">{{ block.settings.answer }}</div>
                  </details>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script src="{{ 'prada-exclusive-accordion.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'prada-support-tabs.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Prada FAQ",
  "tag": "section",
  "class": "section-prada-faq",
  "max_blocks": 50,
  "settings": [
    { "type": "text", "id": "suggested_heading", "label": "Suggested heading", "default": "Suggested Questions" },
    { "type": "text", "id": "topics_heading", "label": "Topics heading", "default": "Topics" },
    {
      "type": "richtext",
      "id": "opening_hours",
      "label": "Client service opening hours",
      "default": "<p><strong>Client Service Opening Hours:</strong><br/>Monday - Saturday: 10 am - 07 pm<br/>Sunday: Closed</p>"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ question",
      "settings": [
        {
          "type": "select",
          "id": "topic",
          "label": "Topic",
          "default": "online",
          "options": [
            { "value": "online", "label": "Online purchase" },
            { "value": "account", "label": "Personal account" },
            { "value": "returns", "label": "Returns" },
            { "value": "shipments", "label": "Shipments" }
            ,{ "value": "payments", "label": "Payments" }
            ,{ "value": "privacy", "label": "Privacy & cookies" }
          ]
        },
        { "type": "text", "id": "question", "label": "Question", "default": "How can I place an online order?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Add the items to your shopping bag, verify your selection and proceed to checkout.</p>" },
        { "type": "checkbox", "id": "suggested", "label": "Show in Suggested Questions", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Prada FAQ" }]
}
{% endschema %}
