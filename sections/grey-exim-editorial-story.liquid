{% liquid
  assign use_article = false
  if section.settings.content_source == 'article' and article != blank
    assign use_article = true
  endif

  assign story_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image
  assign story_heading = section.settings.blog_heading
  assign story_intro = section.settings.introduction
  assign story_content = section.settings.main_story
  assign story_date = section.settings.date_text

  if use_article
    if article.image != blank
      assign story_image = article.image
      assign mobile_image = article.image
    endif
    assign story_heading = article.title
    assign story_intro = blank
    if article.excerpt != blank
      assign story_intro = article.excerpt
    endif
    if article.content != blank
      assign story_content = article.content
    endif
    assign story_date = article.published_at | date: '%B %d, %Y'
  endif

  if mobile_image == blank
    assign mobile_image = story_image
  endif

  assign story_alt = section.settings.image_alt | strip
  if story_alt == blank and story_image != blank and story_image.alt != blank
    assign story_alt = story_image.alt
  endif
  if story_alt == blank
    assign story_alt = story_heading
  endif

  assign image_sizes = '(min-width: 1600px) ' | append: section.settings.image_column_width | append: 'vw, (min-width: 750px) ' | append: section.settings.image_column_width | append: 'vw, 100vw'
  assign image_style = 'object-position: ' | append: section.settings.image_alignment | append: ';'
  assign heading_tag = 'h2'
  if use_article
    assign heading_tag = 'h1'
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} {
    --ge-story-bg: {{ section.settings.background_color }};
    --ge-story-heading: {{ section.settings.heading_color }};
    --ge-story-body: {{ section.settings.body_color }};
    --ge-story-eyebrow: {{ section.settings.eyebrow_color }};
    --ge-story-cta: {{ section.settings.cta_color }};
    --ge-story-image-width: {{ section.settings.image_column_width }}%;
    --ge-story-text-max: {{ section.settings.text_max_width }}px;
    --ge-story-gap: {{ section.settings.desktop_gap }}px;
    --ge-story-text-gap: {{ section.settings.text_spacing }}px;
    --ge-story-pad-top: {{ section.settings.desktop_padding_top }}px;
    --ge-story-pad-bottom: {{ section.settings.desktop_padding_bottom }}px;
    --ge-story-mobile-gap: {{ section.settings.mobile_gap }}px;
    --ge-story-mobile-pad-top: {{ section.settings.mobile_padding_top }}px;
    --ge-story-mobile-pad-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --ge-story-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --ge-story-heading-size: {{ section.settings.heading_size_desktop }}px;
    --ge-story-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    --ge-story-intro-size: {{ section.settings.intro_size }}px;
    --ge-story-body-size: {{ section.settings.body_size }}px;
    --ge-story-cta-size: {{ section.settings.cta_size }}px;
  }

  #shopify-section-{{ section.id }} .ge-story {
    background: var(--ge-story-bg);
    color: var(--ge-story-body);
    font-family: Archivo, var(--font-body-family), sans-serif;
    overflow: hidden;
    padding-block: var(--ge-story-pad-top) var(--ge-story-pad-bottom);
  }

  #shopify-section-{{ section.id }} .ge-story__shell {
    margin-inline: auto;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .ge-story__shell--wide { max-width: 1600px; }
  #shopify-section-{{ section.id }} .ge-story__shell--contained { max-width: 1280px; }

  #shopify-section-{{ section.id }} .ge-story__grid {
    align-items: center;
    display: grid;
    gap: var(--ge-story-gap);
    grid-template-columns: minmax(0, var(--ge-story-image-width)) minmax(0, 1fr);
  }

  #shopify-section-{{ section.id }} .ge-story__grid--image-right {
    grid-template-columns: minmax(0, 1fr) minmax(0, var(--ge-story-image-width));
  }

  #shopify-section-{{ section.id }} .ge-story__grid--image-right .ge-story__media { grid-column: 2; }
  #shopify-section-{{ section.id }} .ge-story__grid--image-right .ge-story__content { grid-column: 1; grid-row: 1; }

  #shopify-section-{{ section.id }} .ge-story__media {
    background: rgba(0, 0, 0, 0.035);
    min-width: 0;
    overflow: hidden;
    position: relative;
  }

  #shopify-section-{{ section.id }} .ge-story__media--portrait { aspect-ratio: 2 / 3; }
  #shopify-section-{{ section.id }} .ge-story__media--four-five { aspect-ratio: 4 / 5; }
  #shopify-section-{{ section.id }} .ge-story__media--three-four { aspect-ratio: 3 / 4; }
  #shopify-section-{{ section.id }} .ge-story__media--square { aspect-ratio: 1 / 1; }
  #shopify-section-{{ section.id }} .ge-story__media--landscape { aspect-ratio: 16 / 9; }
  #shopify-section-{{ section.id }} .ge-story__media--four-three { aspect-ratio: 4 / 3; }
  #shopify-section-{{ section.id }} .ge-story__media--three-two { aspect-ratio: 3 / 2; }

  #shopify-section-{{ section.id }} .ge-story__image,
  #shopify-section-{{ section.id }} .ge-story__placeholder {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .ge-story__media--natural .ge-story__image,
  #shopify-section-{{ section.id }} .ge-story__media--natural .ge-story__placeholder {
    height: auto;
  }

  #shopify-section-{{ section.id }} .ge-story__content {
    display: flex;
    justify-content: center;
    min-width: 0;
    padding: clamp(24px, 4vw, 72px);
  }

  #shopify-section-{{ section.id }} .ge-story__content--left { text-align: left; }
  #shopify-section-{{ section.id }} .ge-story__content--center { text-align: center; }

  #shopify-section-{{ section.id }} .ge-story__text {
    display: flex;
    flex-direction: column;
    gap: var(--ge-story-text-gap);
    max-width: var(--ge-story-text-max);
    width: 100%;
  }

  #shopify-section-{{ section.id }} .ge-story__content--center .ge-story__text { align-items: center; }

  #shopify-section-{{ section.id }} .ge-story__eyebrow {
    color: var(--ge-story-eyebrow);
    font-size: var(--ge-story-eyebrow-size);
    font-weight: 600;
    letter-spacing: .14em;
    line-height: 1.35;
    margin: 0;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .ge-story__heading {
    color: var(--ge-story-heading);
    font-size: var(--ge-story-heading-size);
    font-weight: 600;
    letter-spacing: -.025em;
    line-height: 1.08;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .ge-story__intro {
    color: var(--ge-story-body);
    font-size: var(--ge-story-intro-size);
    font-weight: 400;
    line-height: 1.45;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .ge-story__intro p,
  #shopify-section-{{ section.id }} .ge-story__body p { margin: 0 0 .9em; }
  #shopify-section-{{ section.id }} .ge-story__intro p:last-child,
  #shopify-section-{{ section.id }} .ge-story__body p:last-child { margin-bottom: 0; }

  #shopify-section-{{ section.id }} .ge-story__body {
    color: var(--ge-story-body);
    font-size: var(--ge-story-body-size);
    font-weight: 400;
    line-height: 1.62;
    overflow-wrap: anywhere;
  }

  #shopify-section-{{ section.id }} .ge-story__body img {
    height: auto;
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .ge-story__date {
    color: var(--ge-story-body);
    font-size: max(12px, calc(var(--ge-story-body-size) - 2px));
    letter-spacing: .04em;
    margin: 0;
    opacity: .68;
  }

  #shopify-section-{{ section.id }} .ge-story__cta {
    align-items: center;
    color: var(--ge-story-cta);
    display: inline-flex;
    font-size: var(--ge-story-cta-size);
    font-weight: 600;
    gap: 10px;
    line-height: 1.3;
    text-decoration: none;
    width: fit-content;
  }

  #shopify-section-{{ section.id }} .ge-story__cta--underline {
    border-bottom: 1px solid currentColor;
    padding-bottom: 3px;
  }

  #shopify-section-{{ section.id }} .ge-story__cta svg {
    height: 1em;
    transition: transform .25s ease;
    width: 1em;
  }

  @media (hover: hover) {
    #shopify-section-{{ section.id }} .ge-story__cta:hover svg { transform: translateX(4px); }
  }

  #shopify-section-{{ section.id }} .ge-story--full-bleed .ge-story__media {
    align-self: stretch;
  }

  #shopify-section-{{ section.id }} .ge-story--full-bleed .ge-story__shell {
    max-width: none;
  }

  #shopify-section-{{ section.id }} .ge-article {
    --ge-article-ink: #111111;
    --ge-article-muted: #666666;
    --ge-article-paper: #ffffff;
    --ge-article-rule: #dedede;
    background: var(--ge-article-paper);
    color: var(--ge-article-ink);
    font-family: Archivo, var(--font-body-family), sans-serif;
    overflow: hidden;
    padding-block: clamp(52px, 6vw, 96px) clamp(72px, 8vw, 128px);
  }

  #shopify-section-{{ section.id }} .ge-article__header {
    margin-inline: auto;
    max-width: 1240px;
    padding-inline: 32px;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .ge-article__meta {
    align-items: center;
    color: var(--ge-article-muted);
    display: flex;
    flex-wrap: wrap;
    font-size: 12px;
    font-weight: 600;
    gap: 10px 16px;
    justify-content: flex-start;
    letter-spacing: .13em;
    line-height: 1.4;
    margin-bottom: clamp(20px, 2.4vw, 32px);
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .ge-article__meta a {
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .ge-article__meta-separator {
    background: currentColor;
    border-radius: 50%;
    height: 3px;
    opacity: .6;
    width: 3px;
  }

  #shopify-section-{{ section.id }} .ge-article__title {
    color: var(--ge-article-ink);
    font-size: clamp(44px, 4.7vw, 68px);
    font-weight: 500;
    letter-spacing: -.04em;
    line-height: 1.04;
    margin: 0;
    max-width: 1080px;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .ge-article__lead {
    color: var(--ge-article-muted);
    font-size: clamp(18px, 1.45vw, 21px);
    line-height: 1.6;
    margin: clamp(24px, 2.5vw, 34px) 0 0;
    max-width: 820px;
  }

  #shopify-section-{{ section.id }} .ge-article__lead > :first-child { margin-top: 0; }
  #shopify-section-{{ section.id }} .ge-article__lead > :last-child { margin-bottom: 0; }

  #shopify-section-{{ section.id }} .ge-article__hero {
    margin: clamp(44px, 5vw, 72px) auto 0;
    max-width: 1240px;
    padding-inline: 32px;
  }

  #shopify-section-{{ section.id }} .ge-article__hero picture {
    display: block;
    background: #f4f4f4;
  }

  #shopify-section-{{ section.id }} .ge-article__hero-image,
  #shopify-section-{{ section.id }} .ge-article__hero-placeholder {
    display: block;
    height: auto;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .ge-article__body {
    box-sizing: border-box;
    color: #242424;
    font-size: 18px !important;
    font-weight: 400 !important;
    line-height: 1.72 !important;
    margin: clamp(56px, 6vw, 84px) auto 0;
    max-width: 780px;
    overflow-wrap: anywhere;
    padding-inline: 30px;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .ge-article__body * {
    box-sizing: border-box;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .ge-article__body > :first-child { margin-top: 0 !important; }
  #shopify-section-{{ section.id }} .ge-article__body > :last-child { margin-bottom: 0 !important; }

  #shopify-section-{{ section.id }} .ge-article__body p,
  #shopify-section-{{ section.id }} .ge-article__body li {
    font-size: inherit !important;
    font-weight: 400 !important;
    line-height: inherit !important;
  }

  #shopify-section-{{ section.id }} .ge-article__body p {
    margin-block: 0 1.2em !important;
  }

  #shopify-section-{{ section.id }} .ge-article__body strong,
  #shopify-section-{{ section.id }} .ge-article__body b {
    color: var(--ge-article-ink);
    font-weight: 600 !important;
  }

  #shopify-section-{{ section.id }} .ge-article__body h2,
  #shopify-section-{{ section.id }} .ge-article__body h3,
  #shopify-section-{{ section.id }} .ge-article__body h4 {
    color: var(--ge-article-ink) !important;
    font-weight: 600 !important;
    letter-spacing: -.03em !important;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .ge-article__body h2 {
    font-size: clamp(30px, 2.65vw, 38px) !important;
    line-height: 1.18 !important;
    margin: 1.9em 0 .62em !important;
  }

  #shopify-section-{{ section.id }} .ge-article__body h3 {
    font-size: clamp(23px, 2vw, 28px) !important;
    line-height: 1.25 !important;
    margin: 1.7em 0 .6em !important;
  }

  #shopify-section-{{ section.id }} .ge-article__body h4 {
    font-size: 20px !important;
    line-height: 1.35 !important;
    margin: 1.55em 0 .55em !important;
  }

  #shopify-section-{{ section.id }} .ge-article__body ul,
  #shopify-section-{{ section.id }} .ge-article__body ol {
    margin: 0 0 1.4em;
    padding-left: 1.25em;
  }

  #shopify-section-{{ section.id }} .ge-article__body li {
    margin-bottom: .58em;
    padding-left: .22em;
  }

  #shopify-section-{{ section.id }} .ge-article__body li > p {
    display: inline;
    margin: 0 !important;
  }

  #shopify-section-{{ section.id }} .ge-article__body li::marker {
    color: var(--ge-article-muted);
  }

  #shopify-section-{{ section.id }} .ge-article__body div[type='empty-line'] {
    display: none;
  }

  #shopify-section-{{ section.id }} .ge-article__body a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .ge-article__body blockquote {
    border-left: 2px solid var(--ge-article-ink);
    color: var(--ge-article-ink);
    font-size: clamp(21px, 2vw, 27px) !important;
    font-style: normal;
    line-height: 1.45 !important;
    margin: 2em 0;
    padding: .15em 0 .15em clamp(20px, 3vw, 36px);
  }

  #shopify-section-{{ section.id }} .ge-article__body img {
    display: block;
    height: auto !important;
    margin: clamp(36px, 5vw, 56px) 0;
    margin-left: 50%;
    max-width: none !important;
    transform: translateX(-50%);
    width: min(1040px, calc(100vw - 64px)) !important;
  }

  #shopify-section-{{ section.id }} .ge-article__duplicate-hero {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .ge-article__body table {
    border-collapse: collapse;
    display: block;
    margin: 2em 0;
    max-width: 100%;
    overflow-x: auto;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .ge-article__body th,
  #shopify-section-{{ section.id }} .ge-article__body td {
    border: 1px solid var(--ge-article-rule);
    min-width: 150px;
    padding: 14px 16px;
    text-align: left;
    vertical-align: top;
  }

  #shopify-section-{{ section.id }} .ge-article__body iframe,
  #shopify-section-{{ section.id }} .ge-article__body video {
    display: block;
    height: auto;
    margin: 2.5em auto;
    max-width: 100%;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .ge-article__footer {
    border-top: 1px solid var(--ge-article-rule);
    margin: clamp(64px, 7vw, 96px) auto 0;
    max-width: 720px;
    padding: 28px 0 0;
  }

  #shopify-section-{{ section.id }} .ge-article__back {
    align-items: center;
    color: var(--ge-article-ink);
    display: inline-flex;
    font-size: 14px;
    font-weight: 600;
    gap: 10px;
    letter-spacing: .04em;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .ge-article__back svg {
    height: 16px;
    transition: transform .25s ease;
    width: 16px;
  }

  @media (hover: hover) {
    #shopify-section-{{ section.id }} .ge-article__meta a:hover { text-decoration: underline; }
    #shopify-section-{{ section.id }} .ge-article__back:hover svg { transform: translateX(-4px); }
  }

  #shopify-section-{{ section.id }} .ge-story--will-animate {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity .7s cubic-bezier(.22, 1, .36, 1), transform .7s cubic-bezier(.22, 1, .36, 1);
  }

  #shopify-section-{{ section.id }} .ge-story--will-animate.is-visible {
    opacity: 1;
    transform: none;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .ge-article {
      padding-block: 36px 72px;
    }

    #shopify-section-{{ section.id }} .ge-article__header {
      padding-inline: 20px;
    }

    #shopify-section-{{ section.id }} .ge-article__meta {
      font-size: 10.5px;
      gap: 8px 12px;
      margin-bottom: 16px;
    }

    #shopify-section-{{ section.id }} .ge-article__title {
      font-size: clamp(32px, 9.5vw, 42px);
      letter-spacing: -.035em;
      line-height: 1.06;
    }

    #shopify-section-{{ section.id }} .ge-article__lead {
      font-size: 17px;
      line-height: 1.55;
      margin-top: 20px;
    }

    #shopify-section-{{ section.id }} .ge-article__hero {
      margin-top: 32px;
      padding-inline: 16px;
    }

    #shopify-section-{{ section.id }} .ge-article__body {
      font-size: 17px !important;
      line-height: 1.68 !important;
      margin-top: 40px;
      padding-inline: 20px;
    }

    #shopify-section-{{ section.id }} .ge-article__body h2 {
      font-size: 28px !important;
      line-height: 1.2 !important;
      margin-top: 1.75em !important;
    }

    #shopify-section-{{ section.id }} .ge-article__body h3 {
      font-size: 23px !important;
    }

    #shopify-section-{{ section.id }} .ge-article__body div,
    #shopify-section-{{ section.id }} .ge-article__body p,
    #shopify-section-{{ section.id }} .ge-article__body span,
    #shopify-section-{{ section.id }} .ge-article__body ul,
    #shopify-section-{{ section.id }} .ge-article__body ol,
    #shopify-section-{{ section.id }} .ge-article__body li {
      height: auto !important;
      max-width: 100% !important;
      white-space: normal !important;
      width: auto !important;
    }

    #shopify-section-{{ section.id }} .ge-article__body img {
      margin-block: 32px;
      width: calc(100vw - 32px) !important;
    }

    #shopify-section-{{ section.id }} .ge-article__footer {
      margin-inline: 20px;
      margin-top: 64px;
    }

    #shopify-section-{{ section.id }} .ge-story {
      padding-block: var(--ge-story-mobile-pad-top) var(--ge-story-mobile-pad-bottom);
    }

    #shopify-section-{{ section.id }} .ge-story__grid,
    #shopify-section-{{ section.id }} .ge-story__grid--image-right {
      display: flex;
      flex-direction: column;
      gap: var(--ge-story-mobile-gap);
    }

    #shopify-section-{{ section.id }} .ge-story__media {
      order: 1;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .ge-story__content {
      order: 2;
      padding: 24px 20px 0;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .ge-story__content--mobile-left { text-align: left; }
    #shopify-section-{{ section.id }} .ge-story__content--mobile-center { text-align: center; }
    #shopify-section-{{ section.id }} .ge-story__content--mobile-left .ge-story__text { align-items: flex-start; }
    #shopify-section-{{ section.id }} .ge-story__content--mobile-center .ge-story__text { align-items: center; }

    #shopify-section-{{ section.id }} .ge-story__heading { font-size: var(--ge-story-heading-mobile); }

    #shopify-section-{{ section.id }} .ge-story__media--mobile-natural { aspect-ratio: auto; }
    #shopify-section-{{ section.id }} .ge-story__media--mobile-four-five { aspect-ratio: 4 / 5; }
    #shopify-section-{{ section.id }} .ge-story__media--mobile-three-four { aspect-ratio: 3 / 4; }
    #shopify-section-{{ section.id }} .ge-story__media--mobile-square { aspect-ratio: 1 / 1; }
    #shopify-section-{{ section.id }} .ge-story__media--mobile-four-three { aspect-ratio: 4 / 3; }

    #shopify-section-{{ section.id }} .ge-story__media--mobile-natural .ge-story__image,
    #shopify-section-{{ section.id }} .ge-story__media--mobile-natural .ge-story__placeholder { height: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .ge-story--will-animate {
      opacity: 1;
      transform: none;
      transition: none;
    }

    #shopify-section-{{ section.id }} .ge-story__cta svg { transition: none; }
  }
{% endstyle %}

{% if use_article %}
  <article
    id="GreyEditorial-{{ section.id }}"
    class="ge-article"
    data-fade="{{ section.settings.enable_fade }}"
    aria-labelledby="GreyEditorialHeading-{{ section.id }}"
  >
    <header class="ge-article__header">
      <div class="ge-article__meta">
        {% if blog.title != blank %}
          <a href="{{ blog.url }}">{{ blog.title | escape }}</a>
        {% endif %}
        {% if section.settings.show_date and story_date != blank %}
          {% if blog.title != blank %}<span class="ge-article__meta-separator" aria-hidden="true"></span>{% endif %}
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ story_date | escape }}</time>
        {% endif %}
      </div>

      {% if story_heading != blank %}
        <h1 id="GreyEditorialHeading-{{ section.id }}" class="ge-article__title">{{ story_heading | escape }}</h1>
      {% endif %}

      {% if story_intro != blank %}
        <div class="ge-article__lead rte">{{ story_intro }}</div>
      {% endif %}
    </header>

    {% if story_image != blank %}
      <figure class="ge-article__hero">
        <picture>
          {% if mobile_image != blank %}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ mobile_image | image_url: width: 375 }} 375w,
                {{ mobile_image | image_url: width: 550 }} 550w,
                {{ mobile_image | image_url: width: 750 }} 750w,
                {{ mobile_image | image_url: width: 1100 }} 1100w
              "
              sizes="100vw"
            >
          {% endif %}
          {{ story_image
            | image_url: width: 2400
            | image_tag:
              widths: '480, 720, 960, 1200, 1600, 2000, 2400',
              sizes: '(min-width: 1500px) 1344px, (min-width: 750px) calc(100vw - 96px), 100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: story_alt,
              class: 'ge-article__hero-image',
              style: image_style
          }}
        </picture>
      </figure>
    {% endif %}

    {% if story_content != blank %}
      <div class="ge-article__body rte">{{ story_content }}</div>
    {% endif %}

    {% if blog.title != blank %}
      <footer class="ge-article__footer">
        <a class="ge-article__back" href="{{ blog.url }}">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M19 12H5M11 18l-6-6 6-6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/>
          </svg>
          <span>{{ blog.title | escape }}</span>
        </a>
      </footer>
    {% endif %}
  </article>
{% else %}
  <section
    id="GreyEditorial-{{ section.id }}"
    class="ge-story{% if section.settings.full_bleed_image %} ge-story--full-bleed{% endif %}"
    data-fade="{{ section.settings.enable_fade }}"
    aria-labelledby="GreyEditorialHeading-{{ section.id }}"
  >
    <div class="ge-story__shell ge-story__shell--{{ section.settings.content_width }}">
      <div class="ge-story__grid ge-story__grid--image-{{ section.settings.image_position }}">
        <div class="ge-story__media ge-story__media--{{ section.settings.desktop_ratio }} ge-story__media--mobile-{{ section.settings.mobile_ratio }}">
          {% if story_image != blank %}
            <picture>
              {% if mobile_image != blank %}
                <source
                  media="(max-width: 749px)"
                  srcset="
                    {{ mobile_image | image_url: width: 375 }} 375w,
                    {{ mobile_image | image_url: width: 550 }} 550w,
                    {{ mobile_image | image_url: width: 750 }} 750w,
                    {{ mobile_image | image_url: width: 1100 }} 1100w
                  "
                  sizes="100vw"
                >
              {% endif %}
              {{ story_image
                | image_url: width: 2400
                | image_tag:
                  widths: '480, 720, 960, 1200, 1600, 2000, 2400',
                  sizes: image_sizes,
                  loading: 'lazy',
                  alt: story_alt,
                  class: 'ge-story__image',
                  style: image_style
              }}
            </picture>
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'ge-story__placeholder' }}
          {% endif %}
        </div>

        <div class="ge-story__content ge-story__content--{{ section.settings.desktop_alignment }} ge-story__content--mobile-{{ section.settings.mobile_alignment }}">
          <div class="ge-story__text">
            {% if section.settings.eyebrow != blank %}
              <p class="ge-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>
            {% endif %}

            {% if story_heading != blank %}
              <{{ heading_tag }} id="GreyEditorialHeading-{{ section.id }}" class="ge-story__heading">{{ story_heading | escape }}</{{ heading_tag }}>
            {% endif %}

            {% if story_intro != blank %}
              <div class="ge-story__intro">{{ story_intro | escape | newline_to_br }}</div>
            {% endif %}

            {% if story_content != blank %}
              <div class="ge-story__body rte">{{ story_content }}</div>
            {% endif %}

            {% if section.settings.show_date and story_date != blank %}
              <p class="ge-story__date">{{ story_date | escape }}</p>
            {% endif %}

            {% if section.settings.show_cta and section.settings.cta_label != blank and section.settings.cta_link != blank %}
              <a class="ge-story__cta ge-story__cta--{{ section.settings.cta_style }}" href="{{ section.settings.cta_link }}">
                <span>{{ section.settings.cta_label | escape }}</span>
                {% if section.settings.cta_style == 'arrow' %}
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/>
                  </svg>
                {% endif %}
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </section>
{% endif %}

{% if use_article and story_image != blank %}
  <script>
    (() => {
      const articleSection = document.getElementById('GreyEditorial-{{ section.id }}');
      if (!articleSection) return;

      const heroImage = articleSection.querySelector('.ge-article__hero-image');
      const firstBodyImage = articleSection.querySelector('.ge-article__body img');
      if (!heroImage || !firstBodyImage) return;

      const assetName = (source) => {
        try {
          const pathname = new URL(source, window.location.href).pathname;
          return pathname.split('/').pop().replace(/\.[^.]+$/, '');
        } catch (error) {
          return '';
        }
      };

      if (assetName(heroImage.currentSrc || heroImage.src) !== assetName(firstBodyImage.currentSrc || firstBodyImage.src)) return;

      const duplicateWrapper = firstBodyImage.closest('figure, p');
      (duplicateWrapper || firstBodyImage).classList.add('ge-article__duplicate-hero');
    })();
  </script>
{% endif %}

{% if section.settings.enable_fade %}
  <script>
    (() => {
      const section = document.getElementById('GreyEditorial-{{ section.id }}');
      if (!section || section.dataset.fade !== 'true') return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        section.classList.add('is-visible');
        return;
      }
      section.classList.add('ge-story--will-animate');
      const observer = new IntersectionObserver((entries) => {
        if (!entries[0].isIntersecting) return;
        section.classList.add('is-visible');
        observer.disconnect();
      }, { threshold: 0.12 });
      observer.observe(section);
    })();
  </script>
{% endif %}

{% schema %}
{
