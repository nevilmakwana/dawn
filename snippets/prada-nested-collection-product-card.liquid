{% doc %}
  Renders a Prada collection product tile using the variant linked to the collection context.

  @param {product} product - Product to render.
  @param {collection} [collection_context] - Collection used to select the linked variant.
  @param {number} [card_index] - One-based visible card position used for image loading priority.
{% enddoc %}

{%- liquid
  assign card_collection = collection_context | default: collection
  assign collection_variant = blank
  assign effective_card_index = card_index | default: 1
  assign primary_loading = 'lazy'
  assign primary_fetchpriority = 'low'
  if effective_card_index <= 4
    assign primary_loading = 'eager'
    assign primary_fetchpriority = 'auto'
  endif
  if effective_card_index == 1
    assign primary_fetchpriority = 'high'
  endif

  for candidate_variant in product.variants
    assign candidate_collection_refs = candidate_variant.metafields.custom.linked_collections.value
    if candidate_collection_refs == blank
      assign candidate_collection_refs = candidate_variant.metafields.custom.custom_linked_collections.value
    endif
    for candidate_collection in candidate_collection_refs
      if candidate_collection.id == card_collection.id
        assign collection_variant = candidate_variant
        break
      endif
    endfor
    if collection_variant != blank
      break
    endif
  endfor

  if collection_variant == blank
    assign collection_variant = product.selected_or_first_available_variant
  endif

  assign collection_product_base_url = product.url | split: '?' | first
  assign collection_product_url = collection_product_base_url | append: '?variant=' | append: collection_variant.id
  assign primary_media = blank
  assign secondary_media = blank
  assign collection_variant_gallery = collection_variant.metafields.custom.variant_images.value
  if collection_variant_gallery == blank
    assign collection_variant_gallery = collection_variant.metafields.custom.custom_variant_images.value
  endif
  for variant_media in collection_variant_gallery
    if variant_media.media_type == 'image'
      if primary_media == blank
        assign primary_media = variant_media
      elsif secondary_media == blank
        assign secondary_media = variant_media
        break
      endif
    endif
  endfor
  if primary_media == blank
    assign primary_media = collection_variant.featured_media | default: product.featured_media
    assign secondary_media = product.media[1]
  endif

  assign has_secondary_image = false
  if secondary_media and secondary_media.media_type == 'image'
    assign has_secondary_image = true
  endif
-%}

<li
  class="prada-collection__item"
  data-prada-product-id="{{ product.id }}"
  data-prada-nested-product-id="{{ product.id }}"
  data-prada-product-title="{{ product.title | escape }}"
  data-prada-product-price="{{ collection_variant.price }}"
>
  <product-component view-event-payload="{{ product | standard_event_data: 'view', context: 'collection' | escape }}">
    <article class="prada-product-tile">
      <div class="prada-product-tile__media">
        <a
          class="prada-product-tile__carousel"
          href="{{ collection_product_url }}"
          {% if has_secondary_image %}data-prada-mobile-carousel{% endif %}
        >
          {%- if primary_media -%}
            {%- assign primary_image_width = primary_media.width | at_most: 900 -%}
            <img
              class="prada-product-tile__image"
              srcset="
                {%- if primary_media.width > 360 -%}{{ primary_media | image_url: width: 360 }} 360w,{%- endif -%}
                {%- if primary_media.width > 540 -%}{{ primary_media | image_url: width: 540 }} 540w,{%- endif -%}
                {%- if primary_media.width > 720 -%}{{ primary_media | image_url: width: 720 }} 720w,{%- endif -%}
                {{ primary_media | image_url: width: primary_image_width }} {{ primary_image_width }}w
              "
              src="{{ primary_media | image_url: width: 540 }}"
              sizes="(max-width: 749px) calc(50vw - 16px), (max-width: 989px) 30vw, 25vw"
              alt="{{ primary_media.alt | default: product.title | escape }}"
              loading="{{ primary_loading }}"
              fetchpriority="{{ primary_fetchpriority }}"
              decoding="async"
              width="{{ primary_media.width }}"
              height="{{ primary_media.height }}"
            >
            {%- if has_secondary_image -%}
              {%- assign secondary_image_width = secondary_media.width | at_most: 900 -%}
              <img
                class="prada-product-tile__image prada-product-tile__image--secondary"
                srcset="
                  {%- if secondary_media.width > 360 -%}{{ secondary_media | image_url: width: 360 }} 360w,{%- endif -%}
                  {%- if secondary_media.width > 540 -%}{{ secondary_media | image_url: width: 540 }} 540w,{%- endif -%}
                  {%- if secondary_media.width > 720 -%}{{ secondary_media | image_url: width: 720 }} 720w,{%- endif -%}
                  {{ secondary_media | image_url: width: secondary_image_width }} {{ secondary_image_width }}w
                "
                src="{{ secondary_media | image_url: width: 540 }}"
                sizes="(max-width: 749px) calc(50vw - 16px), (max-width: 989px) 30vw, 25vw"
                alt=""
                aria-hidden="true"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
                width="{{ secondary_media.width }}"
                height="{{ secondary_media.height }}"
              >
            {%- endif -%}
          {%- else -%}
            {{ 'product-apparel-2' | placeholder_svg_tag: 'prada-product-tile__placeholder' }}
          {%- endif -%}
        </a>

        {%- if has_secondary_image -%}
          <span class="prada-product-tile__pagination" aria-hidden="true">
            <span class="prada-product-tile__pagination-dot is-active"></span>
            <span class="prada-product-tile__pagination-dot"></span>
          </span>
        {%- endif -%}
      </div>

      <button
        class="prada-product-wishlist-button"
        type="button"
        data-prada-product-wishlist
        data-product-id="{{ product.id }}"
        data-product-title="{{ product.title | escape }}"
        data-product-url="{{ collection_product_url | escape }}"
        data-product-image="{% if primary_media %}{{ primary_media | image_url: width: 720 | escape }}{% endif %}"
        data-product-image-alt="{{ primary_media.alt | default: product.title | escape }}"
        data-product-price="{{ collection_variant.price | money | strip_html | escape }}"
        data-product-variant-id="{{ collection_variant.id }}"
        data-product-available="{{ collection_variant.available }}"
        aria-label="Add {{ product.title | escape }} to wishlist"
        aria-pressed="false"
      >
        <span class="svg-wrapper">{{- 'prada-wishlist.svg' | inline_asset_content -}}</span>
      </button>

      <div class="prada-product-tile__information">
        <h2 class="prada-product-tile__title"><a href="{{ collection_product_url }}">{{ product.title | escape }}</a></h2>
        <p class="prada-product-tile__price" data-currency-price>
          <span class="money">{{ collection_variant.price | money }}</span>
        </p>
        {% render 'prada-collection-color-swatches', product: product, selected_variant: collection_variant %}
      </div>
    </article>
  </product-component>
</li>
