{% comment %}
  Renders one media item from a variant's custom.variant_images metafield.

  Accepts:
  - media: A MediaImage or Video file reference
  - section_id: Product section ID
  - variant_id: Product variant ID
  - position: One-based position in the variant gallery
  - loading: Native image loading mode (optional, defaults to lazy)
  - fetchpriority: Browser fetch priority (optional, defaults to low)
  - preload: Send a responsive preload hint for this image (optional)
{% endcomment %}

{%- liquid
  assign media_loading = loading | default: 'lazy'
  assign media_fetch_priority = fetchpriority | default: 'low'
  assign mobile_image_width = media.preview_image.width | at_most: 720
  assign media_preload = false
  if preload == true
    assign media_preload = true
  endif
-%}

<figure
  class="prada-product__media prada-product__media--{{ media.media_type }}"
  id="PradaVariantMedia-{{ section_id }}-{{ variant_id }}-{{ position }}"
  data-prada-media-label="View {{ media.media_type | replace: '_', ' ' }} {{ position }}"
>
  {%- case media.media_type -%}
    {%- when 'image' -%}
      <picture style="display: contents;">
        <source
          data-prada-mobile-source
          media="(max-width: 749px)"
          srcset="
            {%- if media.preview_image.width >= 360 -%}{{ media.preview_image | image_url: width: 360 }} 360w,{%- endif -%}
            {%- if media.preview_image.width >= 480 -%}{{ media.preview_image | image_url: width: 480 }} 480w,{%- endif -%}
            {%- if media.preview_image.width >= 550 -%}{{ media.preview_image | image_url: width: 550 }} 550w,{%- endif -%}
            {%- if media.preview_image.width >= 640 -%}{{ media.preview_image | image_url: width: 640 }} 640w,{%- endif -%}
            {{ media.preview_image | image_url: width: mobile_image_width }} {{ mobile_image_width }}w
          "
          sizes="100vw"
        >
        {{ media.preview_image | image_url: width: 1800 | image_tag:
          loading: media_loading,
          fetchpriority: media_fetch_priority,
          preload: media_preload,
          widths: '360, 480, 550, 640, 750, 950, 1200, 1500, 1800',
          sizes: '(min-width: 990px) 50vw, 100vw',
          alt: media.alt | default: product.title,
          class: 'prada-product__gallery-image'
        }}
      </picture>
    {%- when 'video' -%}
      {{ media | video_tag: controls: false, autoplay: true, loop: true, muted: true, playsinline: true, preload: 'metadata', image_size: '1200x' }}
  {%- endcase -%}
</figure>
