{% comment %}
  Renders a header drawer menu for mobile and desktop.

  Usage:
  {% render 'header-drawer' %}
{% endcomment %}

{%- liquid
  assign is_wishlist_view = false
  if template.suffix == 'wishlist'
    assign is_wishlist_view = true
  endif

  assign has_editor_drawer_menu = false
  for block in section.blocks
    if block.type == 'drawer_parent' and block.settings.title != blank
      assign has_editor_drawer_menu = true
      break
    endif
  endfor
-%}

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link prada-menu-summary"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span class="prada-menu-icon-wrapper">
        {{- 'prada-menu.svg' | inline_asset_content -}}
        {{- 'prada-close.svg' | inline_asset_content -}}
      </span>
    </summary>
    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">
          <nav class="prada-desktop-menu" aria-label="{{ 'sections.header.menu' | t }}">
            <div class="prada-desktop-menu__toolbar">
              <button type="button" class="prada-desktop-menu__toolbar-button" data-prada-drawer-close>
                <span class="prada-desktop-menu__toolbar-icon">
                  {{- 'prada-close.svg' | inline_asset_content -}}
                </span>
                <span>Close</span>
              </button>
              <button type="button" class="prada-desktop-menu__toolbar-button" data-prada-drawer-search>
                <span class="prada-desktop-menu__toolbar-icon">
                  {{- 'prada-search.svg' | inline_asset_content -}}
                </span>
                <span>Search</span>
              </button>
            </div>

            <div class="prada-desktop-menu__primary" role="list">
              {%- if has_editor_drawer_menu -%}
                {%- for parent_block in section.blocks -%}
                  {%- if parent_block.type == 'drawer_parent' and parent_block.settings.title != blank -%}
                    {%- liquid
                      assign parent_title = parent_block.settings.title
                      assign parent_key = parent_title | handleize
                      assign parent_url = parent_block.settings.link | default: '#'
                      assign has_child_blocks = false
                      assign parent_has_grandchild_blocks = false
                      assign scan_parent_children = false
                      for child_check_block in section.blocks
                        if child_check_block.id == parent_block.id
                          assign scan_parent_children = true
                        elsif scan_parent_children and child_check_block.type == 'drawer_parent'
                          break
                        elsif scan_parent_children and child_check_block.type == 'drawer_child' and child_check_block.settings.title != blank
                          assign has_child_blocks = true
                          assign scan_child_grandchildren = false
                          for grandchild_check_block in section.blocks
                            if grandchild_check_block.id == child_check_block.id
                              assign scan_child_grandchildren = true
                            elsif scan_child_grandchildren and grandchild_check_block.type == 'drawer_parent'
                              break
                            elsif scan_child_grandchildren and grandchild_check_block.type == 'drawer_child'
                              break
                            elsif scan_child_grandchildren and grandchild_check_block.type == 'drawer_grandchild' and grandchild_check_block.settings.title != blank
                              assign parent_has_grandchild_blocks = true
                              break
                            endif
                          endfor
                        endif
                      endfor
                    -%}
                    <div class="prada-desktop-menu__item{% if has_child_blocks %} has-submenu{% endif %}" role="listitem" {{ parent_block.shopify_attributes }}>
                      {%- if has_child_blocks -%}
                        <input
                          class="prada-desktop-menu__primary-control"
                          type="radio"
                          name="PradaDesktopMenu-{{ section.id }}"
                          id="PradaDesktopMenu-{{ section.id }}-{{ parent_block.id }}"
                        >
                        <label
                          class="prada-desktop-menu__primary-link"
                          for="PradaDesktopMenu-{{ section.id }}-{{ parent_block.id }}"
                          aria-controls="PradaDesktopMenuPanel-{{ section.id }}-{{ parent_block.id }}"
                        >
                          <span>{{ parent_title | escape }}</span>
                          <span class="prada-desktop-menu__chevron" aria-hidden="true">
                            <svg viewBox="0 0 16 16" focusable="false">
                              <path d="M6 3.5 10.5 8 6 12.5" />
                            </svg>
                          </span>
                        </label>
                        <div class="prada-desktop-menu__submenu" id="PradaDesktopMenuPanel-{{ section.id }}-{{ parent_block.id }}" aria-label="{{ parent_title | escape }}">
                          <ul class="prada-desktop-menu__submenu-list" role="list">
                            {%- unless parent_has_grandchild_blocks -%}
                              <li class="prada-desktop-menu__submenu-view-all">
                                <a class="prada-desktop-menu__view-all" href="{{ parent_url }}">View all</a>
                              </li>
                            {%- endunless -%}
                            {%- assign scan_parent_children = false -%}
                            {%- for child_block in section.blocks -%}
                              {%- liquid
                                assign child_title = child_block.settings.title
                                assign child_key = child_title | handleize
                                assign child_url = child_block.settings.link | default: '#'
                                assign has_grandchild_blocks = false
                              -%}
                              {%- if child_block.id == parent_block.id -%}
                                {%- assign scan_parent_children = true -%}
                              {%- elsif scan_parent_children and child_block.type == 'drawer_parent' -%}
                                {%- break -%}
                              {%- elsif scan_parent_children and child_block.type == 'drawer_child' and child_title != blank -%}
                                {%- liquid
                                  assign scan_child_grandchildren = false
                                  for grandchild_check_block in section.blocks
                                    if grandchild_check_block.id == child_block.id
                                      assign scan_child_grandchildren = true
                                    elsif scan_child_grandchildren and grandchild_check_block.type == 'drawer_parent'
                                      break
                                    elsif scan_child_grandchildren and grandchild_check_block.type == 'drawer_child'
                                      break
                                    elsif scan_child_grandchildren and grandchild_check_block.type == 'drawer_grandchild' and grandchild_check_block.settings.title != blank
                                      assign has_grandchild_blocks = true
                                      break
                                    endif
                                  endfor
                                -%}
                                <li class="prada-desktop-menu__submenu-item{% if has_grandchild_blocks %} has-grandchildren{% endif %}" {{ child_block.shopify_attributes }}>
                                  {%- if has_grandchild_blocks -%}
                                    <input
                                      class="prada-desktop-menu__submenu-control"
                                      type="radio"
                                      name="PradaDesktopSubMenu-{{ section.id }}-{{ parent_block.id }}"
                                      id="PradaDesktopSubMenu-{{ section.id }}-{{ parent_block.id }}-{{ child_block.id }}"
                                    >
                                    <label
                                      class="prada-desktop-menu__submenu-link"
                                      for="PradaDesktopSubMenu-{{ section.id }}-{{ parent_block.id }}-{{ child_block.id }}"
                                      aria-controls="PradaDesktopGrandchildPanel-{{ section.id }}-{{ parent_block.id }}-{{ child_block.id }}"
                                    >
                                      <span>{{ child_title | escape }}</span>
                                      <span class="prada-desktop-menu__chevron" aria-hidden="true">
                                        <svg viewBox="0 0 16 16" focusable="false">
                                          <path d="M6 3.5 10.5 8 6 12.5" />
                                        </svg>
                                      </span>
                                    </label>
                                    <div
                                      class="prada-desktop-menu__grandchild-panel"
                                      id="PradaDesktopGrandchildPanel-{{ section.id }}-{{ parent_block.id }}-{{ child_block.id }}"
                                      aria-label="{{ child_title | escape }}"
                                    >
                                      <a class="prada-desktop-menu__view-all" href="{{ child_url }}">View all</a>
                                      <ul class="prada-desktop-menu__grandchild-list" role="list">
                                        {%- assign scan_child_grandchildren = false -%}
                                        {%- for grandchild_block in section.blocks -%}
                                          {%- liquid
                                            assign grandchild_title = grandchild_block.settings.title
                                            assign grandchild_url = grandchild_block.settings.link | default: '#'
                                          -%}
                                          {%- if grandchild_block.id == child_block.id -%}
                                            {%- assign scan_child_grandchildren = true -%}
                                          {%- elsif scan_child_grandchildren and grandchild_block.type == 'drawer_parent' -%}
                                            {%- break -%}
                                          {%- elsif scan_child_grandchildren and grandchild_block.type == 'drawer_child' -%}
                                            {%- break -%}
                                          {%- elsif scan_child_grandchildren and grandchild_block.type == 'drawer_grandchild' and grandchild_title != blank -%}
                                            <li {{ grandchild_block.shopify_attributes }}>
                                              <a href="{{ grandchild_url }}">
                                                {{ grandchild_title | escape }}
                                              </a>
                                            </li>
                                          {%- endif -%}
                                        {%- endfor -%}
                                      </ul>
                                    </div>
                                  {%- else -%}
                                    <a class="prada-desktop-menu__submenu-link" href="{{ child_url }}">
                                      {{ child_title | escape }}
                                    </a>
                                  {%- endif -%}
                                </li>
                              {%- endif -%}
                            {%- endfor -%}
                          </ul>
                        </div>
                      {%- else -%}
                        <a class="prada-desktop-menu__primary-link" href="{{ parent_url }}">
                          <span>{{ parent_title | escape }}</span>
                        </a>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
              {%- for link in section.settings.menu.links -%}
                {%- liquid
                  assign parent_has_grandchild_links = false
                  for childlink_check in link.links
                    if childlink_check.links != blank
                      assign parent_has_grandchild_links = true
                      break
                    endif
                  endfor
                -%}
                <div class="prada-desktop-menu__item{% if link.links != blank %} has-submenu{% endif %}" role="listitem">
                  {%- if link.links != blank -%}
                    <input
                      class="prada-desktop-menu__primary-control"
                      type="radio"
                      name="PradaDesktopMenu-{{ section.id }}"
                      id="PradaDesktopMenu-{{ section.id }}-{{ forloop.index }}"
                    >
                    <label
                      class="prada-desktop-menu__primary-link"
                      for="PradaDesktopMenu-{{ section.id }}-{{ forloop.index }}"
                      aria-controls="PradaDesktopMenuPanel-{{ section.id }}-{{ forloop.index }}"
                    >
                      <span>{{ link.title | escape }}</span>
                      <span class="prada-desktop-menu__chevron" aria-hidden="true">
                        <svg viewBox="0 0 16 16" focusable="false">
                          <path d="M6 3.5 10.5 8 6 12.5" />
                        </svg>
                      </span>
                    </label>
                    <div class="prada-desktop-menu__submenu" id="PradaDesktopMenuPanel-{{ section.id }}-{{ forloop.index }}" aria-label="{{ link.title | escape }}">
                      <ul class="prada-desktop-menu__submenu-list" role="list">
                        {%- unless parent_has_grandchild_links -%}
                          <li class="prada-desktop-menu__submenu-view-all">
                            <a class="prada-desktop-menu__view-all" href="{{ link.url }}">View all</a>
                          </li>
                        {%- endunless -%}
                        {%- for childlink in link.links -%}
                          <li class="prada-desktop-menu__submenu-item{% if childlink.links != blank %} has-grandchildren{% endif %}">
                            {%- if childlink.links != blank -%}
                              <input
                                class="prada-desktop-menu__submenu-control"
                                type="radio"
                                name="PradaDesktopSubMenu-{{ section.id }}-{{ forloop.parentloop.index }}"
                                id="PradaDesktopSubMenu-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}"
                              >
                              <label
                                class="prada-desktop-menu__submenu-link"
                                for="PradaDesktopSubMenu-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}"
                                aria-controls="PradaDesktopGrandchildPanel-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}"
                              >
                                <span>{{ childlink.title | escape }}</span>
                                <span class="prada-desktop-menu__chevron" aria-hidden="true">
                                  <svg viewBox="0 0 16 16" focusable="false">
                                    <path d="M6 3.5 10.5 8 6 12.5" />
                                  </svg>
                                </span>
                              </label>
                              <div
                                class="prada-desktop-menu__grandchild-panel"
                                id="PradaDesktopGrandchildPanel-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}"
                                aria-label="{{ childlink.title | escape }}"
                              >
                                <a class="prada-desktop-menu__view-all" href="{{ childlink.url }}">View all</a>
                                <ul class="prada-desktop-menu__grandchild-list" role="list">
                                  {%- for grandchildlink in childlink.links -%}
                                    <li>
                                      <a href="{{ grandchildlink.url }}"{% if grandchildlink.current %} aria-current="page"{% endif %}>
                                        {{ grandchildlink.title | escape }}
                                      </a>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              </div>
                            {%- else -%}
                              <a class="prada-desktop-menu__submenu-link" href="{{ childlink.url }}"{% if childlink.current %} aria-current="page"{% endif %}>
                                {{ childlink.title | escape }}
                              </a>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  {%- else -%}
                    <a class="prada-desktop-menu__primary-link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
                      <span>{{ link.title | escape }}</span>
                    </a>
                  {%- endif -%}
                </div>
              {%- endfor -%}
              {%- endif -%}
            </div>

            <div class="prada-desktop-menu__utility">
              {%- if shop.customer_accounts_enabled -%}
                <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" rel="nofollow">
                  {{- 'prada-account.svg' | inline_asset_content -}}
                  <span>{% if customer %}Account{% else %}Log in or Register{% endif %}</span>
                </a>
              {%- endif -%}
              <a href="{{ routes.cart_url }}" class="prada-desktop-menu__utility-row">
                {{- 'prada-cart.svg' | inline_asset_content -}}
                <span>Shopping bag</span>
                <span class="prada-desktop-menu__utility-count{% if cart.item_count == 0 %} is-hidden{% endif %}" data-prada-drawer-cart-count aria-label="{{ cart.item_count }} items in shopping bag">
                  <span aria-hidden="true"></span>{{ cart.item_count }}
                </span>
              </a>
              <a href="{{ routes.all_products_collection_url }}?view=wishlist" class="prada-desktop-menu__utility-row" aria-label="View your wish list">
                {{- 'prada-wishlist.svg' | inline_asset_content -}}
                <span>Wishlist</span>
                <span class="prada-desktop-menu__utility-count is-hidden" data-prada-drawer-wishlist-count aria-label="0 items in wishlist">
                  <span aria-hidden="true"></span>0
                </span>
              </a>
              <a href="/pages/contact">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 3.5 9 8.2 6.9 9.8c1.5 3.1 4 5.6 7.1 7.1l1.7-2.1 4.8 2.4-.7 3.2c-.2.8-.9 1.3-1.7 1.3C9.4 21.7 2.3 14.6 2.3 5.9c0-.8.5-1.5 1.3-1.7l3-.7Z"/></svg>
                <span>Contact us</span>
              </a>
              <button type="button" class="prada-desktop-menu__utility-row prada-desktop-menu__localization" data-prada-localization-open aria-haspopup="dialog">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.4 2.3 3.6 5.2 3.6 8.5S14.4 18.2 12 20.5M12 3.5C9.6 5.8 8.4 8.7 8.4 12s1.2 6.2 3.6 8.5"/></svg>
                <span>{{ localization.country.name | escape }} / {{ localization.language.endonym_name | capitalize | escape }}</span>
              </button>
            </div>
          </nav>
          <nav class="menu-drawer__navigation">
            <ul class="menu-drawer__menu has-submenu list-menu" role="list">
              {%- if has_editor_drawer_menu -%}
                {%- for parent_block in section.blocks -%}
                  {%- if parent_block.type == 'drawer_parent' and parent_block.settings.title != blank -%}
                    {%- liquid
                      assign parent_title = parent_block.settings.title
                      assign parent_key = parent_title | handleize
                      assign parent_url = parent_block.settings.link | default: '#'
                      assign has_child_blocks = false
                      assign scan_parent_children = false
                      for child_check_block in section.blocks
                        if child_check_block.id == parent_block.id
                          assign scan_parent_children = true
                        elsif scan_parent_children and child_check_block.type == 'drawer_parent'
                          break
                        elsif scan_parent_children and child_check_block.type == 'drawer_child' and child_check_block.settings.title != blank
                          assign has_child_blocks = true
                          break
                        endif
                      endfor
                    -%}
                    <li {{ parent_block.shopify_attributes }}>
                      {%- if has_child_blocks -%}
                        <details id="Details-menu-drawer-menu-item-{{ parent_block.id }}">
                          <summary
                            id="HeaderDrawer-{{ parent_key }}"
                            class="menu-drawer__menu-item list-menu__item link link--text focus-inset"
                          >
                            {{ parent_title | escape }}
                            <span class="svg-wrapper">
                              {{- 'icon-arrow.svg' | inline_asset_content -}}
                            </span>
                            <span class="svg-wrapper">
                              {{- 'icon-caret.svg' | inline_asset_content -}}
                            </span>
                          </summary>
                          <div
                            id="link-{{ parent_key }}"
                            class="menu-drawer__submenu has-submenu gradient motion-reduce"
                            tabindex="-1"
                          >
                            <div class="menu-drawer__inner-submenu">
                              <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                                <span class="svg-wrapper">
                                  {{- 'icon-arrow.svg' | inline_asset_content -}}
                                </span>
                                {{ parent_title | escape }}
                              </button>
                              <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                                <li>
                                  <a class="menu-drawer__menu-item link link--text list-menu__item focus-inset" href="{{ parent_url }}">
                                    View all
                                  </a>
                                </li>
                                {%- assign scan_parent_children = false -%}
                                {%- for child_block in section.blocks -%}
                                  {%- liquid
                                    assign child_title = child_block.settings.title
                                    assign child_key = child_title | handleize
                                    assign child_url = child_block.settings.link | default: '#'
                                    assign has_grandchild_blocks = false
                                  -%}
                                  {%- if child_block.id == parent_block.id -%}
                                    {%- assign scan_parent_children = true -%}
                                  {%- elsif scan_parent_children and child_block.type == 'drawer_parent' -%}
                                    {%- break -%}
                                  {%- elsif scan_parent_children and child_block.type == 'drawer_child' and child_title != blank -%}
                                    {%- liquid
                                      assign scan_child_grandchildren = false
                                      for grandchild_check_block in section.blocks
                                        if grandchild_check_block.id == child_block.id
                                          assign scan_child_grandchildren = true
                                        elsif scan_child_grandchildren and grandchild_check_block.type == 'drawer_parent'
                                          break
                                        elsif scan_child_grandchildren and grandchild_check_block.type == 'drawer_child'
                                          break
                                        elsif scan_child_grandchildren and grandchild_check_block.type == 'drawer_grandchild' and grandchild_check_block.settings.title != blank
                                          assign has_grandchild_blocks = true
                                          break
                                        endif
                                      endfor
                                    -%}
                                    <li {{ child_block.shopify_attributes }}>
                                      {%- if has_grandchild_blocks -%}
                                        <details id="Details-menu-drawer-{{ parent_key }}-{{ child_key }}">
                                          <summary
                                            id="HeaderDrawer-{{ parent_key }}-{{ child_key }}"
                                            class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                                          >
                                            {{ child_title | escape }}
                                            <span class="svg-wrapper">
                                              {{- 'icon-arrow.svg' | inline_asset_content -}}
                                            </span>
                                            <span class="svg-wrapper">
                                              {{- 'icon-caret.svg' | inline_asset_content -}}
                                            </span>
                                          </summary>
                                          <div
                                            id="childlink-{{ child_key }}"
                                            class="menu-drawer__submenu has-submenu gradient motion-reduce"
                                          >
                                            <button
                                              class="menu-drawer__close-button link link--text focus-inset"
                                              aria-expanded="true"
                                            >
                                              <span class="svg-wrapper">
                                                {{- 'icon-arrow.svg' | inline_asset_content -}}
                                              </span>
                                              {{ child_title | escape }}
                                            </button>
                                            <ul
                                              class="menu-drawer__menu list-menu"
                                              role="list"
                                              tabindex="-1"
                                            >
                                              <li>
                                                <a class="menu-drawer__menu-item link link--text list-menu__item focus-inset" href="{{ child_url }}">
                                                  View all
                                                </a>
                                              </li>
                                              {%- assign scan_child_grandchildren = false -%}
                                              {%- for grandchild_block in section.blocks -%}
                                                {%- liquid
                                                  assign grandchild_title = grandchild_block.settings.title
                                                  assign grandchild_url = grandchild_block.settings.link | default: '#'
                                                -%}
                                                {%- if grandchild_block.id == child_block.id -%}
                                                  {%- assign scan_child_grandchildren = true -%}
                                                {%- elsif scan_child_grandchildren and grandchild_block.type == 'drawer_parent' -%}
                                                  {%- break -%}
                                                {%- elsif scan_child_grandchildren and grandchild_block.type == 'drawer_child' -%}
                                                  {%- break -%}
                                                {%- elsif scan_child_grandchildren and grandchild_block.type == 'drawer_grandchild' and grandchild_title != blank -%}
                                                  <li {{ grandchild_block.shopify_attributes }}>
                                                    <a
                                                      id="HeaderDrawer-{{ parent_key }}-{{ child_key }}-{{ grandchild_title | handleize }}"
                                                      href="{{ grandchild_url }}"
                                                      class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                                                    >
                                                      {{ grandchild_title | escape }}
                                                    </a>
                                                  </li>
                                                {%- endif -%}
                                              {%- endfor -%}
                                            </ul>
                                          </div>
                                        </details>
                                      {%- else -%}
                                        <a
                                          id="HeaderDrawer-{{ parent_key }}-{{ child_key }}"
                                          href="{{ child_url }}"
                                          class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                                        >
                                          {{ child_title | escape }}
                                        </a>
                                      {%- endif -%}
                                    </li>
                                  {%- endif -%}
                                {%- endfor -%}
                              </ul>
                            </div>
                          </div>
                        </details>
                      {%- else -%}
                        <a
                          id="HeaderDrawer-{{ parent_key }}"
                          href="{{ parent_url }}"
                          class="menu-drawer__menu-item list-menu__item link link--text focus-inset"
                        >
                          {{ parent_title | escape }}
                        </a>
                      {%- endif -%}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
              {%- for link in section.settings.menu.links -%}
                <li>
                  {%- if link.links != blank -%}
                    <details id="Details-menu-drawer-menu-item-{{ forloop.index }}">
                      <summary
                        id="HeaderDrawer-{{ link.handle }}"
                        class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active and is_wishlist_view == false %} menu-drawer__menu-item--active{% endif %}"
                      >
                        {{ link.title | escape }}
                        <span class="svg-wrapper">
                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                        </span>
                        <span class="svg-wrapper">
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </span>
                      </summary>
                      <div
                        id="link-{{ link.handle | escape }}"
                        class="menu-drawer__submenu has-submenu gradient motion-reduce"
                        tabindex="-1"
                      >
                        <div class="menu-drawer__inner-submenu">
                          <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                            <span class="svg-wrapper">
                              {{- 'icon-arrow.svg' | inline_asset_content -}}
                            </span>
                            {{ link.title | escape }}
                          </button>
                          <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                            <li>
                              <a class="menu-drawer__menu-item link link--text list-menu__item focus-inset" href="{{ link.url }}">
                                View all
                              </a>
                            </li>
                            {%- for childlink in link.links -%}
                              <li>
                                {%- if childlink.links == blank -%}
                                  <a
                                    id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                    href="{{ childlink.url }}"
                                    class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if childlink.current and is_wishlist_view == false %} menu-drawer__menu-item--active{% endif %}"
                                    {% if childlink.current and is_wishlist_view == false %}
                                      aria-current="page"
                                    {% endif %}
                                  >
                                    {{ childlink.title | escape }}
                                  </a>
                                {%- else -%}
                                  <details id="Details-menu-drawer-{{ link.handle }}-{{ childlink.handle }}">
                                    <summary
                                      id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                      class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                                    >
                                      {{ childlink.title | escape }}
                                      <span class="svg-wrapper">
                                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                                      </span>
                                      <span class="svg-wrapper">
                                        {{- 'icon-caret.svg' | inline_asset_content -}}
                                      </span>
                                    </summary>
                                    <div
                                      id="childlink-{{ childlink.handle | escape }}"
                                      class="menu-drawer__submenu has-submenu gradient motion-reduce"
                                    >
                                      <button
                                        class="menu-drawer__close-button link link--text focus-inset"
                                        aria-expanded="true"
                                      >
                                        <span class="svg-wrapper">
                                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                                        </span>
                                        {{ childlink.title | escape }}
                                      </button>
                                      <ul
                                        class="menu-drawer__menu list-menu"
                                        role="list"
                                        tabindex="-1"
                                      >
                                        <li>
                                          <a class="menu-drawer__menu-item link link--text list-menu__item focus-inset" href="{{ childlink.url }}">
                                            View all
                                          </a>
                                        </li>
                                        {%- for grandchildlink in childlink.links -%}
                                          <li>
                                            <a
                                              id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                              href="{{ grandchildlink.url }}"
                                              class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if grandchildlink.current and is_wishlist_view == false %} menu-drawer__menu-item--active{% endif %}"
                                              {% if grandchildlink.current and is_wishlist_view == false %}
                                                aria-current="page"
                                              {% endif %}
                                            >
                                              {{ grandchildlink.title | escape }}
                                            </a>
                                          </li>
                                        {%- endfor -%}
                                      </ul>
                                    </div>
                                  </details>
                                {%- endif -%}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      </div>
                    </details>
                  {%- else -%}
                    <a
                      id="HeaderDrawer-{{ link.handle }}"
                      href="{{ link.url }}"
                      class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.current and is_wishlist_view == false %} menu-drawer__menu-item--active{% endif %}"
                      {% if link.current and is_wishlist_view == false %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{ link.title | escape }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
              {%- endif -%}
            </ul>
          </nav>
          <div class="menu-drawer__utility-links">
            {%- if shop.customer_accounts_enabled -%}
              <a
                href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
                class="menu-drawer__utility-row link focus-inset"
                data-prada-utility-link
                rel="nofollow"
              >
                <span class="svg-wrapper">{{- 'prada-account.svg' | inline_asset_content -}}</span>
                <span>{% if customer %}Account{% else %}Log in or Register{% endif %}</span>
              </a>
            {%- endif -%}

            <a href="{{ routes.cart_url }}" class="menu-drawer__utility-row link focus-inset" data-prada-utility-link>
              <span class="svg-wrapper">{{- 'prada-cart.svg' | inline_asset_content -}}</span>
              <span>Shopping bag</span>
            </a>

            <a href="{{ routes.all_products_collection_url }}?view=wishlist" class="menu-drawer__utility-row link focus-inset" data-prada-utility-link>
              <span class="svg-wrapper">{{- 'prada-wishlist.svg' | inline_asset_content -}}</span>
              <span>Wishlist</span>
            </a>

            <a href="/pages/contact" class="menu-drawer__utility-row link focus-inset" data-prada-utility-link>
              <span class="svg-wrapper">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 3.5 9 8.2 6.9 9.8c1.5 3.1 4 5.6 7.1 7.1l1.7-2.1 4.8 2.4-.7 3.2c-.2.8-.9 1.3-1.7 1.3C9.4 21.7 2.3 14.6 2.3 5.9c0-.8.5-1.5 1.3-1.7l3-.7Z"/></svg>
              </span>
              <span>Contact us</span>
            </a>

            <button
              type="button"
              class="menu-drawer__utility-row menu-drawer__localization-row"
              data-prada-localization-open
              aria-haspopup="dialog"
            >
              <span class="svg-wrapper menu-drawer__globe-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.4 2.3 3.6 5.2 3.6 8.5S14.4 18.2 12 20.5M12 3.5C9.6 5.8 8.4 8.7 8.4 12s1.2 6.2 3.6 8.5"/></svg>
              </span>
              <span>{{ localization.country.name | escape }} / {{ localization.language.endonym_name | capitalize | escape }}</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </details>
</header-drawer>

<script>
  if (!window.pradaDrawerToolbarBound) {
    window.pradaDrawerToolbarBound = true;

    function updatePradaDesktopMenuLevel(menuDrawer) {
      if (!menuDrawer) return;

      const activePrimaryControl = menuDrawer.querySelector('.prada-desktop-menu__primary-control:checked');
      let level = '1';

      if (activePrimaryControl) {
        level = '2';
        const activePrimaryItem = activePrimaryControl.closest('.prada-desktop-menu__item');
        const activeSubmenuControl = activePrimaryItem && activePrimaryItem.querySelector('.prada-desktop-menu__submenu-control:checked');

        if (activeSubmenuControl) level = '3';
      }

      menuDrawer.querySelectorAll('.prada-desktop-menu__primary-control, .prada-desktop-menu__submenu-control').forEach(function (control) {
        const label = menuDrawer.querySelector('label[for="' + control.id + '"]');
        if (label) label.setAttribute('aria-expanded', control.checked ? 'true' : 'false');
      });

      menuDrawer.dataset.pradaMenuLevel = level;
    }

    function resetPradaDesktopMenu(menuDrawer) {
      if (!menuDrawer) return;

      menuDrawer.querySelectorAll('.prada-desktop-menu__primary-control, .prada-desktop-menu__submenu-control').forEach(function (control) {
        control.checked = false;
      });

      updatePradaDesktopMenuLevel(menuDrawer);
    }

    document.querySelectorAll('.menu-drawer').forEach(updatePradaDesktopMenuLevel);

    document.addEventListener('change', function (event) {
      const control = event.target;

      if (!control.matches('.prada-desktop-menu__primary-control, .prada-desktop-menu__submenu-control')) return;

      const menuDrawer = control.closest('.menu-drawer');
      if (!menuDrawer) return;

      if (control.matches('.prada-desktop-menu__primary-control')) {
        menuDrawer.querySelectorAll('.prada-desktop-menu__submenu-control').forEach(function (submenuControl) {
          submenuControl.checked = false;
        });
      }

      updatePradaDesktopMenuLevel(menuDrawer);
    });

    document.addEventListener('click', function (event) {
      const closeButton = event.target.closest('[data-prada-drawer-close]');
      const searchButton = event.target.closest('[data-prada-drawer-search]');
      const localizationButton = event.target.closest('[data-prada-localization-open]');
      const utilityLink = event.target.closest('[data-prada-utility-link]');
      const actionButton = closeButton || searchButton || localizationButton;
      const menuSummary = event.target.closest('header-drawer > details > summary');
      const desktopLabel = event.target.closest('.prada-desktop-menu__primary-link[for], .prada-desktop-menu__submenu-link[for]');

      if (desktopLabel && window.matchMedia('(min-width: 990px)').matches) {
        const control = document.getElementById(desktopLabel.getAttribute('for'));

        if (control) {
          event.preventDefault();

          const menuDrawer = control.closest('.menu-drawer');
          const isPrimaryControl = control.matches('.prada-desktop-menu__primary-control');

          if (control.checked) {
            control.checked = false;

            if (isPrimaryControl) {
              control.closest('.prada-desktop-menu__item')?.querySelectorAll('.prada-desktop-menu__submenu-control').forEach(function (submenuControl) {
                submenuControl.checked = false;
              });
            }
          } else {
            if (isPrimaryControl) {
              menuDrawer?.querySelectorAll('.prada-desktop-menu__submenu-control').forEach(function (submenuControl) {
                submenuControl.checked = false;
              });
            }

            control.checked = true;
          }

          control.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }

      if (menuSummary) {
        const details = menuSummary.closest('details');

        if (details && details.open) {
          resetPradaDesktopMenu(details.querySelector('.menu-drawer'));
        }
      }

      if (utilityLink) {
        const drawer = utilityLink.closest('header-drawer');
        const details = drawer && drawer.querySelector(':scope > details');
        const header = drawer && drawer.closest('.section-header');

        resetPradaDesktopMenu(drawer && drawer.querySelector('.menu-drawer'));
        details?.classList.remove('menu-opening');
        header?.classList.remove('menu-open');
        document.body.classList.remove('overflow-hidden-tablet', 'overflow-hidden-mobile');
      }

      if (!actionButton) return;

      const drawer = actionButton.closest('header-drawer');
      const drawerSummary = drawer && drawer.querySelector('details > summary');

      resetPradaDesktopMenu(drawer && drawer.querySelector('.menu-drawer'));

      if (drawerSummary) drawerSummary.click();

      if (searchButton) {
        window.setTimeout(function () {
          const header = drawer && drawer.closest('.prada-header');
          const searchSummary = header && header.querySelector('.header__search details > summary');
          if (searchSummary) searchSummary.click();
        }, 0);
      }
    });

    document.addEventListener('keyup', function (event) {
      if (event.key !== 'Escape') return;

      document.querySelectorAll('header-drawer > details[open] .menu-drawer').forEach(resetPradaDesktopMenu);
    });
  }
</script>
