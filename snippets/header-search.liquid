{% comment %}
  Renders a header search modal. Should be used with 'header.liquid'

  Accepts:
  - input_id: {String} Id for the search input element (required)

  Usage:
  {% render 'header-search', input_id: 'My-Id'%}
{% endcomment %}

<details-modal class="header__search">
  <details>
    <summary
      class="header__icon header__icon--search header__icon--summary link focus-inset modal__toggle"
      aria-haspopup="dialog"
      aria-label="{{ 'general.search.search' | t }}"
    >
      <span>
        <span class="svg-wrapper">
          {{- 'prada-search.svg' | inline_asset_content -}}
        </span>
        <span class="svg-wrapper header__icon-close">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </span>
    </summary>
    <div
      class="search-modal modal__content gradient"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'general.search.search' | t }}"
    >
      <div class="modal-overlay"></div>
      <div
        class="search-modal__content{% if settings.inputs_shadow_vertical_offset != 0 and settings.inputs_shadow_vertical_offset < 0 %} search-modal__content-top{% else %} search-modal__content-bottom{% endif %}"
        tabindex="-1"
      >
        {%- if settings.predictive_search_enabled -%}
          <predictive-search class="search-modal__form" data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- else -%}
          <search-form class="search-modal__form">
        {%- endif -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="search search-modal__form">
          <div class="field">
            <input
              class="search__input field__input"
              id="{{ input_id }}"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ 'general.search.search' | t }} on {{ shop.name | escape }}"
              {%- if settings.predictive_search_enabled -%}
                role="combobox"
                aria-expanded="false"
                aria-owns="predictive-search-results"
                aria-controls="predictive-search-results"
                aria-haspopup="listbox"
                aria-autocomplete="list"
                autocorrect="off"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
              {%- endif -%}
            >
            <label class="field__label" for="{{ input_id }}">{{ 'general.search.search' | t }}</label>
            <input type="hidden" name="options[prefix]" value="last">
            <button
              type="reset"
              class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
              aria-label="{{ 'general.search.reset' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-reset.svg' | inline_asset_content -}}
              </span>
            </button>
            <button class="search__button field__button" aria-label="{{ 'general.search.search' | t }}">
              <span class="svg-wrapper">
                {{- 'prada-search.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          {%- if settings.predictive_search_enabled -%}
            <div class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search>
              {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
            </div>

            <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
          {%- endif -%}
        </form>
        {%- if settings.predictive_search_enabled -%}
          </predictive-search>
        {%- else -%}
          </search-form>
        {%- endif -%}
        <button
          type="button"
          class="search-modal__close-button modal__close-button link link--text focus-inset"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class="prada-search-close-label">{{ 'accessibility.close' | t }}</span>
          <span class="svg-wrapper prada-search-close-icon">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
        <div class="prada-mobile-search-links" aria-label="Quick links" data-dynamic-search-suggestions>
          <div class="prada-mobile-search-links__group" data-search-suggestion-group="collections">
            <p class="prada-mobile-search-links__heading">Collections</p>
            {%- assign collection_suggestion_count = 0 -%}
            {%- for suggested_collection in collections limit: 50 -%}
              {%- if suggested_collection.handle != 'all'
                and suggested_collection.handle != 'frontpage'
                and suggested_collection.all_products_count > 0
              -%}
                <a
                  href="{{ suggested_collection.url }}"
                  data-search-suggestion
                  {% if collection_suggestion_count >= 4 %}hidden{% endif %}
                >
                  {{- suggested_collection.title | escape -}}
                </a>
                {%- assign collection_suggestion_count = collection_suggestion_count | plus: 1 -%}
                {%- if collection_suggestion_count >= 20 -%}{%- break -%}{%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            <a href="{{ routes.search_url }}?q=Scarves" data-search-suggestion {% if collection_suggestion_count >= 4 %}hidden{% endif %}>Scarves</a>
            <a href="{{ routes.search_url }}?q=Bandanas" data-search-suggestion hidden>Bandanas</a>
            <a href="{{ routes.search_url }}?q=Candles" data-search-suggestion hidden>Candles</a>
            <a href="{{ routes.search_url }}?q=Custom+Design" rel="nofollow" data-search-suggestion hidden>Custom Design</a>
          </div>
          <div class="prada-mobile-search-links__group" data-search-suggestion-group="highlights">
            <p class="prada-mobile-search-links__heading">Highlights</p>
            {%- assign highlight_suggestion_count = 0 -%}
            {%- for suggested_type in collections['all'].all_types limit: 24 -%}
              {%- assign suggested_type_length = suggested_type | size -%}
              {%- if suggested_type_length <= 28 -%}
                <a
                  href="{{ suggested_type | url_for_type }}"
                  data-search-suggestion
                  {% if highlight_suggestion_count >= 4 %}hidden{% endif %}
                >
                  {{- suggested_type | escape -}}
                </a>
                {%- assign highlight_suggestion_count = highlight_suggestion_count | plus: 1 -%}
                {%- if highlight_suggestion_count >= 12 -%}{%- break -%}{%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            <a href="{{ routes.all_products_collection_url }}?sort_by=created-descending" data-search-suggestion {% if highlight_suggestion_count >= 4 %}hidden{% endif %}>New Arrivals</a>
            <a href="{{ routes.all_products_collection_url }}?sort_by=best-selling" data-search-suggestion hidden>Best Sellers</a>
            <a href="{{ routes.search_url }}?q=Scarves" data-search-suggestion hidden>Scarves</a>
            <a href="{{ routes.search_url }}?q=Bandanas" data-search-suggestion hidden>Bandanas</a>
            <a href="{{ routes.search_url }}?q=Candles" data-search-suggestion hidden>Candles</a>
            <a href="{{ routes.search_url }}?q=Custom+Design" rel="nofollow" data-search-suggestion hidden>Custom Design</a>
          </div>
        </div>
        <script>
          (() => {
            const script = document.currentScript;
            const suggestions = script && script.previousElementSibling;

            if (!suggestions || suggestions.dataset.dynamicSearchReady === 'true') return;

            suggestions.dataset.dynamicSearchReady = 'true';

            const randomIndex = (maximum) => {
              if (window.crypto && window.crypto.getRandomValues) {
                const value = new Uint32Array(1);
                window.crypto.getRandomValues(value);
                return value[0] % maximum;
              }

              return Math.floor(Math.random() * maximum);
            };

            const refreshGroup = (group) => {
              const candidates = Array.from(group.querySelectorAll('[data-search-suggestion]'));
              const unique = [];
              const labels = new Set();

              candidates.forEach((item) => {
                const label = item.textContent.trim().toLowerCase();
                item.hidden = true;

                if (label && !labels.has(label)) {
                  labels.add(label);
                  unique.push(item);
                }
              });

              for (let index = unique.length - 1; index > 0; index -= 1) {
                const swapIndex = randomIndex(index + 1);
                [unique[index], unique[swapIndex]] = [unique[swapIndex], unique[index]];
              }

              unique.slice(0, 4).forEach((item) => {
                item.hidden = false;
              });
            };

            const refreshSuggestions = () => {
              suggestions.querySelectorAll('[data-search-suggestion-group]').forEach(refreshGroup);
            };

            const searchDetails = suggestions.closest('details');

            if (searchDetails) {
              searchDetails.addEventListener('toggle', () => {
                if (searchDetails.open) refreshSuggestions();
              });
            }

            refreshSuggestions();
          })();
        </script>
      </div>
    </div>
  </details>
</details-modal>
