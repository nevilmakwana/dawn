{% comment %}
  Prada Luxury Cart Drawer
  Renders Shopify cart drawer with high-fashion minimalist design and instant Section Rendering synchronization.
{% endcomment %}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>

<cart-drawer
  id="CartDrawerRoot"
  class="drawer prada-cart-drawer{% if cart == empty %} is-empty{% endif %}"
  data-cart-item-count="{{ cart.item_count }}"
  data-cart-total-price="{{ cart.total_price }}"
>
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay" aria-hidden="true"></div>

    <div
      class="drawer__inner"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      <!-- Empty State -->
      <div class="drawer__inner-empty"{% unless cart == empty %} hidden{% endunless %}>
        <div class="drawer__header drawer__header--empty">
          <button
            class="drawer__close"
            type="button"
            onclick="this.closest('cart-drawer').close()"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-close.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
        <div class="prada-cart-drawer__empty-content">
          <p class="prada-cart-drawer__empty-message">Your shopping bag is empty</p>
          {%- if shop.customer_accounts_enabled and customer == null -%}
            <a class="prada-cart-drawer__empty-login" href="{{ routes.account_login_url }}">
              Log in or create your personal account
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Populated State -->
      <div class="drawer__main-content"{% if cart == empty %} hidden{% endif %}>
        <!-- Header -->
        <div class="drawer__header">
          <h2 class="drawer__heading">
            <span class="prada-cart-drawer__heading-text">Your selection</span>
            <span class="prada-cart-drawer__heading-count"> ({{ cart.item_count }})</span>
          </h2>
          <button
            class="drawer__close"
            type="button"
            onclick="this.closest('cart-drawer').close()"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-close.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>

        <!-- Items Container -->
        <cart-drawer-items
          class="drawer__items-container"
          {% if cart == empty %}
            class="is-empty"
          {% endif %}
        >
          <form
            action="{{ routes.cart_url }}"
            id="CartDrawer-Form"
            class="cart-drawer__form"
            method="post"
          >
            <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
              {%- if cart != empty -%}
                <div class="drawer__cart-items-wrapper">
                  <div class="prada-cart-items" role="list">
                    {%- for item in cart.items -%}
                      {%- liquid
                        assign drawer_item_media = blank
                        assign drawer_variant_gallery = item.variant.metafields.custom.variant_images.value
                        if drawer_variant_gallery == blank
                          assign drawer_variant_gallery = item.variant.metafields.custom.custom_variant_images.value
                        endif
                        for variant_media in drawer_variant_gallery
                          if variant_media.media_type == 'image'
                            assign drawer_item_media = variant_media
                            break
                          endif
                        endfor
                        if drawer_item_media == blank
                          assign drawer_item_media = item.image
                        endif
                      -%}

                      <div
                        id="CartDrawer-Item-{{ item.index | plus: 1 }}"
                        class="prada-cart-item cart-item"
                        data-cart-line-key="{{ item.key | escape }}"
                        data-cart-line-index="{{ item.index | plus: 1 }}"
                        data-cart-variant-id="{{ item.variant.id }}"
                        data-cart-quantity="{{ item.quantity }}"
                        role="listitem"
                      >
                        <!-- Image Column -->
                        <div class="prada-cart-item__media">
                          {%- if drawer_item_media -%}
                            <a href="{{ item.url }}" class="prada-cart-item__link" tabindex="-1" aria-hidden="true">
                              <img
                                class="prada-cart-item__image"
                                src="{{ drawer_item_media | image_url: width: 220 }}"
                                alt="{{ drawer_item_media.alt | default: item.product.title | escape }}"
                                loading="lazy"
                                width="110"
                                height="{{ 110 | divided_by: drawer_item_media.aspect_ratio | ceil }}"
                              >
                            </a>
                          {%- endif -%}
                        </div>

                        <!-- Details Column -->
                        <div class="prada-cart-item__details">
                          <div class="prada-cart-item__header-row">
                            <a href="{{ item.url }}" class="prada-cart-item__title">
                              {{- item.product.title | escape -}}
                            </a>
                            <div class="prada-cart-item__price-box">
                              {%- if item.original_line_price != item.final_line_price -%}
                                <s class="prada-cart-item__old-price">{{ item.original_line_price | money }}</s>
                                <span class="prada-cart-item__price">{{ item.final_line_price | money }}</span>
                              {%- else -%}
                                <span class="prada-cart-item__price">{{ item.final_price | money }}</span>
                              {%- endif -%}
                            </div>
                          </div>

                          <!-- Options & Variants -->
                          {%- unless item.product.has_only_default_variant -%}
                            <div class="prada-cart-item__options">
                              {%- for option in item.options_with_values -%}
                                <p class="prada-cart-item__option">
                                  <span class="prada-cart-item__option-name">{{ option.name | escape }}:</span>
                                  <span class="prada-cart-item__option-value">{{ option.value | escape }}</span>
                                </p>
                              {%- endfor -%}
                            </div>
                          {%- endunless -%}

                          <!-- Properties if any -->
                          {%- for property in item.properties -%}
                            {%- assign property_first_char = property.first | slice: 0 -%}
                            {%- if property.last != blank and property_first_char != '_' -%}
                              <div class="prada-cart-item__property">
                                <span>{{ property.first }}: </span>
                                {%- if property.last contains '/uploads/' -%}
                                  <a href="{{ property.last }}" class="link" target="_blank">{{ property.last | split: '/' | last }}</a>
                                {%- else -%}
                                  <span>{{ property.last }}</span>
                                {%- endif -%}
                              </div>
                            {%- endif -%}
                          {%- endfor -%}

                          <!-- Discounts -->
                          {%- if item.line_level_discount_allocations.size > 0 -%}
                            <ul class="prada-cart-item__discounts list-unstyled" role="list">
                              {%- for discount in item.line_level_discount_allocations -%}
                                <li class="prada-cart-item__discount">
                                  <span class="svg-wrapper">{{ 'icon-discount.svg' | inline_asset_content }}</span>
                                  <span>{{ discount.discount_application.title }} (-{{ discount.amount | money }})</span>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}

                          <!-- Quantity Controls & Remove -->
                          <div class="prada-cart-item__actions">
                            <div class="prada-quantity-stepper">
                              <button
                                class="prada-quantity__button prada-quantity__button--minus"
                                name="minus"
                                type="button"
                                aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}"
                              >
                                <span class="svg-wrapper">{{ 'icon-minus.svg' | inline_asset_content }}</span>
                              </button>
                              <input
                                class="prada-quantity__input"
                                type="number"
                                name="updates[]"
                                value="{{ item.quantity }}"
                                min="0"
                                data-index="{{ item.index | plus: 1 }}"
                                data-line-key="{{ item.key }}"
                                aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                id="Drawer-quantity-{{ item.index | plus: 1 }}"
                              >
                              <button
                                class="prada-quantity__button prada-quantity__button--plus"
                                name="plus"
                                type="button"
                                aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}"
                              >
                                <span class="svg-wrapper">{{ 'icon-plus.svg' | inline_asset_content }}</span>
                              </button>
                            </div>

                            <cart-remove-button
                              id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
                              data-index="{{ item.index | plus: 1 }}"
                              data-line-key="{{ item.key | escape }}"
                            >
                              <button
                                type="button"
                                class="prada-cart-drawer__remove"
                                aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                              >
                                Remove
                              </button>
                            </cart-remove-button>
                          </div>

                          <!-- Error Notice -->
                          <div
                            id="CartDrawer-LineItemError-{{ item.index | plus: 1 }}"
                            class="cart-item__error prada-cart-item__error"
                            role="alert"
                            hidden
                          >
                            <span class="svg-wrapper">{{ 'icon-error.svg' | inline_asset_content }}</span>
                            <small class="cart-item__error-text"></small>
                          </div>
                        </div>
                      </div>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}

              <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
              <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">
                {{ 'accessibility.loading' | t }}
              </p>
            </div>
            <div id="CartDrawer-CartErrors" role="alert"></div>
          </form>
        </cart-drawer-items>

        <!-- Footer -->
        <div class="drawer__footer">
          <!-- Discount allocations -->
          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <ul class="prada-cart-drawer__discounts list-unstyled" role="list">
              {%- for discount in cart.cart_level_discount_applications -%}
                <li class="prada-cart-drawer__discount">
                  <span class="svg-wrapper">{{ 'icon-discount.svg' | inline_asset_content }}</span>
                  <span>{{ discount.title | escape }} (-{{ discount.total_allocated_amount | money }})</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <!-- Subtotal -->
          <div class="prada-cart-drawer__subtotal-row" role="status">
            <span class="prada-cart-drawer__subtotal-label">Subtotal</span>
            <span class="prada-cart-drawer__subtotal-value">{{ cart.total_price | money_with_currency }}</span>
          </div>

          <!-- Tax disclaimer -->
          <p class="prada-cart-drawer__tax-note">
            Taxes and shipping calculated at checkout.
          </p>

          <!-- CTAs -->
          <div class="prada-cart-drawer__ctas">
            <button
              type="submit"
              id="CartDrawer-Checkout"
              class="prada-cart-drawer__checkout-btn"
              name="checkout"
              form="CartDrawer-Form"
              {% if cart == empty %}
                disabled
              {% endif %}
            >
              Proceed to checkout
            </button>
            <a class="prada-cart-drawer__view-cart" href="{{ routes.cart_url }}">
              Go to shopping bag
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</cart-drawer>
