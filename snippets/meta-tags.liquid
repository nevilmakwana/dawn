{% doc %}
  Renders Open Graph and Twitter metadata for the current storefront resource.

  @param {string} [seo_description] - Final description generated by the theme layout.

  @example
  {% render 'meta-tags', seo_description: seo_description %}
{% enddoc %}

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_description | default: page_description | default: shop.description | default: shop.name
  assign og_image = page_image
  assign default_share_image = settings.social_share_image | default: settings.brand_image | default: settings.logo_hover | default: settings.logo

  if request.page_type == 'product'
    assign og_type = 'product'
    assign manual_share_image = product.metafields.custom.social_share_image.value
    assign og_image = manual_share_image | default: product.featured_image | default: og_image
  elsif request.page_type == 'article'
    assign og_type = 'article'
    assign manual_share_image = article.metafields.custom.social_share_image.value
    assign og_image = manual_share_image | default: article.image | default: og_image
  elsif request.page_type == 'collection'
    assign manual_share_image = collection.metafields.custom.social_share_image.value
    assign og_image = manual_share_image | default: collection.image | default: collection.products.first.featured_image | default: default_share_image
  elsif request.page_type == 'page'
    assign manual_share_image = page.metafields.custom.social_share_image.value
    assign og_image = manual_share_image | default: og_image
  elsif request.page_type == 'index'
    assign og_image = settings.social_share_image | default: settings.logo_hover | default: settings.brand_image | default: og_image | default: settings.logo
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  assign og_image = og_image | default: default_share_image
  if og_image
    assign og_image_width = 1200
    assign og_image_height = og_image_width | divided_by: og_image.aspect_ratio | round
    assign og_image_url = og_image | image_url: width: og_image_width, format: 'pjpg'
  endif
%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if og_image -%}
  <meta property="og:image" content="https:{{ og_image_url }}">
  <meta property="og:image:secure_url" content="https:{{ og_image_url }}">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="{{ og_image_width }}">
  <meta property="og:image:height" content="{{ og_image_height }}">
  <meta property="og:image:alt" content="{{ og_image.alt | default: og_title | escape }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  {%- assign seo_variant = product.selected_or_first_available_variant -%}
  <meta property="product:price:amount" content="{{ seo_variant.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:availability" content="{% if seo_variant.available %}in stock{% else %}out of stock{% endif %}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if og_image -%}
  <meta name="twitter:image" content="https:{{ og_image_url }}">
  <meta name="twitter:image:alt" content="{{ og_image.alt | default: og_title | escape }}">
{%- endif -%}
