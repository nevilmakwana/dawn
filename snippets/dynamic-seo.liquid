{% doc %}
  Renders page-type robots directives and structured data from Shopify resources.

  @param {string} seo_description - Final meta description for the current page.

  @example
  {% render 'dynamic-seo', seo_description: seo_description %}
{% enddoc %}

{%- liquid
  assign home_url = routes.root_url | prepend: request.origin
  assign breadcrumb_name = blank

  case request.page_type
    when 'product'
      assign breadcrumb_name = product.title
    when 'collection'
      assign breadcrumb_name = collection.title
    when 'page'
      assign breadcrumb_name = page.title
    when 'article'
      assign breadcrumb_name = article.title
  endcase
-%}

{%- if request.page_type == 'search' -%}
  <meta name="robots" content="noindex,follow">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
{%- elsif request.page_type == 'collection' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": {{ collection.title | json }},
      "url": {{ canonical_url | json }},
      "description": {{ seo_description | json }}
    }
  </script>
{%- elsif request.page_type == 'page' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": {{ page.title | json }},
      "url": {{ canonical_url | json }},
      "description": {{ seo_description | json }}
    }
  </script>
{%- elsif request.page_type == 'article' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ article.title | json }},
      "description": {{ seo_description | json }},
      "image": [
        {%- if article.image -%}
          {{ article.image | image_url: width: 1200 | prepend: "https:" | json }}
        {%- else -%}
          {{ settings.brand_image | default: settings.logo | image_url: width: 1200 | prepend: "https:" | json }}
        {%- endif -%}
      ],
      "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
      "dateModified": {{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": {{ canonical_url | json }}
      },
      "author": {
        "@type": "Person",
        "name": {{ article.author | default: shop.name | json }}
      },
      "publisher": {
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "logo": {
          "@type": "ImageObject",
          "url": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }}
        }
      }
    }
  </script>
{%- endif -%}

{%- if breadcrumb_name != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ shop.name | json }},
          "item": {{ home_url | json }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ breadcrumb_name | json }},
          "item": {{ canonical_url | json }}
        }
      ]
    }
  </script>
{%- endif -%}
