<a
  class="prada-category-showcase__item prada-category-showcase__item--{{ tile_gender }}{% if active_tab == tile_gender %} is-active{% endif %}"
  href="{{ tile_url }}"
  data-prada-category-tile="{{ tile_gender }}"
  {% unless active_tab == tile_gender %}aria-hidden="true" tabindex="-1" inert{% endunless %}
  {% if block != blank %} {{ block.shopify_attributes }}{% endif %}
>
  <div class="prada-category-showcase__media">
    {%- if tile_image != blank -%}
      {{
        tile_image
        | image_url: width: 1100
        | image_tag:
          loading: 'lazy',
          widths: '360, 480, 640, 800, 960, 1100',
          sizes: '(min-width: 990px) 25vw, 50vw',
          class: 'prada-category-showcase__image'
      }}
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag: 'prada-category-showcase__placeholder placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="prada-category-showcase__label">{{ tile_title | escape }}</div>
</a>
